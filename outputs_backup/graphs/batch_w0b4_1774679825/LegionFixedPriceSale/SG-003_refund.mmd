---
title: "refund (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_paused: check not paused
    q_check_paused --> q_revert_paused: contract paused
    q_revert_paused --> [*]: revert ContractPaused
    q_check_paused --> q_check_window: not paused
    q_check_window --> q_check_invested: endTime < block.timestamp <= refundEndTime
    q_check_window --> q_revert_window: outside refund window
    q_revert_window --> [*]: revert RefundNotActive
    q_check_invested --> q_check_already_refunded: investorPosition.totalInvested > 0
    q_check_invested --> q_revert_no_invest: no investment found
    q_revert_no_invest --> [*]: revert NoInvestmentFound
    q_check_already_refunded --> q_calculate: not already refunded
    q_check_already_refunded --> q_revert_already: already refunded
    q_revert_already --> [*]: revert AlreadyRefunded
    q_calculate --> q_update_state: refundAmount = investorPosition.totalInvested
    q_update_state --> q_transfer: investorPosition.refunded = true AND totalCapitalInvested -= refundAmount
    q_transfer --> q_emit: transfer(investor, refundAmount) bidToken
    q_emit --> [*]: emit Refunded(investor, refundAmount)

    note right of q_calculate
        INV-001: Refund only during refund window (endTime, refundEndTime]
        INV-002: Each investor can refund at most once
        INV-003: Refund amount equals total invested amount
        INV-004: totalCapitalInvested decreases by exact refund amount
    end note
