---
title: "withdrawRaisedCapital (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_auth: check caller is projectAdmin
    q_check_auth --> q_revert_auth: not projectAdmin
    q_revert_auth --> [*]: revert Unauthorized
    q_check_auth --> q_check_supplied: authorized
    q_check_supplied --> q_check_not_withdrawn: tokensSupplied == true
    q_check_supplied --> q_revert_supply: tokens not yet supplied
    q_revert_supply --> [*]: revert TokensNotSupplied
    q_check_not_withdrawn --> q_calculate_fees: capital not yet withdrawn
    q_check_not_withdrawn --> q_revert_withdrawn: already withdrawn
    q_revert_withdrawn --> [*]: revert CapitalAlreadyWithdrawn
    q_calculate_fees --> q_transfer_fee: feeAmount = totalAcceptedCapital * feeRate
    q_transfer_fee --> q_transfer_capital: transfer feeAmount to Legion fee receiver
    q_transfer_capital --> q_update_state: transfer (totalAcceptedCapital - feeAmount) to projectAdmin
    q_update_state --> q_emit: capitalWithdrawn = true
    q_emit --> [*]: emit RaisedCapitalWithdrawn(projectAdmin, amount, feeAmount)

    note right of q_calculate_fees
        INV-001: Capital withdrawal only after tokens supplied
        INV-002: Fee automatically distributed to Legion on withdrawal
        INV-003: projectAdmin receives totalAcceptedCapital minus fees
        INV-004: Capital can only be withdrawn once
    end note
