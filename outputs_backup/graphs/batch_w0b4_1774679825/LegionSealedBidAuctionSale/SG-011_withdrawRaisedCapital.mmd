---
title: "withdrawRaisedCapital (LegionSealedBidAuctionSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_caller: validate caller is projectAdmin
    q_check_caller --> q_check_timing: block.timestamp > refundEndTime
    q_check_timing --> q_check_supplied: tokensSupplied == true
    q_check_supplied --> q_check_not_withdrawn: capitalWithdrawn == false
    q_check_not_withdrawn --> q_calc_fees: legionFee = totalCapitalAccepted * legionFeeRate, referrerFee = totalCapitalAccepted * referrerFeeRate
    q_calc_fees --> q_calc_net: netAmount = totalCapitalAccepted - legionFee - referrerFee
    q_calc_net --> q_transfer_legion: bidToken.transfer(legionAddress, legionFee)
    q_transfer_legion --> q_transfer_referrer: bidToken.transfer(referrerAddress, referrerFee)
    q_transfer_referrer --> q_transfer_admin: bidToken.transfer(projectAdmin, netAmount)
    q_transfer_admin --> q_mark_withdrawn: capitalWithdrawn = true
    q_mark_withdrawn --> [*]: emit RaisedCapitalWithdrawn event

    q_check_caller --> q_revert_auth: unauthorized
    q_revert_auth --> [*]: revert Unauthorized
    q_check_timing --> q_revert_timing: refund period not ended
    q_revert_timing --> [*]: revert RefundPeriodNotEnded
    q_check_supplied --> q_revert_supply: tokens not supplied
    q_revert_supply --> [*]: revert TokensNotSupplied
    q_check_not_withdrawn --> q_revert_dup: already withdrawn
    q_revert_dup --> [*]: revert AlreadyWithdrawn

    note right of q_calc_fees
        INV-001: legionFee + referrerFee + netAmount == totalCapitalAccepted
        INV-002: withdrawal only possible after tokens supplied (prevents rug)
        INV-003: fee distribution is atomic with capital withdrawal
        INV-004: capitalWithdrawn transitions from false to true exactly once
    end note
