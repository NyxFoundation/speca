---
title: "participateInvestFlow (High Level Sale Customer Journey)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_eligible: verify investor eligibility
    q_check_eligible --> q_select_sale: eligible = true
    q_check_eligible --> q_revert_ineligible: eligible = false
    q_revert_ineligible --> [*]: revert NotEligible
    q_select_sale --> q_check_sale_type: select sale to participate in
    q_check_sale_type --> q_fixed_price: saleType = FixedPrice
    q_check_sale_type --> q_sealed_bid: saleType = SealedBidAuction
    q_check_sale_type --> q_pre_liquid_approved: saleType = PreLiquidApproved
    q_check_sale_type --> q_pre_liquid_open: saleType = PreLiquidOpenApplication
    q_fixed_price --> q_check_phase: determine sale phase
    q_check_phase --> q_prefund: block.timestamp >= prefundStartTime AND block.timestamp < prefundEndTime
    q_check_phase --> q_active_sale: block.timestamp >= startTime AND block.timestamp < endTime
    q_check_phase --> q_revert_not_active: sale not in active phase
    q_revert_not_active --> [*]: revert SaleNotActive
    q_prefund --> q_deposit: invest during prefund (early participation)
    q_active_sale --> q_deposit: invest during active sale
    q_sealed_bid --> q_encrypt_bid: encrypt bid with ECIES publicKey
    q_encrypt_bid --> q_deposit: submit encrypted bid with capital
    q_pre_liquid_approved --> q_check_saft: verify SAFT authorization
    q_check_saft --> q_deposit: SAFT signature valid
    q_check_saft --> q_revert_saft: invalid SAFT
    q_revert_saft --> [*]: revert InvalidSignature
    q_pre_liquid_open --> q_deposit: deposit maximum allocation amount
    q_deposit --> q_verify_sig: verify investment signature
    q_verify_sig --> q_check_amount: signature valid
    q_verify_sig --> q_revert_sig: signature invalid
    q_revert_sig --> [*]: revert InvalidSignature
    q_check_amount --> q_transfer: amount >= minimumInvestAmount
    q_check_amount --> q_revert_amount: amount below minimum
    q_revert_amount --> [*]: revert BelowMinimumInvestment
    q_transfer --> q_update_state: transferFrom(investor, sale, amount)
    q_update_state --> [*]: investedCapital[investor] += amount

    note right of q_check_phase
        INV-001: Investment only allowed during active sale phases (prefund or active)
        INV-002: All investments require valid signature verification
        INV-003: Investment amount must meet minimum threshold
        INV-004: Capital transfer must complete before state update
    end note
