---
title: "refundFlow (High Level Sale Customer Journey)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_refund_window: investor requests refund
    q_check_refund_window --> q_check_sale_type: block.timestamp < refundEndTime
    q_check_refund_window --> q_revert_expired: refund period ended
    q_revert_expired --> [*]: revert RefundPeriodEnded
    q_check_sale_type --> q_fixed_refund: saleType = FixedPrice OR SealedBid
    q_check_sale_type --> q_pre_liquid_refund: saleType = PreLiquid (Approved or Open)
    q_fixed_refund --> q_check_invested: check investedCapital[investor] > 0
    q_pre_liquid_refund --> q_check_individual_window: check individual 14-day refund window (MiCA)
    q_check_individual_window --> q_check_invested: within individual refund period
    q_check_individual_window --> q_revert_individual: individual refund window expired
    q_revert_individual --> [*]: revert IndividualRefundExpired
    q_check_invested --> q_check_not_refunded: investor has capital invested
    q_check_invested --> q_revert_no_capital: no capital to refund
    q_revert_no_capital --> [*]: revert NoCapitalInvested
    q_check_not_refunded --> q_calculate_refund: hasRefunded[investor] = false
    q_check_not_refunded --> q_revert_already: already refunded
    q_revert_already --> [*]: revert AlreadyRefunded
    q_calculate_refund --> q_set_refunded: refundAmount = investedCapital[investor]
    q_set_refunded --> q_transfer_back: hasRefunded[investor] = true
    q_transfer_back --> [*]: transfer(investor, refundAmount)

    note right of q_check_refund_window
        INV-001: Refunds only permitted within the designated refund period
        INV-002: Pre-liquid sales have per-investor 14-day refund windows (MiCA compliance)
        INV-003: State must be updated before transfer to prevent reentrancy
        INV-004: Each investor may refund at most once
    end note
