---
title: "withdrawRaisedCapital (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_caller: project admin withdraws capital
    q_check_caller --> q_check_refund_ended: caller is projectAdmin
    q_check_caller --> q_revert_auth: unauthorized
    q_check_refund_ended --> q_check_tokens_supplied: block.timestamp >= refundEndTime
    q_check_refund_ended --> q_revert_timing: refund period not ended
    q_check_tokens_supplied --> q_check_not_withdrawn: tokens have been supplied
    q_check_tokens_supplied --> q_revert_supply: tokens not yet supplied
    q_check_not_withdrawn --> q_calc_fees: capital not already withdrawn
    q_check_not_withdrawn --> q_revert_withdrawn: already withdrawn
    q_calc_fees --> q_transfer_legion: legionFee = raisedCapital * legionFeeBps / 10000
    q_transfer_legion --> q_transfer_referrer: transfer(legionFeeReceiver, legionFee)
    q_transfer_referrer --> q_check_referrer: referrerFee = raisedCapital * referrerFeeBps / 10000
    q_check_referrer --> q_transfer_project: transfer(referrer, referrerFee) if referrer != address(0)
    q_check_referrer --> q_transfer_project: no referrer set
    q_transfer_project --> q_mark_withdrawn: projectAmount = raisedCapital - legionFee - referrerFee, transfer(projectAdmin, projectAmount)
    q_mark_withdrawn --> [*]: capitalWithdrawn = true, emit CapitalWithdrawn(projectAmount, legionFee, referrerFee)
    q_revert_auth --> [*]: revert Unauthorized
    q_revert_timing --> [*]: revert RefundPeriodNotEnded
    q_revert_supply --> [*]: revert TokensNotSupplied
    q_revert_withdrawn --> [*]: revert AlreadyWithdrawn

    note right of q_calc_fees
        INV-001: legionFee + referrerFee + projectAmount == raisedCapital (no rounding loss)
        INV-002: Fees calculated on raisedCapital, not totalInvestedCapital
        INV-003: Capital withdrawal only possible after tokens supplied (ensures project commitment)
    end note
