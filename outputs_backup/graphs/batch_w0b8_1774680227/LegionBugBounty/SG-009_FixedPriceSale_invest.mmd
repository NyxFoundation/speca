---
title: "invest (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard1: whenNotPaused
    q_guard1 --> q_guard2: whenNotPrefundAllocationPeriod
    q_guard2 --> q_guard3: whenSaleNotEnded
    q_guard3 --> q_guard4: whenSaleNotCanceled
    q_guard4 --> q_checkPrefund: _isPrefund()
    q_checkPrefund --> q_prefundPath: isPrefund == true
    q_checkPrefund --> q_normalPath: isPrefund == false
    q_prefundPath --> q_verifySig: _verifySignatureNotUsed(signature)
    q_verifySig --> q_validateSig: _verifyValidPosition(signature, positionId, INVEST)
    q_validateSig --> q_markSig: s_usedSignatures[msg.sender][signature] = true
    q_markSig --> q_updatePos: _updateInvestorPosition(amount)
    q_normalPath --> q_updatePos: _updateInvestorPosition(amount)
    q_updatePos --> q_transfer: safeTransferFrom(msg.sender, address(this), amount)
    q_transfer --> q_emit: emit CapitalInvested(amount, msg.sender, isPrefund, positionId)
    q_emit --> [*]: return

    note right of q_guard2
        INV-001: During prefund allocation period, no new investments allowed
        INV-002: Prefund allocation period is between prefund end and allocation end
    end note

    note right of q_checkPrefund
        INV-003: Prefund phase uses signature auth, normal phase is open
        INV-004: isPrefund = block.timestamp < prefundEndTime
    end note
