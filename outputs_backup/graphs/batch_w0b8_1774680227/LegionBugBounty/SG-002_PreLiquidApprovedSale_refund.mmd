---
title: "refund (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard1: whenNotPaused
    q_guard1 --> q_guard2: whenSaleNotCanceled
    q_guard2 --> q_guard3: whenRefundPeriodNotOver
    q_guard3 --> q_getPos: positionId = s_investorPositions[msg.sender].positionId
    q_getPos --> q_verifyNotRefunded: _verifyHasNotRefunded(positionId)
    q_verifyNotRefunded --> q_getAmount: amount = s_investorPositions[msg.sender].capitalInvested
    q_getAmount --> q_markRefunded: s_investorPositions[msg.sender].hasRefunded = true
    q_markRefunded --> q_transfer: safeTransfer(msg.sender, amount)
    q_transfer --> q_emit: emit CapitalRefunded(amount, msg.sender, positionId)
    q_emit --> [*]: return

    note right of q_guard3
        INV-001: Refund only allowed before refund period ends
        INV-002: block.timestamp < saleEndTime + refundPeriodDuration
    end note

    note right of q_verifyNotRefunded
        INV-003: Each investor can only refund once
        INV-004: Full capital amount is returned (no partial refunds)
    end note
