---
title: "invest (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard1: whenNotPaused
    q_guard1 --> q_guard2: whenSaleNotCanceled
    q_guard2 --> q_guard3: whenSaleNotEnded
    q_guard3 --> q_verifySig: _verifySignatureNotUsed(investSignature)
    q_verifySig --> q_validatePos: _verifyValidPosition(investSignature, positionId, INVEST)
    q_validatePos --> q_markSig: s_usedSignatures[msg.sender][investSignature] = true
    q_markSig --> q_updatePos: _updateInvestorPosition(investAmount, tokenAllocationRate, amount)
    q_updatePos --> q_transfer: safeTransferFrom(msg.sender, address(this), amount)
    q_transfer --> q_emit: emit CapitalInvested(amount, msg.sender, positionId)
    q_emit --> [*]: return

    note right of q_verifySig
        INV-001: Each signature can only be used once per investor
        INV-002: Signature must be valid ECDSA from legionSigner
    end note

    note right of q_updatePos
        INV-003: investorPosition.capitalInvested += amount
        INV-004: Position tracks investAmount and tokenAllocationRate from off-chain
    end note
