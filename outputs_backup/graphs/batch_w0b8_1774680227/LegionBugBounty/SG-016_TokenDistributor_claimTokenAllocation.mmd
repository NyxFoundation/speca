---
title: "claimTokenAllocation (LegionTokenDistributor)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: whenNotPaused
    q_guard --> q_verifyClaim: _verifyCanClaimTokenAllocation()
    q_verifyClaim --> q_verifyClaimSig: _verifyValidPosition(claimAmount, claimSignature)
    q_verifyClaimSig --> q_verifyVestSig: _verifyValidVestingPosition(vestingSignature, investorVestingConfig)
    q_verifyVestSig --> q_markClaimed: s_investorPositions[msg.sender].hasClaimed = true
    q_markClaimed --> q_calcVesting: amountToVest = claimAmount * vestingPercentage / 100
    q_calcVesting --> q_calcImmediate: amountImmediate = claimAmount - amountToVest
    q_calcImmediate --> q_checkVest: amountToVest > 0?
    q_checkVest --> q_deployVesting: deployVesting(vestingConfig) via VestingManager
    q_checkVest --> q_directTransfer: amountToVest == 0
    q_deployVesting --> q_transferVest: safeTransfer(vestingContract, amountToVest)
    q_transferVest --> q_directTransfer: transfer immediate portion
    q_directTransfer --> q_transfer: safeTransfer(msg.sender, amountImmediate)
    q_transfer --> q_emit: emit TokenAllocationClaimed(amountToVest, amountImmediate, msg.sender)
    q_emit --> [*]: return

    note right of q_verifyClaim
        INV-001: Tokens must have been supplied by project first
        INV-002: Each investor can only claim once
    end note

    note right of q_deployVesting
        INV-003: Vesting contract deployed per investor if vestingPercentage > 0
        INV-004: Vesting params authenticated by Legion signer
    end note
