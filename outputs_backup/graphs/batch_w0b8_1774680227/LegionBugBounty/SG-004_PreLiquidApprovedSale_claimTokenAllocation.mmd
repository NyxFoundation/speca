---
title: "claimTokenAllocation (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard1: whenNotPaused
    q_guard1 --> q_guard2: whenSaleNotCanceled
    q_guard2 --> q_guard3: whenSaleEnded
    q_guard3 --> q_guard4: whenRefundPeriodIsOver
    q_guard4 --> q_guard5: whenTokensSupplied
    q_guard5 --> q_verifyClaim: _verifyCanClaimTokenAllocation(positionId)
    q_verifyClaim --> q_verifyClaimSig: _verifyValidPosition(claimSignature, positionId, CLAIM)
    q_verifyClaimSig --> q_verifyVestSig: _verifyValidVestingPosition(vestingSignature, positionId, vestingConfig)
    q_verifyVestSig --> q_markSettled: s_investorPositions[msg.sender].hasSettled = true
    q_markSettled --> q_calcVesting: amountToVest = claimAmount * vestingConfig.vestingPercentage / 100
    q_calcVesting --> q_calcImmediate: amountImmediate = claimAmount - amountToVest
    q_calcImmediate --> q_checkVest: amountToVest > 0?
    q_checkVest --> q_deployVesting: LegionVestingManager.deployVesting(vestingConfig)
    q_checkVest --> q_transferImmediate: amountToVest == 0
    q_deployVesting --> q_transferToVesting: safeTransfer(vestingContract, amountToVest)
    q_transferToVesting --> q_transferImmediate: transfer immediate tokens
    q_transferImmediate --> q_transfer: safeTransfer(msg.sender, amountImmediate)
    q_transfer --> q_emit: emit TokenAllocationClaimed(amountToVest, amountImmediate, msg.sender, positionId)
    q_emit --> [*]: return

    note right of q_verifyClaim
        INV-001: Investor must not have already settled (hasSettled == false)
        INV-002: Investor must not have refunded
    end note

    note right of q_calcVesting
        INV-003: vestingPercentage in range [0, 100]
        INV-004: amountToVest + amountImmediate == claimAmount
    end note

    note right of q_deployVesting
        INV-005: Vesting contract deployed per investor via factory
        INV-006: Vesting parameters validated by signature from legionSigner
    end note
