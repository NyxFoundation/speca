---
title: "cancel and withdrawInvestedCapitalIfCanceled (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_cancelGuard: cancel() - onlyProject, whenNotPaused, whenSaleNotCanceled, whenTokensNotSupplied
    q_cancelGuard --> q_markCanceled: s_saleStatus.isCanceled = true
    q_markCanceled --> q_emitCancel: emit SaleCanceled()
    q_emitCancel --> q_waitWithdraw: Investors can now withdraw

    q_waitWithdraw --> q_withdrawGuard: withdrawInvestedCapitalIfCanceled() - whenNotPaused, whenSaleCanceled
    q_withdrawGuard --> q_getPos: positionId = s_investorPositions[msg.sender].positionId
    q_getPos --> q_verifyNotRefunded: _verifyHasNotRefunded(positionId)
    q_verifyNotRefunded --> q_getAmount: amount = s_investorPositions[msg.sender].capitalInvested
    q_getAmount --> q_markRefunded: s_investorPositions[msg.sender].hasRefunded = true
    q_markRefunded --> q_transfer: safeTransfer(msg.sender, amount)
    q_transfer --> q_emit: emit CapitalRefundedAfterCancel(amount, msg.sender, positionId)
    q_emit --> [*]: return

    note right of q_cancelGuard
        INV-001: Cancel only allowed before tokens are supplied
        INV-002: Only project admin can cancel
    end note

    note right of q_verifyNotRefunded
        INV-003: Each investor can only withdraw once after cancel
        INV-004: Full invested capital is returned
    end note
