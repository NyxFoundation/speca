---
title: "claimTokenAllocation (LegionAbstractSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: whenNotPaused AND whenSaleNotCanceled AND whenRefundPeriodIsOver AND whenTokensSupplied
    q_guard --> q_get_position: guards pass
    q_get_position --> q_verify_exists: positionId = _getInvestorPositionId(msg.sender)
    q_verify_exists --> q_verify_refund: _verifyPositionExists(positionId)
    q_verify_refund --> q_verify_claim: _verifyHasNotRefunded(positionId)
    q_verify_claim --> q_verify_merkle: _verifyCanClaimTokenAllocation(positionId) - check not already settled
    q_verify_merkle --> q_mark_settled: verify claimMerkleRoot proof for claimAmount
    q_mark_settled --> q_calc_vested: hasSettled = true
    q_calc_vested --> q_calc_tge: amountToBeVested = claimAmount - amountToDistributeOnClaim
    q_calc_tge --> q_check_vested: amountToDistributeOnClaim = claimAmount * tokenAllocationOnTGERate / DENOMINATOR
    q_check_vested --> q_deploy_vesting: amountToBeVested != 0
    q_deploy_vesting --> q_transfer_vesting: vestingAddress = _createVesting(investorVestingConfig, askToken)
    q_transfer_vesting --> q_check_tge: safeTransfer(askToken, vestingAddress, amountToBeVested)
    q_check_vested --> q_check_tge: amountToBeVested == 0
    q_check_tge --> q_transfer_tge: amountToDistributeOnClaim != 0
    q_transfer_tge --> [*]: safeTransfer(askToken, msg.sender, amountToDistributeOnClaim)
    q_check_tge --> [*]: amountToDistributeOnClaim == 0

    note right of q_calc_vested
        INV-001: claimAmount verified via merkle proof
        INV-002: hasSettled prevents double-claim
        INV-003: totalAmount = amountToDistributeOnClaim + amountToBeVested
        INV-004: vesting contract deployed per-investor if vested amount > 0
    end note
