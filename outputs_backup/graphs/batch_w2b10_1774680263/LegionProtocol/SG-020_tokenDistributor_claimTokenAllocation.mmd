---
title: "claimTokenAllocation (LegionTokenDistributor)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: whenNotPaused
    q_guard --> q_verify_vesting: guards pass
    q_verify_vesting --> q_verify_claim: _verifyValidVestingConfig(investorVestingConfig)
    q_verify_claim --> q_revert_not_supplied: tokensSupplied == false
    q_revert_not_supplied --> [*]: revert LegionSale__TokensNotSupplied()
    q_verify_claim --> q_revert_settled: hasSettled == true
    q_revert_settled --> [*]: revert LegionSale__AlreadySettled()
    q_verify_claim --> q_verify_pos: tokens supplied and not settled
    q_verify_pos --> q_revert_sig: ECDSA.recover(claimAmount hash) != legionSigner
    q_revert_sig --> [*]: revert LegionSale__InvalidSignature()
    q_verify_pos --> q_verify_vest_sig: signature valid
    q_verify_vest_sig --> q_settle: _verifyValidVestingPosition(vestingSignature, investorVestingConfig)
    q_settle --> q_update: hasSettled = true
    q_update --> q_calc_tge: totalAmountClaimed += claimAmount
    q_calc_tge --> q_calc_vested: amountToDistributeOnClaim = claimAmount * tokenAllocationOnTGERate / DENOMINATOR
    q_calc_vested --> q_check_vest: amountToBeVested = claimAmount - amountToDistributeOnClaim
    q_check_vest --> q_deploy: amountToBeVested != 0
    q_deploy --> q_transfer_vest: vestingAddress = _createVesting(investorVestingConfig, askToken)
    q_transfer_vest --> q_check_tge: safeTransfer(askToken, vestingAddress, amountToBeVested)
    q_check_vest --> q_check_tge: amountToBeVested == 0
    q_check_tge --> q_transfer_tge: amountToDistributeOnClaim != 0
    q_transfer_tge --> [*]: safeTransfer(askToken, msg.sender, amountToDistributeOnClaim)
    q_check_tge --> [*]: amountToDistributeOnClaim == 0

    note right of q_calc_tge
        INV-001: claimAmount verified by Legion signer signature
        INV-002: vesting config verified by separate Legion signer signature
        INV-003: hasSettled prevents double claiming
        INV-004: totalAmountClaimed tracks cumulative distributions
        INV-005: no merkle proof used here - pure signature-based authorization
    end note
