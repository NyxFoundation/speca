---
title: "invest (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: whenNotPaused AND whenSaleNotCanceled AND whenSaleNotEnded
    q_guard --> q_check_position: guards pass
    q_check_position --> q_create: _getInvestorPositionId(msg.sender) == 0
    q_create --> q_verify_refund: positionId = _createInvestorPosition(msg.sender)
    q_check_position --> q_verify_refund: positionId = s_investorPositionIds[msg.sender]
    q_verify_refund --> q_verify_sig_used: _verifyHasNotRefunded(positionId)
    q_verify_sig_used --> q_verify_excess: _verifySignatureNotUsed(investSignature)
    q_verify_excess --> q_update_totals: _verifyCanClaimExcessCapital(positionId)
    q_update_totals --> q_mark_sig: totalCapitalInvested += amount; investedCapital += amount
    q_mark_sig --> q_update_position: usedSignatures[msg.sender][investSignature] = true
    q_update_position --> q_verify_valid: _updateInvestorPosition(investAmount, tokenAllocationRate, positionId)
    q_verify_valid --> q_revert_amount: investedCapital != cachedInvestAmount
    q_revert_amount --> [*]: revert LegionSale__InvalidPositionAmount()
    q_verify_valid --> q_revert_sig: ECDSA.recover != legionSigner
    q_revert_sig --> [*]: revert LegionSale__InvalidSignature()
    q_verify_valid --> q_emit: signature valid and amounts match
    q_emit --> q_transfer: emit CapitalInvested(amount, msg.sender, positionId)
    q_transfer --> [*]: safeTransferFrom(bidToken, msg.sender, address(this), amount)

    note right of q_update_position
        INV-001: investedCapital must exactly equal cachedInvestAmount (SAFT enforcement)
        INV-002: signature includes investAmount and tokenAllocationRate to prevent tampering
        INV-003: each signature can only be used once (replay protection)
        INV-004: position tracks investAmount and tokenAllocationRate from Legion signer
    end note
