---
title: "publishSaleResults (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: onlyLegion AND whenNotPaused AND whenSaleNotCanceled AND whenRefundPeriodIsOver
    q_guard --> q_revert_auth: msg.sender != legionBouncer
    q_revert_auth --> [*]: revert LegionSale__NotCalledByLegion()
    q_guard --> q_verify: guards pass
    q_verify --> q_revert_published: _verifyCanPublishSaleResults() fails
    q_revert_published --> [*]: revert LegionSale__SaleResultsAlreadyPublished()
    q_verify --> q_set_merkle: can publish
    q_set_merkle --> q_set_accepted: claimTokensMerkleRoot = claimMerkleRoot
    q_set_accepted --> q_set_tokens: acceptedCapitalMerkleRoot = acceptedMerkleRoot
    q_set_tokens --> q_calc_capital: totalTokensAllocated = tokensAllocated
    q_calc_capital --> q_emit: totalCapitalRaised = (tokensAllocated * tokenPrice) / (10 ** askTokenDecimals)
    q_emit --> [*]: emit SaleResultsPublished(claimMerkleRoot, acceptedMerkleRoot, tokensAllocated)

    note right of q_calc_capital
        INV-001: totalCapitalRaised derived from tokensAllocated * tokenPrice / decimals
        INV-002: sale results can only be published once
        INV-003: only callable after refund period ends
    end note
