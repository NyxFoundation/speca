---
title: "initialize (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: _verifyValidParams(fixedPriceSaleInitParams)
    q_validate --> q_check_zero: prefundPeriodSeconds == 0 OR prefundAllocationPeriodSeconds == 0 OR tokenPrice == 0
    q_check_zero --> q_revert_zero: true
    q_revert_zero --> [*]: revert LegionSale__ZeroValueProvided()
    q_check_zero --> q_check_max: false
    q_check_max --> q_revert_period: prefundPeriodSeconds > 12 weeks OR prefundAllocationPeriodSeconds > 2 weeks
    q_revert_period --> [*]: revert LegionSale__InvalidPeriodConfig()
    q_check_max --> q_check_min: false
    q_check_min --> q_revert_period2: prefundPeriodSeconds < 1 hours OR prefundAllocationPeriodSeconds < 1 hours
    q_revert_period2 --> [*]: revert LegionSale__InvalidPeriodConfig()
    q_check_min --> q_set_common: false
    q_set_common --> q_set_price: _setLegionSaleConfig(saleInitParams)
    q_set_price --> q_set_prefund: tokenPrice = fixedPriceSaleInitParams.tokenPrice
    q_set_prefund --> q_set_times: prefundStartTime = block.timestamp; prefundEndTime = prefundStartTime + prefundPeriodSeconds
    q_set_times --> [*]: startTime = prefundEndTime + prefundAllocationPeriodSeconds; endTime = startTime + salePeriodSeconds; refundEndTime = endTime + refundPeriodSeconds

    note right of q_validate
        INV-001: tokenPrice must be non-zero
        INV-002: prefundPeriodSeconds in [1 hours, 12 weeks]
        INV-003: prefundAllocationPeriodSeconds in [1 hours, 2 weeks]
        INV-004: Time ordering: prefundStartTime < prefundEndTime < startTime < endTime < refundEndTime
    end note
