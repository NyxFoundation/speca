---
title: "withdrawRaisedCapital (LegionAbstractSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: onlyProject AND whenNotPaused AND whenSaleNotCanceled AND whenRefundPeriodIsOver AND whenTokensSupplied
    q_guard --> q_verify: guards pass
    q_verify --> q_revert_withdrawn: totalCapitalWithdrawn > 0
    q_revert_withdrawn --> [*]: revert LegionSale__CapitalAlreadyWithdrawn()
    q_verify --> q_revert_no_capital: totalCapitalRaised == 0
    q_revert_no_capital --> [*]: revert LegionSale__CapitalNotRaised()
    q_verify --> q_cache: can withdraw
    q_cache --> q_calc_fees: totalCapitalWithdrawn = totalCapitalRaised
    q_calc_fees --> q_calc_referrer: legionFee = (legionFeeOnCapitalRaisedBps * totalCapitalRaised) / BASIS_POINTS
    q_calc_referrer --> q_emit: referrerFee = (referrerFeeOnCapitalRaisedBps * totalCapitalRaised) / BASIS_POINTS
    q_emit --> q_transfer_project: emit CapitalWithdrawn(totalCapitalRaised)
    q_transfer_project --> q_transfer_legion: safeTransfer(bidToken, msg.sender, totalCapitalRaised - legionFee - referrerFee)
    q_transfer_legion --> q_transfer_referrer: safeTransfer(bidToken, legionFeeReceiver, legionFee) if legionFee != 0
    q_transfer_referrer --> [*]: safeTransfer(bidToken, referrerFeeReceiver, referrerFee) if referrerFee != 0

    note right of q_calc_fees
        INV-001: capital can only be withdrawn once (totalCapitalWithdrawn check)
        INV-002: project receives totalCapitalRaised minus all fees
        INV-003: fee calculation uses basis points (10000 = 100%)
        INV-004: withdrawal only after refund period and tokens supplied
    end note
