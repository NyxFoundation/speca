---
title: "refund (LegionAbstractSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: whenNotPaused AND whenSaleNotCanceled AND whenRefundPeriodNotOver
    q_guard --> q_get_position: guards pass
    q_get_position --> q_verify_exists: positionId = _getInvestorPositionId(msg.sender)
    q_verify_exists --> q_revert_no_pos: positionId == 0
    q_revert_no_pos --> [*]: revert LegionSale__InvalidPositionId()
    q_verify_exists --> q_verify_not_refunded: positionId != 0
    q_verify_not_refunded --> q_revert_refunded: hasRefunded == true
    q_revert_refunded --> [*]: revert LegionSale__InvestorHasRefunded()
    q_verify_not_refunded --> q_verify_merkle: hasRefunded == false
    q_verify_merkle --> q_cache: verify merkle proof for accepted capital
    q_cache --> q_calc_excess: amountToRefund = investedCapital - acceptedCapital
    q_calc_excess --> q_update_position: set investedCapital = acceptedCapital; hasRefunded = true
    q_update_position --> q_update_total: totalCapitalInvested -= amountToRefund
    q_update_total --> q_emit: emit CapitalRefunded(amountToRefund, msg.sender, positionId)
    q_emit --> [*]: safeTransfer(bidToken, msg.sender, amountToRefund)

    note right of q_calc_excess
        INV-001: refund amount = investedCapital - acceptedCapital (excess only)
        INV-002: investor can only refund once (hasRefunded flag)
        INV-003: refund only during active refund period
        INV-004: totalCapitalInvested decreases by refund amount
    end note
