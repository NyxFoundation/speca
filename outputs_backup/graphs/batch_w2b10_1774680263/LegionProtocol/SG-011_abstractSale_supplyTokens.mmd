---
title: "supplyTokens (LegionAbstractSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: onlyProject AND whenNotPaused AND whenSaleNotCanceled AND whenTokensNotSupplied
    q_guard --> q_verify: guards pass
    q_verify --> q_revert_not_allocated: totalTokensAllocated == 0
    q_revert_not_allocated --> [*]: revert LegionSale__TokensNotAllocated()
    q_verify --> q_revert_mismatch: amount != totalTokensAllocated
    q_revert_mismatch --> [*]: revert LegionSale__InvalidTokenAmountSupplied()
    q_verify --> q_calc_fees: amount == totalTokensAllocated
    q_calc_fees --> q_verify_legion_fee: expectedLegionFee = (legionFeeOnTokensBps * amount) / BASIS_POINTS
    q_verify_legion_fee --> q_revert_fee: legionFee != expectedLegionFeeAmount
    q_revert_fee --> [*]: revert LegionSale__InvalidFeeAmount()
    q_verify_legion_fee --> q_verify_referrer_fee: legionFee matches
    q_verify_referrer_fee --> q_flag: referrerFee matches
    q_flag --> q_emit: tokensSupplied = true
    q_emit --> q_transfer_tokens: emit TokensSuppliedForDistribution(amount, legionFee, referrerFee)
    q_transfer_tokens --> q_transfer_legion: safeTransferFrom(askToken, msg.sender, address(this), amount)
    q_transfer_legion --> q_transfer_referrer: safeTransferFrom(askToken, msg.sender, legionFeeReceiver, legionFee) if != 0
    q_transfer_referrer --> [*]: safeTransferFrom(askToken, msg.sender, referrerFeeReceiver, referrerFee) if != 0

    note right of q_calc_fees
        INV-001: supplied amount must exactly equal totalTokensAllocated
        INV-002: tokens can only be supplied once (tokensSupplied flag)
        INV-003: fees calculated at basis point precision
        INV-004: three separate transfers: distribution pool, legion fee, referrer fee
    end note
