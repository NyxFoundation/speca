---
title: "claimTokenAllocation (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: whenNotPaused AND whenSaleNotCanceled AND whenSaleEnded AND whenRefundPeriodIsOver AND whenTokensSupplied
    q_guard --> q_get_pos: guards pass
    q_get_pos --> q_verify_exists: positionId = _getInvestorPositionId(msg.sender)
    q_verify_exists --> q_verify_refund: _verifyPositionExists(positionId)
    q_verify_refund --> q_verify_vesting: _verifyHasNotRefunded(positionId)
    q_verify_vesting --> q_verify_settled: _verifyValidVestingConfig(investorVestingConfig)
    q_verify_settled --> q_update_pos: _verifyCanClaimTokenAllocation(positionId) - check not already settled
    q_update_pos --> q_verify_position: _updateInvestorPosition(investAmount, tokenAllocationRate, positionId)
    q_verify_position --> q_verify_vesting_sig: _verifyValidPosition(claimSignature, positionId, CLAIM_TOKEN_ALLOCATION)
    q_verify_vesting_sig --> q_verify_claim_sig: _verifyValidVestingPosition(vestingSignature, positionId, investorVestingConfig)
    q_verify_claim_sig --> q_mark_used: _verifySignatureNotUsed(claimSignature)
    q_mark_used --> q_settle: usedSignatures[msg.sender][claimSignature] = true
    q_settle --> q_calc: hasSettled = true
    q_calc --> q_calc_tge: totalAmount = askTokenTotalSupply * cachedTokenAllocationRate / DENOMINATOR
    q_calc_tge --> q_calc_vested: amountToDistributeOnClaim = totalAmount * tokenAllocationOnTGERate / DENOMINATOR
    q_calc_vested --> q_check_vest: amountToBeVested = totalAmount - amountToDistributeOnClaim
    q_check_vest --> q_deploy: amountToBeVested != 0
    q_deploy --> q_transfer_vest: vestingAddress = _createVesting(investorVestingConfig, askToken)
    q_transfer_vest --> q_check_tge: safeTransfer(askToken, vestingAddress, amountToBeVested)
    q_check_vest --> q_check_tge: amountToBeVested == 0
    q_check_tge --> q_transfer_claim: amountToDistributeOnClaim != 0
    q_transfer_claim --> [*]: safeTransfer(askToken, msg.sender, amountToDistributeOnClaim)
    q_check_tge --> [*]: amountToDistributeOnClaim == 0

    note right of q_calc
        INV-001: totalAmount = askTokenTotalSupply * cachedTokenAllocationRate / DENOMINATOR
        INV-002: amountToDistributeOnClaim + amountToBeVested = totalAmount
        INV-003: vesting signature validates vesting config is authorized by Legion
        INV-004: claim signature validates position data is authorized by Legion
        INV-005: hasSettled prevents double claiming
    end note
