---
title: "supplyTokens (LegionTokenDistributor)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guard: onlyProject AND whenNotPaused
    q_guard --> q_verify: guards pass
    q_verify --> q_revert_supplied: tokensSupplied == true
    q_revert_supplied --> [*]: revert LegionSale__TokensAlreadySupplied()
    q_verify --> q_revert_mismatch: amount != totalAmountToDistribute
    q_revert_mismatch --> [*]: revert LegionSale__InvalidTokenAmountSupplied()
    q_verify --> q_calc_fees: amount matches and not yet supplied
    q_calc_fees --> q_verify_legion: expectedLegionFee = (legionFeeOnTokensSoldBps * amount) / BASIS_POINTS
    q_verify_legion --> q_revert_fee: legionFee != expectedLegionFeeAmount
    q_revert_fee --> [*]: revert LegionSale__InvalidFeeAmount()
    q_verify_legion --> q_verify_referrer: legionFee matches
    q_verify_referrer --> q_flag: referrerFee matches
    q_flag --> q_emit: tokensSupplied = true
    q_emit --> q_transfer: emit TokensSuppliedForDistribution(amount, legionFee, referrerFee)
    q_transfer --> q_legion_fee: safeTransferFrom(askToken, msg.sender, address(this), amount)
    q_legion_fee --> q_referrer_fee: safeTransferFrom(askToken, msg.sender, legionFeeReceiver, legionFee) if != 0
    q_referrer_fee --> [*]: safeTransferFrom(askToken, msg.sender, referrerFeeReceiver, referrerFee) if != 0

    note right of q_calc_fees
        INV-001: supply amount must exactly match totalAmountToDistribute
        INV-002: tokensSupplied flag prevents double supply
        INV-003: fee amounts must match expected calculation exactly
    end note
