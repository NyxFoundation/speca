---
title: "withdrawRaisedCapital (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_auth: check caller is projectAdmin
    q_check_auth --> q_revert_auth: caller != projectAdmin
    q_revert_auth --> [*]: revert Unauthorized
    q_check_auth --> q_check_refund: caller is projectAdmin
    q_check_refund --> q_revert_timing: block.timestamp <= refundEndTime
    q_revert_timing --> [*]: revert RefundPeriodNotEnded
    q_check_refund --> q_check_supplied: refund period ended
    q_check_supplied --> q_revert_supply: tokens not supplied
    q_revert_supply --> [*]: revert TokensNotSupplied
    q_check_supplied --> q_check_withdrawn: tokens supplied
    q_check_withdrawn --> q_revert_dup: capital already withdrawn
    q_revert_dup --> [*]: revert CapitalAlreadyWithdrawn
    q_check_withdrawn --> q_calc_fees: capital not yet withdrawn
    q_calc_fees --> q_transfer_legion: legionCapitalFee = totalCapitalRaised * legionFeeOnCapitalBps / 10000
    q_transfer_legion --> q_transfer_referrer: transfer legionCapitalFee to legionFeeReceiver
    q_transfer_referrer --> q_transfer_project: transfer referrerFee to referrer
    q_transfer_project --> q_set_flag: transfer remaining capital to projectAdmin
    q_set_flag --> [*]: capitalWithdrawn = true, emit CapitalWithdrawn

    note right of q_calc_fees
        INV-001: fee deductions use basis points (bps / 10000)
        INV-002: project receives totalCapitalRaised minus all fees
    end note

    note right of q_check_supplied
        INV-003: capital withdrawal requires tokens to be supplied first
        INV-004: capital can only be withdrawn once
    end note
