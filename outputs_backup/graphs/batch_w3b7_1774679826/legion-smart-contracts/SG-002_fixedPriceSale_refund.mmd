---
title: "refund (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_time: caller invokes refund()
    q_check_time --> q_revert_time: now > refundEndTime or now < endTime
    q_revert_time --> [*]: revert InvalidTiming
    q_check_time --> q_check_position: endTime <= now <= refundEndTime
    q_check_position --> q_revert_none: position.totalInvested == 0
    q_revert_none --> [*]: revert NoInvestment
    q_check_position --> q_check_refunded: position.totalInvested > 0
    q_check_refunded --> q_revert_dup: position.refunded == true
    q_revert_dup --> [*]: revert AlreadyRefunded
    q_check_refunded --> q_process: position.refunded == false
    q_process --> q_update: amount = position.totalInvested
    q_update --> q_transfer: position.refunded = true; totalCapitalInvested -= amount
    q_transfer --> [*]: transfer(investor, amount); emit Refunded(investor, amount)

    note right of q_check_time
        INV-001: Refunds only allowed during refund period (after sale ends, before refundEndTime)
        INV-002: Each investor can refund exactly once
    end note

    note right of q_update
        INV-003: totalCapitalInvested is decremented atomically with refund
    end note
