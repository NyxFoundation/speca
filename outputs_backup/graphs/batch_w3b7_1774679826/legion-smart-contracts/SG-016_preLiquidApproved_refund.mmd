---
title: "refund (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_position: investor invokes refund()
    q_check_position --> q_revert_none: position.totalInvested == 0
    q_revert_none --> [*]: revert NoInvestment
    q_check_position --> q_check_refunded: position.totalInvested > 0
    q_check_refunded --> q_revert_dup: position.refunded == true
    q_revert_dup --> [*]: revert AlreadyRefunded
    q_check_refunded --> q_check_window: position.refunded == false
    q_check_window --> q_revert_window: now > position.lastInvestTimestamp + 14 days
    q_revert_window --> [*]: revert RefundWindowExpired
    q_check_window --> q_process: now <= position.lastInvestTimestamp + 14 days
    q_process --> q_transfer: amount = position.totalInvested; position.refunded = true; totalCapitalInvested -= amount
    q_transfer --> [*]: transfer(investor, amount); emit Refunded(investor, amount)

    note right of q_check_window
        INV-001: Each investor has individual 14-day refund window from last investment
        INV-002: Refund window is per-investor, not global
        INV-003: Each investor can refund exactly once
    end note
