---
title: "invest (LegionSealedBidAuctionSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_time: investor invokes invest(amount, encryptedBid, signature)
    q_check_time --> q_revert_time: now < startTime or now > endTime
    q_revert_time --> [*]: revert InvalidTiming
    q_check_time --> q_validate_sig: startTime <= now <= endTime
    q_validate_sig --> q_revert_sig: signature verification fails
    q_revert_sig --> [*]: revert InvalidSignature
    q_validate_sig --> q_check_min: signature valid
    q_check_min --> q_revert_min: amount < minimumInvestAmount
    q_revert_min --> [*]: revert BelowMinimumInvestment
    q_check_min --> q_validate_ecies: amount >= minimumInvestAmount
    q_validate_ecies --> q_revert_ecies: encryptedBid.sealedBidPublicKey != auction publicKey
    q_revert_ecies --> [*]: revert InvalidECIESParams
    q_validate_ecies --> q_check_salt: public key matches
    q_check_salt --> q_revert_salt: encryptedBid.salt != uint256(investor)
    q_revert_salt --> [*]: revert InvalidSalt
    q_check_salt --> q_transfer: salt matches investor address
    q_transfer --> q_update: transferFrom(investor, address(this), amount)
    q_update --> q_emit: position.totalInvested += amount; position.encryptedBid = encryptedBid; totalCapitalInvested += amount
    q_emit --> [*]: emit Invested(investor, amount, encryptedBid)

    note right of q_validate_ecies
        INV-001: Sealed bid public key must match auction ECIES public key
        INV-002: Salt must equal investor address cast to uint256
        INV-003: Encrypted bid conceals desired token allocation amount
    end note

    note right of q_validate_sig
        INV-004: Authorized Legion signer must produce valid signature
        INV-005: Each investment must meet minimumInvestAmount threshold
    end note
