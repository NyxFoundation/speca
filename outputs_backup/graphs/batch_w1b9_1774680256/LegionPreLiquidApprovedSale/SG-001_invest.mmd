---
title: "invest (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_paused: whenNotPaused
    q_check_paused --> q_check_canceled: whenSaleNotCanceled
    q_check_canceled --> q_check_ended: whenSaleNotEnded
    q_check_ended --> q_check_position: positionId = getInvestorPositionId(msg.sender)
    q_check_position --> q_create_position: positionId == 0
    q_check_position --> q_verify_refund: positionId != 0
    q_create_position --> q_verify_refund: positionId = createInvestorPosition(msg.sender)
    q_verify_refund --> q_verify_sig: verifyHasNotRefunded(positionId)
    q_verify_sig --> q_verify_excess: verifySignatureNotUsed(investSignature)
    q_verify_excess --> q_update_totals: verifyCanClaimExcessCapital(positionId)
    q_update_totals --> q_update_investor: totalCapitalInvested += amount
    q_update_investor --> q_mark_sig: position.investedCapital += amount
    q_mark_sig --> q_update_position: usedSignatures[sender][sig] = true
    q_update_position --> q_verify_valid: updateInvestorPosition(investAmount, tokenAllocationRate, positionId)
    q_verify_valid --> q_emit: verifyValidPosition(sig, positionId, INVEST)
    q_emit --> q_transfer: emit CapitalInvested(amount, sender, positionId)
    q_transfer --> [*]: safeTransferFrom(bidToken, sender, this, amount)

    note right of q_verify_valid
        INV-001: position.investedCapital == position.cachedInvestAmount after update
        INV-002: signature must recover to legionSigner address
        INV-003: each signature can only be used once per investor
    end note

    note right of q_update_totals
        INV-004: totalCapitalInvested is sum of all investor positions
        INV-005: transfer happens AFTER all state updates (CEI pattern)
    end note
