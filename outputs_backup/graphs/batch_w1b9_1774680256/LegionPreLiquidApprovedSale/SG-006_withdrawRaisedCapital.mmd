---
title: "withdrawRaisedCapital (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_auth: onlyProject
    q_auth --> q_guards: whenNotPaused, whenSaleNotCanceled, whenSaleEnded, whenRefundPeriodIsOver
    q_guards --> q_verify: verifyCanWithdrawCapital()
    q_verify --> q_cache: totalCapitalRaised cached
    q_cache --> q_set_withdrawn: totalCapitalWithdrawn = totalCapitalRaised
    q_set_withdrawn --> q_calc_legion_fee: legionFee = feeBps * capitalRaised / BPS
    q_calc_legion_fee --> q_calc_referrer_fee: referrerFee = referrerBps * capitalRaised / BPS
    q_calc_referrer_fee --> q_emit: emit CapitalWithdrawn(totalCapitalRaised)
    q_emit --> q_transfer_project: safeTransfer(bidToken, sender, capitalRaised - legionFee - referrerFee)
    q_transfer_project --> q_transfer_legion: legionFee != 0
    q_transfer_legion --> q_transfer_referrer: safeTransfer to legionFeeReceiver
    q_transfer_referrer --> [*]: safeTransfer to referrerFeeReceiver

    note right of q_verify
        INV-001: totalCapitalWithdrawn must be 0 (not yet withdrawn)
        INV-002: totalCapitalRaised must be > 0 (published by Legion)
        INV-003: project receives capitalRaised - legionFee - referrerFee
    end note

    note right of q_set_withdrawn
        INV-004: state updated before transfers (CEI pattern)
        INV-005: capital can only be withdrawn once
    end note
