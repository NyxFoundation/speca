---
title: "claimTokenAllocation (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_guards: whenNotPaused, whenSaleNotCanceled, whenSaleEnded, whenRefundPeriodIsOver, whenTokensSupplied
    q_guards --> q_get_position: positionId = getInvestorPositionId(sender)
    q_get_position --> q_verify_exists: verifyPositionExists(positionId)
    q_verify_exists --> q_verify_not_refunded: verifyHasNotRefunded(positionId)
    q_verify_not_refunded --> q_verify_vesting: verifyValidVestingConfig(investorVestingConfig)
    q_verify_vesting --> q_verify_can_claim: verifyCanClaimTokenAllocation(positionId)
    q_verify_can_claim --> q_update_position: updateInvestorPosition(investAmount, tokenAllocationRate, positionId)
    q_update_position --> q_verify_claim_sig: verifyValidPosition(claimSignature, positionId, CLAIM_TOKEN_ALLOCATION)
    q_verify_claim_sig --> q_verify_vesting_sig: verifyValidVestingPosition(vestingSignature, positionId, config)
    q_verify_vesting_sig --> q_verify_sig_unused: verifySignatureNotUsed(claimSignature)
    q_verify_sig_unused --> q_mark_used: usedSignatures[sender][claimSig] = true
    q_mark_used --> q_settle: position.hasSettled = true
    q_settle --> q_calc_total: totalAmount = askTokenTotalSupply * tokenAllocationRate / DENOMINATOR
    q_calc_total --> q_calc_tge: amountOnClaim = totalAmount * tgeRate / DENOMINATOR
    q_calc_tge --> q_calc_vested: amountToVest = totalAmount - amountOnClaim
    q_calc_vested --> q_check_vest: amountToVest != 0
    q_check_vest --> q_deploy_vesting: amountToVest > 0
    q_check_vest --> q_check_claim: amountToVest == 0
    q_deploy_vesting --> q_transfer_vest: vestingAddr = createVesting(config, askToken)
    q_transfer_vest --> q_check_claim: safeTransfer(askToken, vestingAddr, amountToVest)
    q_check_claim --> q_transfer_claim: amountOnClaim > 0
    q_check_claim --> [*]: amountOnClaim == 0
    q_transfer_claim --> [*]: safeTransfer(askToken, sender, amountOnClaim)

    note right of q_calc_total
        INV-001: totalAmount = askTokenTotalSupply * cachedTokenAllocationRate / DENOMINATOR
        INV-002: amountOnClaim + amountToVest == totalAmount (no tokens lost)
        INV-003: investor can only claim once (hasSettled flag)
    end note

    note right of q_verify_claim_sig
        INV-004: claim signature and vesting signature both verified against legionSigner
        INV-005: vesting config includes cliff, duration, tgeRate parameters
    end note
