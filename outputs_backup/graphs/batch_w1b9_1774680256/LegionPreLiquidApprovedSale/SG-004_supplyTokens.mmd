---
title: "supplyTokens (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_auth: onlyProject
    q_auth --> q_check_paused: whenNotPaused
    q_check_paused --> q_check_canceled: whenSaleNotCanceled
    q_check_canceled --> q_check_not_supplied: whenTokensNotSupplied
    q_check_not_supplied --> q_verify_can_supply: verifyCanSupplyTokens(amount)
    q_verify_can_supply --> q_flag_supplied: tokensSupplied = true
    q_flag_supplied --> q_calc_legion_fee: expectedLegionFee = legionFeeBps * amount / BPS
    q_calc_legion_fee --> q_calc_referrer_fee: expectedReferrerFee = referrerFeeBps * amount / BPS
    q_calc_referrer_fee --> q_verify_legion_fee: legionFee == expectedLegionFee
    q_verify_legion_fee --> q_verify_referrer_fee: referrerFee == expectedReferrerFee
    q_verify_referrer_fee --> q_emit: emit TokensSuppliedForDistribution
    q_emit --> q_transfer_tokens: safeTransferFrom(askToken, sender, this, amount)
    q_transfer_tokens --> q_transfer_legion: legionFee != 0
    q_transfer_legion --> q_transfer_referrer: safeTransferFrom to legionFeeReceiver
    q_transfer_referrer --> [*]: safeTransferFrom to referrerFeeReceiver

    note right of q_verify_can_supply
        INV-001: amount must equal totalTokensAllocated set by Legion
        INV-002: totalTokensAllocated must be non-zero (TGE details published)
        INV-003: tokens can only be supplied once (tokensSupplied flag)
    end note

    note right of q_calc_legion_fee
        INV-004: fee amounts must match exactly (no rounding tolerance)
        INV-005: project transfers tokens + fees in same transaction
    end note
