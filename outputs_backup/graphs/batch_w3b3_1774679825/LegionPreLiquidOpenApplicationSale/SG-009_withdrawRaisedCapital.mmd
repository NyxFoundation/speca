---
title: "withdrawRaisedCapital (LegionPreLiquidOpenApplicationSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_auth: withdrawRaisedCapital()
    q_check_auth --> q_check_ended: caller == projectAdmin
    q_check_auth --> q_revert_auth: unauthorized
    q_check_ended --> q_check_refund: hasEnded == true
    q_check_ended --> q_revert_ended: sale not ended
    q_check_refund --> q_check_published: block.timestamp > refundEndTime
    q_check_refund --> q_revert_refund: refund period not ended
    q_check_published --> q_check_withdrawn: capitalPublished == true
    q_check_published --> q_revert_published: capital not published
    q_check_withdrawn --> q_calc_fees: capitalWithdrawn == false
    q_check_withdrawn --> q_revert_withdrawn: already withdrawn
    q_calc_fees --> q_transfer_legion: legionFee = totalCapitalRaised * legionFeeOnCapitalRaisedBps / 10000
    q_transfer_legion --> q_transfer_referrer: bidToken.transfer(legionFeeRecipient, legionFee)
    q_transfer_referrer --> q_transfer_project: bidToken.transfer(referrer, referrerFee)
    q_transfer_project --> q_set_withdrawn: bidToken.transfer(projectAdmin, totalCapitalRaised - legionFee - referrerFee)
    q_set_withdrawn --> q_emit: capitalWithdrawn = true
    q_emit --> [*]: emit CapitalWithdrawn(projectAdmin, amount)
    q_revert_auth --> [*]: revert Unauthorized
    q_revert_ended --> [*]: revert SaleNotEnded
    q_revert_refund --> [*]: revert RefundPeriodNotEnded
    q_revert_published --> [*]: revert CapitalNotPublished
    q_revert_withdrawn --> [*]: revert AlreadyWithdrawn

    note right of q_calc_fees
        INV-001: fees deducted before project receives capital
        INV-002: requires capitalPublished (set by publishRaisedCapital)
        INV-003: fee distribution: legion fee + referrer fee + project remainder = totalCapitalRaised
    end note
