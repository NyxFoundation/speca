---
title: "publishRaisedCapital (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_auth: publishRaisedCapital()
    q_check_auth --> q_check_ended: caller == legionOperator
    q_check_auth --> q_revert_auth: unauthorized
    q_check_ended --> q_check_refund: hasEnded == true
    q_check_ended --> q_revert_ended: sale not yet ended
    q_check_refund --> q_check_published: block.timestamp > refundEndTime
    q_check_refund --> q_revert_refund: refund period not ended
    q_check_published --> q_calc_capital: capitalPublished == false
    q_check_published --> q_revert_published: already published
    q_calc_capital --> q_set_published: totalCapitalRaised = totalInvestedCapital - totalRefunded
    q_set_published --> q_emit: capitalPublished = true
    q_emit --> [*]: emit RaisedCapitalPublished(totalCapitalRaised)
    q_revert_auth --> [*]: revert Unauthorized
    q_revert_ended --> [*]: revert SaleNotEnded
    q_revert_refund --> [*]: revert RefundPeriodNotEnded
    q_revert_published --> [*]: revert AlreadyPublished

    note right of q_calc_capital
        INV-001: totalCapitalRaised = totalInvestedCapital - totalRefunded
        INV-002: published after all individual refund windows expired
        INV-003: gates subsequent withdrawRaisedCapital call
    end note
