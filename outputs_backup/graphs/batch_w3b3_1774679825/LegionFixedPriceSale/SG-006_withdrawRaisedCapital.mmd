---
title: "withdrawRaisedCapital (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_auth: withdrawRaisedCapital()
    q_check_auth --> q_check_timing: caller is projectAdmin
    q_check_auth --> q_revert_auth: unauthorized
    q_check_timing --> q_check_supplied: block.timestamp > refundEndTime
    q_check_timing --> q_revert_timing: refund period not ended
    q_check_supplied --> q_check_published: tokensSupplied == true
    q_check_supplied --> q_revert_supplied: tokens not supplied
    q_check_published --> q_calc_fees: resultsPublished == true
    q_check_published --> q_revert_published: results not published
    q_calc_fees --> q_transfer_fees: compute legionFee and referrerFee from totalCapitalRaised
    q_transfer_fees --> q_transfer_capital: bidToken.transfer(legionAddress, legionFee), bidToken.transfer(referrer, referrerFee)
    q_transfer_capital --> q_mark_withdrawn: bidToken.transfer(projectAdmin, totalCapitalRaised - fees)
    q_mark_withdrawn --> q_emit: capitalWithdrawn = true
    q_emit --> [*]: emit RaisedCapitalWithdrawn(amount, legionFee, referrerFee)
    q_revert_auth --> [*]: revert UnauthorizedAccess
    q_revert_timing --> [*]: revert RefundPeriodNotEnded
    q_revert_supplied --> [*]: revert TokensNotSupplied
    q_revert_published --> [*]: revert ResultsNotPublished

    note right of q_calc_fees
        INV-001: legionFee + referrerFee + projectAmount = totalCapitalRaised
        INV-002: capitalWithdrawn can only transition from false to true
        INV-003: fees computed from basis points match configured rates
    end note
