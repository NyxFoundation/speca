---
title: "withdrawInvestedCapitalIfCanceled (LegionFixedPriceSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_canceled: withdrawInvestedCapitalIfCanceled()
    q_check_canceled --> q_check_position: isCanceled == true
    q_check_canceled --> q_revert_not_canceled: sale not canceled
    q_check_position --> q_check_not_withdrawn: investorPosition[investor].investedCapital > 0
    q_check_position --> q_revert_no_capital: no invested capital
    q_check_not_withdrawn --> q_transfer: investorPosition[investor].hasRefunded == false
    q_check_not_withdrawn --> q_revert_withdrawn: already withdrawn
    q_transfer --> q_mark_refunded: bidToken.transfer(investor, investorPosition[investor].investedCapital)
    q_mark_refunded --> q_emit: investorPosition[investor].hasRefunded = true
    q_emit --> [*]: emit InvestedCapitalRefunded(investor, amount)
    q_revert_not_canceled --> [*]: revert SaleNotCanceled
    q_revert_no_capital --> [*]: revert NoInvestedCapital
    q_revert_withdrawn --> [*]: revert AlreadyWithdrawn

    note right of q_transfer
        INV-001: investor receives exactly their investedCapital amount
        INV-002: hasRefunded is monotonic false->true per investor
        INV-003: total refunds <= total invested capital in contract
    end note
