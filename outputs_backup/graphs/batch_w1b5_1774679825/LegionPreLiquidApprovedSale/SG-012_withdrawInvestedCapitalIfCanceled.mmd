---
title: "withdrawInvestedCapitalIfCanceled (LegionPreLiquidApprovedSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_canceled: investor calls withdrawInvestedCapitalIfCanceled()
    q_check_canceled --> q_revert_not_canceled: isCanceled == false
    q_check_canceled --> q_check_refunded: isCanceled == true
    q_revert_not_canceled --> [*]: revert SaleNotCanceled
    q_check_refunded --> q_revert_refunded: position.hasRefunded == true
    q_check_refunded --> q_calc_refund: position.hasRefunded == false
    q_revert_refunded --> [*]: revert AlreadyRefunded
    q_calc_refund --> q_check_amount: refundAmount = position.investedCapital
    q_check_amount --> q_revert_zero: refundAmount == 0
    q_check_amount --> q_update: refundAmount > 0
    q_revert_zero --> [*]: revert NoInvestedCapital
    q_update --> q_transfer: position.hasRefunded = true
    q_transfer --> q_emit: transfer refundAmount bidToken to investor
    q_emit --> [*]: emit InvestedCapitalWithdrawn(investor, refundAmount)

    note right of q_calc_refund
        INV-001: Full investedCapital is refunded on cancellation
        INV-002: hasRefunded prevents double-withdrawal
        INV-003: Only available when isCanceled == true
    end note
