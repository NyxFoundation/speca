---
title: "withdrawRaisedCapital (LegionPreLiquidOpenApplicationSale)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_auth: projectAdmin calls withdrawRaisedCapital()
    q_check_auth --> q_error_auth: caller is not projectAdmin
    q_error_auth --> [*]: revert Unauthorized
    q_check_auth --> q_check_published: caller is projectAdmin
    q_check_published --> q_error_pub: capitalAlreadyPublished == false
    q_error_pub --> [*]: revert CapitalNotPublished
    q_check_published --> q_check_withdrawn: capitalAlreadyPublished == true
    q_check_withdrawn --> q_error_withdrawn: capitalAlreadyWithdrawn == true
    q_error_withdrawn --> [*]: revert CapitalAlreadyWithdrawn
    q_check_withdrawn --> q_calc_fees: capitalAlreadyWithdrawn == false
    q_calc_fees --> q_transfer_legion: legionFee = totalRaisedCapital * legionFeeRate
    q_transfer_legion --> q_transfer_referrer: transfer legionFee to legionFeeAddress
    q_transfer_referrer --> q_check_referrer: referrerFee = totalRaisedCapital * referrerFeeRate
    q_check_referrer --> q_transfer_project_no_ref: referrerAddress == address(0)
    q_check_referrer --> q_transfer_ref: referrerAddress != address(0)
    q_transfer_ref --> q_transfer_project: transfer referrerFee to referrerAddress
    q_transfer_project_no_ref --> q_set_state: transfer (totalRaisedCapital - legionFee) to projectAdmin
    q_transfer_project --> q_set_state: transfer (totalRaisedCapital - legionFee - referrerFee) to projectAdmin
    q_set_state --> q_emit: capitalAlreadyWithdrawn = true
    q_emit --> [*]: emit RaisedCapitalWithdrawn(projectAmount, legionFee, referrerFee)

    note right of q_calc_fees
        INV-001: Capital withdrawal happens exactly once
        INV-002: legionFee + referrerFee + projectAmount == totalRaisedCapital
        INV-003: No modifications to sale parameters permitted after capital withdrawal
        INV-004: Capital can only be withdrawn after publication (post-refund period)
    end note
