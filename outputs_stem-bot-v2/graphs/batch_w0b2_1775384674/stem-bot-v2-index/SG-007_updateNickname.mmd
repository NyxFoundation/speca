---
title: "updateNickname (stem-bot-v2: src/api/nickname.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: discord_uid, name = req.body
    q_validate --> q_err_input: !discord_uid or !name
    q_validate --> q_fetch_member: getMember(discord_uid)
    q_err_input --> [*]: res.status(400)
    q_fetch_member --> q_err_member: member is null
    q_fetch_member --> q_fetch_db: supabase.from(members).eq(discord_uid)
    q_err_member --> [*]: res.status(404)
    q_fetch_db --> q_err_db: memberError or !memberData
    q_fetch_db --> q_check_status: memberData loaded
    q_err_db --> [*]: res.status(404)

    q_check_status --> q_format_active: status === 0 or status === 1
    q_check_status --> q_format_ob: status === 2
    q_check_status --> q_err_status: other status
    q_err_status --> [*]: res.status(400) Invalid member status

    q_format_active --> q_err_no_student: !memberData.student_number
    q_format_active --> q_set_nick_active: student_number exists
    q_err_no_student --> [*]: res.status(400)
    q_set_nick_active --> q_discord_set: nickname = name + (student_number)
    q_format_ob --> q_discord_set: nickname = name + (generation期卒業生)

    q_discord_set --> q_err_discord: setNickname failed
    q_discord_set --> q_respond: setNickname succeeded
    q_err_discord --> [*]: res.status(500)
    q_respond --> [*]: res.json(success, name, updated_nickname)

    note right of q_validate
        INV-001: name parameter is not length-validated (Discord limit is 32 chars)
        INV-002: name is not sanitized - arbitrary Unicode/special chars accepted
        INV-003: Any authenticated caller can update any members nickname (no ownership check)
    end note

    note right of q_discord_set
        INV-004: Nickname format embeds student_number which is PII
    end note
