---
title: "getNickname (stem-bot-v2: src/api/nickname.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: discord_uid = req.query.discord_uid
    q_validate --> q_err_input: !discord_uid
    q_validate --> q_fetch_member: getMember(discord_uid)
    q_err_input --> [*]: res.status(400)
    q_fetch_member --> q_err_member: member is null
    q_fetch_member --> q_extract: member found
    q_err_member --> [*]: res.status(404)
    q_extract --> q_parse_name: fullNickname = member.nickname or member.user.username
    q_parse_name --> q_respond: nameOnly = fullNickname.replace(parenthetical suffix)
    q_respond --> [*]: res.json(discord_uid, full_nickname, name_only)

    note right of q_validate
        INV-001: discord_uid from query string is not validated/sanitized
        INV-002: Any authenticated user can query any members nickname
    end note
