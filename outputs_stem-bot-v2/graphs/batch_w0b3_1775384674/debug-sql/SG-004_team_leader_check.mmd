stateDiagram-v2
    direction TB
    [*] --> q_input: discord_uid = input_value
    q_input --> q_lookup_member: SELECT FROM member.members WHERE discord_uid = input_value
    q_lookup_member --> q_join_leaders: LEFT JOIN member.team_leaders ON supabase_auth_user_id = member_id
    q_join_leaders --> q_join_team: LEFT JOIN member.teams ON team_id = id
    q_join_team --> q_check_leader: tl.member_id IS NOT NULL?
    q_check_leader --> q_is_leader: true
    q_check_leader --> q_not_leader: false
    q_is_leader --> [*]: return (discord_uid, team_name, status=leader)
    q_not_leader --> [*]: return (discord_uid, NULL, status=not_leader)

    note right of q_check_leader
        INV-001: A member can be leader of at most one team per team_leaders row
        INV-002: team_leaders.member_id must reference existing member
        INV-003: team_leaders.team_id must reference existing team
    end note
