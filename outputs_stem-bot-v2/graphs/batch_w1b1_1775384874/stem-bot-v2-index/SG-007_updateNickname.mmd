---
title: "updateNickname (stem-bot-v2: src/api/nickname.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: discord_uid, name = req.body
    q_validate --> q_400_missing: !discord_uid or !name
    q_validate --> q_get_member: both provided
    q_400_missing --> [*]: res.status(400)
    q_get_member --> q_404_discord: member = null
    q_get_member --> q_fetch_db: member found
    q_404_discord --> [*]: res.status(404) "Discord member not found"
    q_fetch_db --> q_404_db: memberData = null
    q_fetch_db --> q_check_status: memberData found
    q_404_db --> [*]: res.status(404) "Member not found in database"
    q_check_status --> q_format_active: status === 0 or status === 1
    q_check_status --> q_format_grad: status === 2
    q_check_status --> q_400_status: other status
    q_format_active --> q_400_no_student: !memberData.student_number
    q_format_active --> q_set_nick_active: student_number exists
    q_400_no_student --> [*]: res.status(400) "Student number missing"
    q_400_status --> [*]: res.status(400) "Invalid member status"
    q_set_nick_active --> q_set_discord: nickname = name + "(" + student_number + ")"
    q_format_grad --> q_set_discord: nickname = name + "(" + generation + "期卒業生)"
    q_set_discord --> q_500_discord: setNickname failed
    q_set_discord --> q_respond: setNickname success
    q_500_discord --> [*]: res.status(500)
    q_respond --> [*]: res.json(success, name, updated_nickname)

    note right of q_validate
        INV-001: name input is not sanitized or length-validated
        INV-002: Any authenticated caller can update any member nickname (no ownership check)
        INV-003: Nickname format depends on status (active vs graduated)
        INV-004: student_number required for active members
    end note
