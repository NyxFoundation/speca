---
title: "getNickname (stem-bot-v2: src/api/nickname.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: discord_uid = req.query.discord_uid
    q_validate --> q_400: !discord_uid
    q_validate --> q_get_member: discord_uid provided
    q_400 --> [*]: res.status(400)
    q_get_member --> q_404: member = null
    q_get_member --> q_extract: member found
    q_404 --> [*]: res.status(404)
    q_extract --> q_parse: fullNickname = member.nickname or member.user.username
    q_parse --> q_respond: nameOnly = fullNickname.replace(/\([^)]*\)$/, "").trim()
    q_respond --> [*]: res.json(discord_uid, full_nickname, name_only)

    note right of q_extract
        INV-001: discord_uid is from query string, not validated against auth context
        INV-002: Any authenticated caller can query any member nickname
    end note
