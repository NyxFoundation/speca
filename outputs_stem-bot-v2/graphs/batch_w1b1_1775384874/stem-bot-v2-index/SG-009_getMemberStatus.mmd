---
title: "getMemberStatus (stem-bot-v2: src/api/memberStatus.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: discord_uid = req.query.discord_uid
    q_validate --> q_400: !discord_uid
    q_validate --> q_get_member: discord_uid provided
    q_400 --> [*]: res.status(400)
    q_get_member --> q_not_found: member = null
    q_get_member --> q_found: member found
    q_not_found --> [*]: res.json(is_in_server = false)
    q_found --> q_collect: nickname = member.nickname or username
    q_collect --> q_respond: roles = member.roles excluding "@everyone"
    q_respond --> [*]: res.json(discord_uid, is_in_server, nickname, roles)

    note right of q_get_member
        INV-001: Returns member presence and roles for any discord_uid
        INV-002: No ownership check - any authenticated caller can query any member
    end note
