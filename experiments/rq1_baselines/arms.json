{
  "_comment": "RQ1 controlled baselines (issue #102). Each arm varies ONLY the property front-end; phase 04 review is constant. See README.md. NOT YET EXECUTED -- needs config.py wiring + a queue builder + a smoke test.",
  "defaults": {
    "model": "sonnet",
    "runs": 3,
    "review_phase": "04",
    "review_prompt": "prompts/04_review_worker.md",
    "hold_constant": ["model", "target_info", "bug_bounty_scope", "review_phase", "workers", "budget_per_arm"]
  },
  "output_schema": {
    "_note": "All arms emit the Phase 03 contract so phase 04 consumes them identically.",
    "shape": {"metadata": {"arm": "<arm id>"}, "audit_items": ["property_id", "classification", "code_path", "proof_trace", "attack_scenario", "checklist_id"]},
    "surrogate_ids": "arms A/B have no property; use property_id 'armA-<NNN>'/'armB-<NNN>', checklist_id = property_id"
  },
  "arms": [
    {
      "id": "A_code_only",
      "label": "code-only-LLM",
      "phases": ["03_codeonly", "04"],
      "audit_prompt": "experiments/rq1_baselines/prompts/audit_code_only.md",
      "gives_spec": false,
      "gives_typed_properties": false
    },
    {
      "id": "B_spec_only",
      "label": "spec-only-no-properties",
      "phases": ["01a", "01b", "03_spec_only", "04"],
      "audit_prompt": "experiments/rq1_baselines/prompts/audit_spec_only.md",
      "gives_spec": true,
      "gives_typed_properties": false
    },
    {
      "id": "C_speca_full",
      "label": "SPECA full",
      "phases": ["01a", "01b", "01e", "02c", "03", "04"],
      "audit_prompt": "prompts/03_auditmap_worker_inline.md",
      "gives_spec": true,
      "gives_typed_properties": true
    }
  ],
  "weak_model_ablation": {
    "enabled_after_primary": true,
    "model": "REPLACE_WITH_WEAKER_MODEL",
    "note": "B(5): re-run all arms; a persisting C-minus-A gap refutes 'just a strong LLM.'"
  },
  "scoring": {
    "denominator_source": "issue #107 population-mapping table (72->19->15 map)",
    "primary_metric": "recall on the 15 in-scope H/M/L, per arm, per severity",
    "also": "property-only-recoverable set = (B|C) minus A"
  }
}
