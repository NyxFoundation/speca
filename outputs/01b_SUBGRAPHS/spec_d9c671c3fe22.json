      "id": "AMB-ARITH-01",
      "type": "Lexical",
      "text": "The specification uses 'wrapping_add' and 'wrapping_sub' without defining these precisely.",
      "resolution_strategy": "Assume wrapping operations are standard modular arithmetic: wrapping_add(a, b) = (a + b) mod 2^256, wrapping_sub(a, b) = (a - b + 2^256) mod 2^256."
    },
    {
      "id": "AMB-ARITH-02",
      "type": "Semantic",
      "text": "The SMOD specification states 'get_sign(x) * (abs(x) % abs(y))' but sign function behavior for zero is not specified.",
      "resolution_strategy": "Assume get_sign(0) = 0, so 0 SMOD y = 0 for any non-zero y."
    },
    {
      "id": "AMB-ARITH-03",
      "type": "Omission",
      "text": "The specification doesn't explicitly state the gas costs GAS_VERY_LOW, GAS_LOW, GAS_MID values.",
      "resolution_strategy": "Assume standard EVM gas costs: GAS_VERY_LOW = 3, GAS_LOW = 5, GAS_MID = 8."
    }
