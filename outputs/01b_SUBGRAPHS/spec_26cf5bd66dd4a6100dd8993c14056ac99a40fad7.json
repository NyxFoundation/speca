{
  "source_url": "https://ethereum.github.io/execution-specs/src/ethereum/forks/prague/vm/instructions/control_flow.py.html",
  "worker_id": 2,
  "sub_graphs": [
    {
      "id": "SUBGRAPH-PRAGUE-CONTROL-JUMP",
      "aspect": "state_transition",
      "title": "Prague EVM Control Flow: Jump Operations",
      "description": "Models the JUMP and JUMPI opcodes with destination validation",
      "nodes": [
        {
          "id": "STATE-STACK-READY-JUMP",
          "label": "Stack Ready for JUMP",
          "type": "State",
          "description": "Stack has at least 1 element for JUMP destination"
        },
        {
          "id": "ACTION-POP-JUMP-DEST",
          "label": "Pop Jump Destination",
          "type": "Action",
          "description": "Pops destination address from stack"
        },
        {
          "id": "ACTION-CHARGE-GAS-MID-JUMP",
          "label": "Charge GAS_MID",
          "type": "Action",
          "description": "Deducts GAS_MID (8 gas) for JUMP"
        },
        {
          "id": "ACTION-VALIDATE-JUMP-DEST",
          "label": "Validate Jump Destination",
          "type": "Action",
          "description": "Checks destination exists in evm.valid_jump_destinations"
        },
        {
          "id": "STATE-JUMP-DEST-VALID",
          "label": "Jump Destination Valid",
          "type": "State",
          "description": "Destination is a valid JUMPDEST location"
        },
        {
          "id": "STATE-JUMP-DEST-INVALID",
          "label": "Jump Destination Invalid",
          "type": "State",
          "description": "Destination is not a valid JUMPDEST, raises InvalidJumpDestError"
        },
        {
          "id": "ACTION-SET-PC-JUMP",
          "label": "Set Program Counter",
          "type": "Action",
          "description": "Sets evm.pc = Uint(jump_dest)"
        },
        {
          "id": "STATE-JUMP-COMPLETE",
          "label": "JUMP Complete",
          "type": "State",
          "description": "Program counter updated to new destination"
        }
      ],
      "edges": [
        {
          "id": "EDGE-POP-DEST",
          "source": "STATE-STACK-READY-JUMP",
          "target": "ACTION-POP-JUMP-DEST",
          "label": "Pop destination"
        },
        {
          "id": "EDGE-CHARGE-JUMP-GAS",
          "source": "ACTION-POP-JUMP-DEST",
          "target": "ACTION-CHARGE-GAS-MID-JUMP",
          "label": "Charge gas"
        },
        {
          "id": "EDGE-VALIDATE-DEST",
          "source": "ACTION-CHARGE-GAS-MID-JUMP",
          "target": "ACTION-VALIDATE-JUMP-DEST",
          "label": "Validate destination"
        },
        {
          "id": "EDGE-DEST-VALID",
          "source": "ACTION-VALIDATE-JUMP-DEST",
          "target": "STATE-JUMP-DEST-VALID",
          "label": "In valid_jump_destinations"
        },
        {
          "id": "EDGE-DEST-INVALID",
          "source": "ACTION-VALIDATE-JUMP-DEST",
          "target": "STATE-JUMP-DEST-INVALID",
          "label": "Not in valid_jump_destinations"
        },
        {
          "id": "EDGE-SET-PC",
          "source": "STATE-JUMP-DEST-VALID",
          "target": "ACTION-SET-PC-JUMP",
          "label": "Update PC"
        },
        {
          "id": "EDGE-JUMP-DONE",
          "source": "ACTION-SET-PC-JUMP",
          "target": "STATE-JUMP-COMPLETE",
          "label": "Jump executed"
        }
      ],
      "external_entities": []
    },
    {
      "id": "SUBGRAPH-PRAGUE-CONTROL-JUMPI",
      "aspect": "state_transition",
      "title": "Prague EVM Control Flow: Conditional Jump",
      "description": "Models the JUMPI opcode with condition evaluation and destination validation",
      "nodes": [
        {
          "id": "STATE-STACK-READY-JUMPI",
          "label": "Stack Ready for JUMPI",
          "type": "State",
          "description": "Stack has destination and condition for JUMPI"
        },
        {
          "id": "ACTION-POP-JUMPI-OPERANDS",
          "label": "Pop Destination and Condition",
          "type": "Action",
          "description": "Pops jump destination and conditional value from stack"
        },
        {
          "id": "ACTION-CHARGE-GAS-HIGH",
          "label": "Charge GAS_HIGH",
          "type": "Action",
          "description": "Deducts GAS_HIGH (10 gas) for JUMPI"
        },
        {
          "id": "ACTION-EVAL-CONDITION",
          "label": "Evaluate Condition",
          "type": "Action",
          "description": "Checks if conditional_value == 0"
        },
        {
          "id": "STATE-CONDITION-FALSE",
          "label": "Condition is False",
          "type": "State",
          "description": "conditional_value == 0, do not jump"
        },
        {
          "id": "STATE-CONDITION-TRUE",
          "label": "Condition is True",
          "type": "State",
          "description": "conditional_value != 0, attempt jump"
        },
        {
          "id": "ACTION-VALIDATE-JUMPI-DEST",
          "label": "Validate JUMPI Destination",
          "type": "Action",
          "description": "Checks destination in valid_jump_destinations"
        },
        {
          "id": "STATE-JUMPI-DEST-VALID",
          "label": "JUMPI Destination Valid",
          "type": "State",
          "description": "Conditional jump destination is valid"
        },
        {
          "id": "STATE-JUMPI-DEST-INVALID",
          "label": "JUMPI Destination Invalid",
          "type": "State",
          "description": "Conditional jump destination invalid, raises InvalidJumpDestError"
        },
        {
          "id": "ACTION-INCREMENT-PC-JUMPI",
          "label": "Increment PC by 1",
          "type": "Action",
          "description": "Advances PC normally when condition is false"
        },
        {
          "id": "ACTION-SET-PC-JUMPI",
          "label": "Set PC to Destination",
          "type": "Action",
          "description": "Sets evm.pc = destination when condition is true"
        },
        {
          "id": "STATE-JUMPI-COMPLETE",
          "label": "JUMPI Complete",
          "type": "State",
          "description": "Conditional jump resolved"
        }
      ],
      "edges": [
        {
          "id": "EDGE-POP-JUMPI",
          "source": "STATE-STACK-READY-JUMPI",
          "target": "ACTION-POP-JUMPI-OPERANDS",
          "label": "Pop operands"
        },
        {
          "id": "EDGE-CHARGE-HIGH",
          "source": "ACTION-POP-JUMPI-OPERANDS",
          "target": "ACTION-CHARGE-GAS-HIGH",
          "label": "Charge gas"
        },
        {
          "id": "EDGE-EVAL-COND",
          "source": "ACTION-CHARGE-GAS-HIGH",
          "target": "ACTION-EVAL-CONDITION",
          "label": "Evaluate condition"
        },
        {
          "id": "EDGE-COND-FALSE",
          "source": "ACTION-EVAL-CONDITION",
          "target": "STATE-CONDITION-FALSE",
          "label": "value == 0"
        },
        {
          "id": "EDGE-COND-TRUE",
          "source": "ACTION-EVAL-CONDITION",
          "target": "STATE-CONDITION-TRUE",
          "label": "value != 0"
        },
        {
          "id": "EDGE-NO-JUMP",
          "source": "STATE-CONDITION-FALSE",
          "target": "ACTION-INCREMENT-PC-JUMPI",
          "label": "Continue normally"
        },
        {
          "id": "EDGE-ATTEMPT-JUMP",
          "source": "STATE-CONDITION-TRUE",
          "target": "ACTION-VALIDATE-JUMPI-DEST",
          "label": "Validate destination"
        },
        {
          "id": "EDGE-JUMPI-VALID",
          "source": "ACTION-VALIDATE-JUMPI-DEST",
          "target": "STATE-JUMPI-DEST-VALID",
          "label": "Valid destination"
        },
        {
          "id": "EDGE-JUMPI-INVALID",
          "source": "ACTION-VALIDATE-JUMPI-DEST",
          "target": "STATE-JUMPI-DEST-INVALID",
          "label": "Invalid destination"
        },
        {
          "id": "EDGE-DO-JUMPI",
          "source": "STATE-JUMPI-DEST-VALID",
          "target": "ACTION-SET-PC-JUMPI",
          "label": "Perform jump"
        },
        {
          "id": "EDGE-JUMPI-INC-DONE",
          "source": "ACTION-INCREMENT-PC-JUMPI",
          "target": "STATE-JUMPI-COMPLETE",
          "label": "PC incremented"
        },
        {
          "id": "EDGE-JUMPI-SET-DONE",
          "source": "ACTION-SET-PC-JUMPI",
          "target": "STATE-JUMPI-COMPLETE",
          "label": "PC set"
        }
      ],
      "external_entities": []
    },
    {
      "id": "SUBGRAPH-PRAGUE-CONTROL-HALT",
      "aspect": "state_transition",
      "title": "Prague EVM Control Flow: Halt Operations",
      "description": "Models the STOP opcode and execution termination",
      "nodes": [
        {
          "id": "STATE-EVM-EXECUTING",
          "label": "EVM Executing",
          "type": "State",
          "description": "EVM is running and encounters STOP opcode"
        },
        {
          "id": "ACTION-EXECUTE-STOP",
          "label": "Execute STOP",
          "type": "Action",
          "description": "Processes STOP opcode (0x00)"
        },
        {
          "id": "ACTION-SET-RUNNING-FALSE",
          "label": "Set Running to False",
          "type": "Action",
          "description": "Sets evm.running = False"
        },
        {
          "id": "ACTION-INCREMENT-PC-STOP",
          "label": "Increment PC",
          "type": "Action",
          "description": "Advances evm.pc by 1 (though execution will halt)"
        },
        {
          "id": "STATE-EVM-STOPPED",
          "label": "EVM Stopped",
          "type": "State",
          "description": "EVM execution has been halted normally"
        }
      ],
      "edges": [
        {
          "id": "EDGE-STOP-DETECTED",
          "source": "STATE-EVM-EXECUTING",
          "target": "ACTION-EXECUTE-STOP",
          "label": "STOP opcode"
        },
        {
          "id": "EDGE-SET-FALSE",
          "source": "ACTION-EXECUTE-STOP",
          "target": "ACTION-SET-RUNNING-FALSE",
          "label": "Halt execution"
        },
        {
          "id": "EDGE-INC-PC-STOP",
          "source": "ACTION-SET-RUNNING-FALSE",
          "target": "ACTION-INCREMENT-PC-STOP",
          "label": "Increment PC"
        },
        {
          "id": "EDGE-STOPPED",
          "source": "ACTION-INCREMENT-PC-STOP",
          "target": "STATE-EVM-STOPPED",
          "label": "EVM halted"
        }
      ],
      "external_entities": []
    },
    {
      "id": "SUBGRAPH-PRAGUE-CONTROL-INFO",
      "aspect": "state_transition",
      "title": "Prague EVM Control Flow: Information Opcodes",
      "description": "Models PC and GAS opcodes that provide execution context information",
      "nodes": [
        {
          "id": "STATE-EVM-RUNNING-INFO",
          "label": "EVM Running",
          "type": "State",
          "description": "EVM is executing and encounters PC or GAS opcode"
        },
        {
          "id": "ACTION-EXECUTE-PC",
          "label": "Execute PC Opcode",
          "type": "Action",
          "description": "Processes PC opcode (0x58)"
        },
        {
          "id": "ACTION-CHARGE-GAS-BASE",
          "label": "Charge GAS_BASE",
          "type": "Action",
          "description": "Deducts GAS_BASE (2 gas) for PC/GAS opcodes"
        },
        {
          "id": "ACTION-PUSH-CURRENT-PC",
          "label": "Push Current PC",
          "type": "Action",
          "description": "Pushes U256(evm.pc) to stack"
        },
        {
          "id": "ACTION-EXECUTE-GAS-OP",
          "label": "Execute GAS Opcode",
          "type": "Action",
          "description": "Processes GAS opcode (0x5a)"
        },
        {
          "id": "ACTION-PUSH-GAS-LEFT",
          "label": "Push Remaining Gas",
          "type": "Action",
          "description": "Pushes U256(evm.gas_left) to stack (after charging)"
        },
        {
          "id": "ACTION-INCREMENT-PC-INFO",
          "label": "Increment PC",
          "type": "Action",
          "description": "Advances evm.pc by 1"
        },
        {
          "id": "STATE-INFO-OP-COMPLETE",
          "label": "Information Opcode Complete",
          "type": "State",
          "description": "PC or GAS opcode finished"
        }
      ],
      "edges": [
        {
          "id": "EDGE-PC-OP",
          "source": "STATE-EVM-RUNNING-INFO",
          "target": "ACTION-EXECUTE-PC",
          "label": "PC opcode"
        },
        {
          "id": "EDGE-GAS-OP",
          "source": "STATE-EVM-RUNNING-INFO",
          "target": "ACTION-EXECUTE-GAS-OP",
          "label": "GAS opcode"
        },
        {
          "id": "EDGE-CHARGE-PC",
          "source": "ACTION-EXECUTE-PC",
          "target": "ACTION-CHARGE-GAS-BASE",
          "label": "Charge gas"
        },
        {
          "id": "EDGE-CHARGE-GAS-OP",
          "source": "ACTION-EXECUTE-GAS-OP",
          "target": "ACTION-CHARGE-GAS-BASE",
          "label": "Charge gas"
        },
        {
          "id": "EDGE-PUSH-PC",
          "source": "ACTION-CHARGE-GAS-BASE",
          "target": "ACTION-PUSH-CURRENT-PC",
          "label": "Push PC value"
        },
        {
          "id": "EDGE-PUSH-GAS",
          "source": "ACTION-CHARGE-GAS-BASE",
          "target": "ACTION-PUSH-GAS-LEFT",
          "label": "Push gas value"
        },
        {
          "id": "EDGE-INC-PC-FROM-PC",
          "source": "ACTION-PUSH-CURRENT-PC",
          "target": "ACTION-INCREMENT-PC-INFO",
          "label": "Increment PC"
        },
        {
          "id": "EDGE-INC-PC-FROM-GAS",
          "source": "ACTION-PUSH-GAS-LEFT",
          "target": "ACTION-INCREMENT-PC-INFO",
          "label": "Increment PC"
        },
        {
          "id": "EDGE-INFO-DONE",
          "source": "ACTION-INCREMENT-PC-INFO",
          "target": "STATE-INFO-OP-COMPLETE",
          "label": "Complete"
        }
      ],
      "external_entities": []
    },
    {
      "id": "SUBGRAPH-PRAGUE-CONTROL-SECURITY",
      "aspect": "security_boundary",
      "title": "Prague EVM Control Flow: Jump Destination Validation",
      "description": "Models the security mechanism that validates jump destinations against a whitelist",
      "nodes": [
        {
          "id": "STATE-CONTRACT-LOADED",
          "label": "Contract Code Loaded",
          "type": "State",
          "description": "Contract bytecode has been loaded for execution"
        },
        {
          "id": "ACTION-SCAN-JUMPDESTS",
          "label": "Scan for JUMPDEST Opcodes",
          "type": "Action",
          "description": "Pre-computes set of valid jump destinations in bytecode"
        },
        {
          "id": "ACTION-BUILD-WHITELIST",
          "label": "Build Valid Destinations Set",
          "type": "Action",
          "description": "Creates evm.valid_jump_destinations set"
        },
        {
          "id": "STATE-WHITELIST-READY",
          "label": "Jump Whitelist Ready",
          "type": "State",
          "description": "valid_jump_destinations is populated and ready"
        },
        {
          "id": "ACTION-EXECUTE-JUMPDEST",
          "label": "Execute JUMPDEST Opcode",
          "type": "Action",
          "description": "Processes JUMPDEST (0x5b) - marks valid landing point"
        },
        {
          "id": "ACTION-CHARGE-JUMPDEST-GAS",
          "label": "Charge GAS_JUMPDEST",
          "type": "Action",
          "description": "Deducts GAS_JUMPDEST (1 gas) for JUMPDEST"
        },
        {
          "id": "STATE-JUMPDEST-EXECUTED",
          "label": "JUMPDEST Executed",
          "type": "State",
          "description": "JUMPDEST marker processed (no-op for execution)"
        },
        {
          "id": "STATE-INVALID-JUMP-ERROR",
          "label": "Invalid Jump Error",
          "type": "State",
          "description": "Jump attempted to address not in whitelist"
        }
      ],
      "edges": [
        {
          "id": "EDGE-SCAN-CODE",
          "source": "STATE-CONTRACT-LOADED",
          "target": "ACTION-SCAN-JUMPDESTS",
          "label": "Scan bytecode"
        },
        {
          "id": "EDGE-BUILD-SET",
          "source": "ACTION-SCAN-JUMPDESTS",
          "target": "ACTION-BUILD-WHITELIST",
          "label": "Build set"
        },
        {
          "id": "EDGE-WHITELIST-DONE",
          "source": "ACTION-BUILD-WHITELIST",
          "target": "STATE-WHITELIST-READY",
          "label": "Whitelist ready"
        },
        {
          "id": "EDGE-EXEC-JUMPDEST",
          "source": "STATE-WHITELIST-READY",
          "target": "ACTION-EXECUTE-JUMPDEST",
          "label": "Encounter JUMPDEST"
        },
        {
          "id": "EDGE-CHARGE-JUMPDEST",
          "source": "ACTION-EXECUTE-JUMPDEST",
          "target": "ACTION-CHARGE-JUMPDEST-GAS",
          "label": "Charge gas"
        },
        {
          "id": "EDGE-JUMPDEST-DONE",
          "source": "ACTION-CHARGE-JUMPDEST-GAS",
          "target": "STATE-JUMPDEST-EXECUTED",
          "label": "No-op complete"
        },
        {
          "id": "EDGE-INVALID-JUMP",
          "source": "STATE-WHITELIST-READY",
          "target": "STATE-INVALID-JUMP-ERROR",
          "label": "Jump to non-JUMPDEST"
        }
      ],
      "external_entities": [
        {
          "id": "EXT-CONTRACT-DEPLOYER",
          "name": "Contract Deployer",
          "description": "Entity that deployed the contract with JUMPDEST markers"
        }
      ]
    }
  ],
  "ambiguities": [
    {
      "id": "AMB-PRAGUE-CONTROL-01",
      "type": "Omission",
      "text": "The exact values of GAS_MID, GAS_HIGH, GAS_BASE, and GAS_JUMPDEST are not specified in this document",
      "resolution_strategy": "Assume standard EVM gas costs: GAS_MID=8, GAS_HIGH=10, GAS_BASE=2, GAS_JUMPDEST=1."
    },
    {
      "id": "AMB-PRAGUE-CONTROL-02",
      "type": "Semantic",
      "text": "The behavior when GAS opcode gas_left value differs between charging time and push time is not explicit",
      "resolution_strategy": "Assume gas_left pushed reflects value AFTER charging GAS_BASE, showing remaining gas at that moment."
    }
  ],
  "implicit_assumptions": [
    {
      "id": "ASSUM-PRAGUE-CONTROL-01",
      "type": "Trust",
      "description": "The valid_jump_destinations set is correctly computed from bytecode analysis before execution begins",
      "impact_if_false": "Jump validation could allow jumps to invalid locations, enabling arbitrary code execution"
    },
    {
      "id": "ASSUM-PRAGUE-CONTROL-02",
      "type": "Environmental",
      "description": "JUMPDEST scanning correctly skips over PUSH data bytes to avoid false positives",
      "impact_if_false": "Data bytes containing 0x5b could be incorrectly marked as valid jump destinations"
    },
    {
      "id": "ASSUM-PRAGUE-CONTROL-03",
      "type": "Attacker Capability",
      "description": "Attackers cannot create valid jump destinations at arbitrary addresses through data manipulation",
      "impact_if_false": "Control flow hijacking could occur by jumping to attacker-controlled data"
    },
    {
      "id": "ASSUM-PRAGUE-CONTROL-04",
      "type": "Operational",
      "description": "The InvalidJumpDestError properly halts execution and consumes all gas",
      "impact_if_false": "Invalid jumps might not properly fail-stop, causing undefined behavior"
    }
  ]
}
