{
  "source_url": "https://ethereum.github.io/execution-specs/src/ethereum/forks/cancun/vm/instructions/bitwise.py.html",
  "worker_id": 3,
  "sub_graphs": [
    {
      "id": "SUBGRAPH-CANCUN-BITWISE-LOGIC",
      "aspect": "state_transition",
      "title": "Cancun VM: Bitwise Logic Operations",
      "description": "Models the bitwise AND, OR, XOR, and NOT operations in the EVM",
      "nodes": [
        {
          "id": "STATE-BITWISE-OP-READY",
          "label": "Bitwise Operation Ready",
          "type": "State",
          "description": "EVM fetched bitwise opcode, stack has required operands"
        },
        {
          "id": "ACTION-POP-TWO-OPERANDS",
          "label": "Pop Two Operands",
          "type": "Action",
          "description": "Pop two 256-bit values from stack for binary operation"
        },
        {
          "id": "ACTION-POP-ONE-OPERAND",
          "label": "Pop One Operand",
          "type": "Action",
          "description": "Pop single 256-bit value from stack for NOT operation"
        },
        {
          "id": "STATE-OPERANDS-LOADED",
          "label": "Operands Loaded",
          "type": "State",
          "description": "Stack operands loaded into working registers"
        },
        {
          "id": "ACTION-COMPUTE-AND",
          "label": "Compute Bitwise AND",
          "type": "Action",
          "description": "Perform bitwise AND (&) on two operands"
        },
        {
          "id": "ACTION-COMPUTE-OR",
          "label": "Compute Bitwise OR",
          "type": "Action",
          "description": "Perform bitwise OR (|) on two operands"
        },
        {
          "id": "ACTION-COMPUTE-XOR",
          "label": "Compute Bitwise XOR",
          "type": "Action",
          "description": "Perform bitwise XOR (^) on two operands"
        },
        {
          "id": "ACTION-COMPUTE-NOT",
          "label": "Compute Bitwise NOT",
          "type": "Action",
          "description": "Perform bitwise complement (~) on single operand"
        },
        {
          "id": "STATE-RESULT-COMPUTED",
          "label": "Result Computed",
          "type": "State",
          "description": "Bitwise operation result available"
        },
        {
          "id": "ACTION-PUSH-RESULT",
          "label": "Push Result to Stack",
          "type": "Action",
          "description": "Push computed result onto EVM stack"
        },
        {
          "id": "ACTION-CHARGE-GAS",
          "label": "Charge GAS_VERY_LOW",
          "type": "Action",
          "description": "Deduct GAS_VERY_LOW (3 gas) for bitwise operation"
        },
        {
          "id": "ACTION-INCREMENT-PC",
          "label": "Increment Program Counter",
          "type": "Action",
          "description": "Advance program counter by 1"
        },
        {
          "id": "STATE-INSTRUCTION-COMPLETE",
          "label": "Instruction Complete",
          "type": "State",
          "description": "Bitwise instruction fully executed"
        }
      ],
      "edges": [
        {
          "id": "EDGE-POP-BINARY",
          "source": "STATE-BITWISE-OP-READY",
          "target": "ACTION-POP-TWO-OPERANDS",
          "label": "AND/OR/XOR requires two values"
        },
        {
          "id": "EDGE-POP-UNARY",
          "source": "STATE-BITWISE-OP-READY",
          "target": "ACTION-POP-ONE-OPERAND",
          "label": "NOT requires one value"
        },
        {
          "id": "EDGE-BINARY-LOADED",
          "source": "ACTION-POP-TWO-OPERANDS",
          "target": "STATE-OPERANDS-LOADED",
          "label": "Two operands ready"
        },
        {
          "id": "EDGE-UNARY-LOADED",
          "source": "ACTION-POP-ONE-OPERAND",
          "target": "STATE-OPERANDS-LOADED",
          "label": "One operand ready"
        },
        {
          "id": "EDGE-DO-AND",
          "source": "STATE-OPERANDS-LOADED",
          "target": "ACTION-COMPUTE-AND",
          "label": "Opcode is AND (0x16)"
        },
        {
          "id": "EDGE-DO-OR",
          "source": "STATE-OPERANDS-LOADED",
          "target": "ACTION-COMPUTE-OR",
          "label": "Opcode is OR (0x17)"
        },
        {
          "id": "EDGE-DO-XOR",
          "source": "STATE-OPERANDS-LOADED",
          "target": "ACTION-COMPUTE-XOR",
          "label": "Opcode is XOR (0x18)"
        },
        {
          "id": "EDGE-DO-NOT",
          "source": "STATE-OPERANDS-LOADED",
          "target": "ACTION-COMPUTE-NOT",
          "label": "Opcode is NOT (0x19)"
        },
        {
          "id": "EDGE-AND-RESULT",
          "source": "ACTION-COMPUTE-AND",
          "target": "STATE-RESULT-COMPUTED",
          "label": "AND result ready"
        },
        {
          "id": "EDGE-OR-RESULT",
          "source": "ACTION-COMPUTE-OR",
          "target": "STATE-RESULT-COMPUTED",
          "label": "OR result ready"
        },
        {
          "id": "EDGE-XOR-RESULT",
          "source": "ACTION-COMPUTE-XOR",
          "target": "STATE-RESULT-COMPUTED",
          "label": "XOR result ready"
        },
        {
          "id": "EDGE-NOT-RESULT",
          "source": "ACTION-COMPUTE-NOT",
          "target": "STATE-RESULT-COMPUTED",
          "label": "NOT result ready"
        },
        {
          "id": "EDGE-PUSH",
          "source": "STATE-RESULT-COMPUTED",
          "target": "ACTION-PUSH-RESULT",
          "label": "Put result on stack"
        },
        {
          "id": "EDGE-GAS",
          "source": "ACTION-PUSH-RESULT",
          "target": "ACTION-CHARGE-GAS",
          "label": "Deduct gas cost"
        },
        {
          "id": "EDGE-INC-PC",
          "source": "ACTION-CHARGE-GAS",
          "target": "ACTION-INCREMENT-PC",
          "label": "Advance to next instruction"
        },
        {
          "id": "EDGE-DONE",
          "source": "ACTION-INCREMENT-PC",
          "target": "STATE-INSTRUCTION-COMPLETE",
          "label": "Instruction finished"
        }
      ],
      "external_entities": []
    },
    {
      "id": "SUBGRAPH-CANCUN-BYTE-EXTRACTION",
      "aspect": "state_transition",
      "title": "Cancun VM: BYTE Extraction Operation",
      "description": "Models the BYTE opcode for extracting individual bytes from 256-bit words",
      "nodes": [
        {
          "id": "STATE-BYTE-OP-READY",
          "label": "BYTE Operation Ready",
          "type": "State",
          "description": "EVM fetched BYTE opcode (0x1A), stack has index and word"
        },
        {
          "id": "ACTION-POP-INDEX-AND-WORD",
          "label": "Pop Index and Word",
          "type": "Action",
          "description": "Pop byte index (i) and 256-bit word (x) from stack"
        },
        {
          "id": "STATE-BYTE-PARAMS-LOADED",
          "label": "BYTE Parameters Loaded",
          "type": "State",
          "description": "Index and word values available for extraction"
        },
        {
          "id": "ACTION-CHECK-INDEX-BOUNDS",
          "label": "Check Index Bounds",
          "type": "Action",
          "description": "Verify if index < 32 (within 256-bit word)"
        },
        {
          "id": "STATE-INDEX-IN-BOUNDS",
          "label": "Index In Bounds",
          "type": "State",
          "description": "Index is 0-31, byte can be extracted"
        },
        {
          "id": "STATE-INDEX-OUT-OF-BOUNDS",
          "label": "Index Out of Bounds",
          "type": "State",
          "description": "Index >= 32, result will be 0"
        },
        {
          "id": "ACTION-EXTRACT-BYTE",
          "label": "Extract Byte",
          "type": "Action",
          "description": "Shift word right and mask to extract byte at index (big-endian, left-to-right)"
        },
        {
          "id": "ACTION-RETURN-ZERO",
          "label": "Return Zero",
          "type": "Action",
          "description": "Push 0 as result for out-of-bounds index"
        },
        {
          "id": "STATE-BYTE-RESULT-READY",
          "label": "BYTE Result Ready",
          "type": "State",
          "description": "Extracted byte (or zero) ready to push"
        },
        {
          "id": "ACTION-PUSH-BYTE-RESULT",
          "label": "Push BYTE Result",
          "type": "Action",
          "description": "Push extracted byte onto stack"
        }
      ],
      "edges": [
        {
          "id": "EDGE-POP-BYTE-PARAMS",
          "source": "STATE-BYTE-OP-READY",
          "target": "ACTION-POP-INDEX-AND-WORD",
          "label": "Get index and word from stack"
        },
        {
          "id": "EDGE-PARAMS-READY",
          "source": "ACTION-POP-INDEX-AND-WORD",
          "target": "STATE-BYTE-PARAMS-LOADED",
          "label": "Parameters available"
        },
        {
          "id": "EDGE-CHECK-BOUNDS",
          "source": "STATE-BYTE-PARAMS-LOADED",
          "target": "ACTION-CHECK-INDEX-BOUNDS",
          "label": "Verify index < 32"
        },
        {
          "id": "EDGE-IN-BOUNDS",
          "source": "ACTION-CHECK-INDEX-BOUNDS",
          "target": "STATE-INDEX-IN-BOUNDS",
          "label": "Index is 0-31"
        },
        {
          "id": "EDGE-OUT-BOUNDS",
          "source": "ACTION-CHECK-INDEX-BOUNDS",
          "target": "STATE-INDEX-OUT-OF-BOUNDS",
          "label": "Index >= 32"
        },
        {
          "id": "EDGE-DO-EXTRACT",
          "source": "STATE-INDEX-IN-BOUNDS",
          "target": "ACTION-EXTRACT-BYTE",
          "label": "Perform byte extraction"
        },
        {
          "id": "EDGE-DO-ZERO",
          "source": "STATE-INDEX-OUT-OF-BOUNDS",
          "target": "ACTION-RETURN-ZERO",
          "label": "Return zero for OOB"
        },
        {
          "id": "EDGE-EXTRACT-DONE",
          "source": "ACTION-EXTRACT-BYTE",
          "target": "STATE-BYTE-RESULT-READY",
          "label": "Byte extracted"
        },
        {
          "id": "EDGE-ZERO-DONE",
          "source": "ACTION-RETURN-ZERO",
          "target": "STATE-BYTE-RESULT-READY",
          "label": "Zero result"
        },
        {
          "id": "EDGE-PUSH-BYTE",
          "source": "STATE-BYTE-RESULT-READY",
          "target": "ACTION-PUSH-BYTE-RESULT",
          "label": "Push to stack"
        }
      ],
      "external_entities": []
    },
    {
      "id": "SUBGRAPH-CANCUN-SHIFT-OPERATIONS",
      "aspect": "state_transition",
      "title": "Cancun VM: Shift Operations (SHL, SHR, SAR)",
      "description": "Models the bit shifting operations including logical and arithmetic shifts",
      "nodes": [
        {
          "id": "STATE-SHIFT-OP-READY",
          "label": "Shift Operation Ready",
          "type": "State",
          "description": "EVM fetched shift opcode, stack has shift amount and value"
        },
        {
          "id": "ACTION-POP-SHIFT-PARAMS",
          "label": "Pop Shift Parameters",
          "type": "Action",
          "description": "Pop shift amount and value from stack"
        },
        {
          "id": "STATE-SHIFT-PARAMS-LOADED",
          "label": "Shift Parameters Loaded",
          "type": "State",
          "description": "Shift amount and value available"
        },
        {
          "id": "ACTION-CHECK-SHIFT-AMOUNT",
          "label": "Check Shift Amount",
          "type": "Action",
          "description": "Determine if shift >= 256 (would clear all bits)"
        },
        {
          "id": "STATE-SHIFT-NORMAL",
          "label": "Normal Shift Range",
          "type": "State",
          "description": "Shift amount < 256, perform actual shift"
        },
        {
          "id": "STATE-SHIFT-OVERFLOW",
          "label": "Shift Overflow",
          "type": "State",
          "description": "Shift amount >= 256, result depends on operation type"
        },
        {
          "id": "ACTION-EXECUTE-SHL",
          "label": "Execute Logical Shift Left",
          "type": "Action",
          "description": "Shift value left, mask result to MAX_VALUE (256 bits)"
        },
        {
          "id": "ACTION-EXECUTE-SHR",
          "label": "Execute Logical Shift Right",
          "type": "Action",
          "description": "Shift value right logically (zero fill)"
        },
        {
          "id": "ACTION-EXECUTE-SAR",
          "label": "Execute Arithmetic Shift Right",
          "type": "Action",
          "description": "Shift value right arithmetically (sign extend)"
        },
        {
          "id": "ACTION-RETURN-ZERO-SHIFT",
          "label": "Return Zero for Overflow",
          "type": "Action",
          "description": "Return 0 for SHL/SHR with shift >= 256"
        },
        {
          "id": "ACTION-RETURN-SAR-OVERFLOW",
          "label": "Return SAR Overflow Result",
          "type": "Action",
          "description": "Return 0 (positive) or MAX_VALUE (negative) for SAR >= 256"
        },
        {
          "id": "STATE-SHIFT-RESULT-READY",
          "label": "Shift Result Ready",
          "type": "State",
          "description": "Shift operation result computed"
        },
        {
          "id": "ACTION-PUSH-SHIFT-RESULT",
          "label": "Push Shift Result",
          "type": "Action",
          "description": "Push shift result onto stack"
        }
      ],
      "edges": [
        {
          "id": "EDGE-POP-SHIFT",
          "source": "STATE-SHIFT-OP-READY",
          "target": "ACTION-POP-SHIFT-PARAMS",
          "label": "Get shift amount and value"
        },
        {
          "id": "EDGE-SHIFT-LOADED",
          "source": "ACTION-POP-SHIFT-PARAMS",
          "target": "STATE-SHIFT-PARAMS-LOADED",
          "label": "Parameters ready"
        },
        {
          "id": "EDGE-CHECK-SHIFT",
          "source": "STATE-SHIFT-PARAMS-LOADED",
          "target": "ACTION-CHECK-SHIFT-AMOUNT",
          "label": "Check shift >= 256"
        },
        {
          "id": "EDGE-SHIFT-OK",
          "source": "ACTION-CHECK-SHIFT-AMOUNT",
          "target": "STATE-SHIFT-NORMAL",
          "label": "Shift < 256"
        },
        {
          "id": "EDGE-SHIFT-BIG",
          "source": "ACTION-CHECK-SHIFT-AMOUNT",
          "target": "STATE-SHIFT-OVERFLOW",
          "label": "Shift >= 256"
        },
        {
          "id": "EDGE-DO-SHL",
          "source": "STATE-SHIFT-NORMAL",
          "target": "ACTION-EXECUTE-SHL",
          "label": "Opcode is SHL (0x1B)"
        },
        {
          "id": "EDGE-DO-SHR",
          "source": "STATE-SHIFT-NORMAL",
          "target": "ACTION-EXECUTE-SHR",
          "label": "Opcode is SHR (0x1C)"
        },
        {
          "id": "EDGE-DO-SAR",
          "source": "STATE-SHIFT-NORMAL",
          "target": "ACTION-EXECUTE-SAR",
          "label": "Opcode is SAR (0x1D)"
        },
        {
          "id": "EDGE-OVERFLOW-ZERO",
          "source": "STATE-SHIFT-OVERFLOW",
          "target": "ACTION-RETURN-ZERO-SHIFT",
          "label": "SHL or SHR overflow"
        },
        {
          "id": "EDGE-OVERFLOW-SAR",
          "source": "STATE-SHIFT-OVERFLOW",
          "target": "ACTION-RETURN-SAR-OVERFLOW",
          "label": "SAR overflow (sign dependent)"
        },
        {
          "id": "EDGE-SHL-DONE",
          "source": "ACTION-EXECUTE-SHL",
          "target": "STATE-SHIFT-RESULT-READY",
          "label": "SHL result"
        },
        {
          "id": "EDGE-SHR-DONE",
          "source": "ACTION-EXECUTE-SHR",
          "target": "STATE-SHIFT-RESULT-READY",
          "label": "SHR result"
        },
        {
          "id": "EDGE-SAR-DONE",
          "source": "ACTION-EXECUTE-SAR",
          "target": "STATE-SHIFT-RESULT-READY",
          "label": "SAR result"
        },
        {
          "id": "EDGE-ZERO-SHIFT-DONE",
          "source": "ACTION-RETURN-ZERO-SHIFT",
          "target": "STATE-SHIFT-RESULT-READY",
          "label": "Zero result"
        },
        {
          "id": "EDGE-SAR-OVERFLOW-DONE",
          "source": "ACTION-RETURN-SAR-OVERFLOW",
          "target": "STATE-SHIFT-RESULT-READY",
          "label": "SAR overflow result"
        },
        {
          "id": "EDGE-PUSH-SHIFT",
          "source": "STATE-SHIFT-RESULT-READY",
          "target": "ACTION-PUSH-SHIFT-RESULT",
          "label": "Push to stack"
        }
      ],
      "external_entities": []
    },
    {
      "id": "SUBGRAPH-CANCUN-BITWISE-GAS",
      "aspect": "gas_economics",
      "title": "Cancun VM: Bitwise Operations Gas Model",
      "description": "Models the gas accounting for all bitwise operations",
      "nodes": [
        {
          "id": "STATE-BITWISE-INSTRUCTION-DECODED",
          "label": "Bitwise Instruction Decoded",
          "type": "State",
          "description": "EVM decoded bitwise opcode (AND/OR/XOR/NOT/BYTE/SHL/SHR/SAR)"
        },
        {
          "id": "ACTION-LOOKUP-GAS-COST",
          "label": "Lookup Gas Cost",
          "type": "Action",
          "description": "Determine gas cost for instruction (all bitwise ops use GAS_VERY_LOW)"
        },
        {
          "id": "STATE-GAS-COST-DETERMINED",
          "label": "Gas Cost Determined",
          "type": "State",
          "description": "Gas cost is GAS_VERY_LOW (3 gas) for all bitwise operations"
        },
        {
          "id": "ACTION-CHECK-GAS-AVAILABLE",
          "label": "Check Gas Available",
          "type": "Action",
          "description": "Verify remaining gas >= required gas"
        },
        {
          "id": "STATE-GAS-SUFFICIENT",
          "label": "Gas Sufficient",
          "type": "State",
          "description": "Enough gas available to execute instruction"
        },
        {
          "id": "STATE-OUT-OF-GAS",
          "label": "Out of Gas Error",
          "type": "State",
          "description": "Insufficient gas - execution halts with OOG exception"
        },
        {
          "id": "ACTION-DEDUCT-GAS",
          "label": "Deduct Gas",
          "type": "Action",
          "description": "Subtract gas cost from remaining gas"
        },
        {
          "id": "STATE-GAS-DEDUCTED",
          "label": "Gas Deducted",
          "type": "State",
          "description": "Gas accounting complete, proceed with execution"
        }
      ],
      "edges": [
        {
          "id": "EDGE-LOOKUP",
          "source": "STATE-BITWISE-INSTRUCTION-DECODED",
          "target": "ACTION-LOOKUP-GAS-COST",
          "label": "Get instruction gas cost"
        },
        {
          "id": "EDGE-COST-FOUND",
          "source": "ACTION-LOOKUP-GAS-COST",
          "target": "STATE-GAS-COST-DETERMINED",
          "label": "Cost = 3 (GAS_VERY_LOW)"
        },
        {
          "id": "EDGE-CHECK-GAS",
          "source": "STATE-GAS-COST-DETERMINED",
          "target": "ACTION-CHECK-GAS-AVAILABLE",
          "label": "Verify gas availability"
        },
        {
          "id": "EDGE-GAS-OK",
          "source": "ACTION-CHECK-GAS-AVAILABLE",
          "target": "STATE-GAS-SUFFICIENT",
          "label": "Gas >= 3"
        },
        {
          "id": "EDGE-GAS-FAIL",
          "source": "ACTION-CHECK-GAS-AVAILABLE",
          "target": "STATE-OUT-OF-GAS",
          "label": "Gas < 3"
        },
        {
          "id": "EDGE-DEDUCT",
          "source": "STATE-GAS-SUFFICIENT",
          "target": "ACTION-DEDUCT-GAS",
          "label": "Subtract from remaining"
        },
        {
          "id": "EDGE-DEDUCTED",
          "source": "ACTION-DEDUCT-GAS",
          "target": "STATE-GAS-DEDUCTED",
          "label": "Gas accounting done"
        }
      ],
      "external_entities": []
    }
  ],
  "ambiguities": [
    {
      "id": "AMB-CANCUN-BIT-01",
      "type": "Semantic",
      "text": "The BYTE operation uses 'left-to-right' indexing which may be confused with standard byte ordering.",
      "resolution_strategy": "Assume BYTE(i, x) extracts byte at position i from the big-endian representation of x, where i=0 is the most significant byte."
    },
    {
      "id": "AMB-CANCUN-BIT-02",
      "type": "Vagueness",
      "text": "The description states 'masks to MAX_VALUE' for SHL without specifying MAX_VALUE.",
      "resolution_strategy": "Assume MAX_VALUE = 2^256 - 1, the maximum unsigned 256-bit integer."
    }
  ],
  "implicit_assumptions": [
    {
      "id": "ASSUM-CANCUN-BIT-01",
      "type": "Operational",
      "description": "All bitwise operations assume stack has sufficient depth for required operands.",
      "impact_if_false": "Stack underflow would cause execution to halt with an error, potentially leaving state inconsistent if not properly handled."
    },
    {
      "id": "ASSUM-CANCUN-BIT-02",
      "type": "Environmental",
      "description": "GAS_VERY_LOW constant is assumed to be correctly set to 3 gas across all implementations.",
      "impact_if_false": "Inconsistent gas costs between implementations could cause consensus failures."
    },
    {
      "id": "ASSUM-CANCUN-BIT-03",
      "type": "Trust",
      "description": "The underlying integer arithmetic for shift operations is assumed to handle 256-bit values correctly.",
      "impact_if_false": "Integer overflow or incorrect bit manipulation could lead to wrong computation results."
    },
    {
      "id": "ASSUM-CANCUN-BIT-04",
      "type": "Attacker Capability",
      "description": "Attackers cannot cause timing side-channels through bitwise operations as all operations are constant-time for same input sizes.",
      "impact_if_false": "Variable-time operations could leak information about operand values through timing analysis."
    }
  ]
}
