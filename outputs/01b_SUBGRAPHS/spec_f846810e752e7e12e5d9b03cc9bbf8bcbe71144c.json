    {
      "id": "SUBGRAPH-CANCUN-SYSTEM-CREATE",
      "aspect": "transaction_lifecycle",
      "title": "Cancun CREATE/CREATE2: Contract Creation Lifecycle",
      "description": "Models the full lifecycle of contract creation via CREATE and CREATE2 opcodes",
      "nodes": [
        {
          "id": "STATE-CREATE-INITIATED",
          "label": "Contract Creation Initiated",
          "type": "State",
          "description": "CREATE or CREATE2 opcode dispatched, beginning contract creation process"
        },
        {
          "id": "ACTION-POP-CREATE-PARAMS",
          "label": "Pop Creation Parameters",
          "type": "Action",
          "description": "Pop endowment value, memory offset, memory size (and salt for CREATE2) from stack"
        },
        {
          "id": "STATE-CREATE-PARAMS-LOADED",
          "label": "Creation Parameters Loaded",
          "type": "State",
          "description": "Value, init code location, and optional salt ready"
        },
        {
          "id": "ACTION-READ-INIT-CODE",
          "label": "Read Init Code from Memory",
          "type": "Action",
          "description": "Extract initialization bytecode from memory"
        },
        {
          "id": "ACTION-CHECK-INIT-CODE-SIZE",
          "label": "Check Init Code Size Limit",
          "type": "Action",
          "description": "Verify init code doesn't exceed MAX_INIT_CODE_SIZE"
        },
        {
          "id": "STATE-INIT-CODE-VALID",
          "label": "Init Code Size Valid",
          "type": "State",
          "description": "Init code within size limits"
        },
        {
          "id": "STATE-INIT-CODE-TOO-LARGE",
          "label": "Init Code Exceeds Limit",
          "type": "State",
          "description": "Init code larger than MAX_INIT_CODE_SIZE"
        },
        {
          "id": "ACTION-COMPUTE-CONTRACT-ADDRESS",
          "label": "Compute Contract Address",
          "type": "Action",
          "description": "Calculate new contract address (CREATE: sender+nonce, CREATE2: sender+salt+init_code_hash)"
        },
        {
          "id": "STATE-ADDRESS-COMPUTED",
          "label": "Contract Address Computed",
          "type": "State",
          "description": "Target address for new contract determined"
        },
        {
          "id": "ACTION-CHECK-ADDRESS-COLLISION",
          "label": "Check for Address Collision",
          "type": "Action",
          "description": "Verify target address doesn't already have code or storage"
        },
        {
          "id": "STATE-ADDRESS-AVAILABLE",
          "label": "Address Available for Creation",
          "type": "State",
          "description": "Target address is empty, can create contract"
        },
        {
          "id": "STATE-ADDRESS-COLLISION",
          "label": "Address Collision Detected",
          "type": "State",
          "description": "Target address already has code or storage"
        },
        {
          "id": "ACTION-CHECK-SENDER-BALANCE",
          "label": "Check Sender Balance",
          "type": "Action",
          "description": "Verify sender has sufficient balance for endowment"
        },
        {
          "id": "STATE-BALANCE-SUFFICIENT",
          "label": "Sender Balance Sufficient",
          "type": "State",
          "description": "Sender can afford endowment transfer"
        },
        {
          "id": "STATE-BALANCE-INSUFFICIENT",
          "label": "Sender Balance Insufficient",
          "type": "State",
          "description": "Sender cannot afford endowment"
        },
        {
          "id": "ACTION-CHECK-DEPTH-LIMIT",
          "label": "Check Call Depth Limit",
          "type": "Action",
          "description": "Verify depth + 1 <= STACK_DEPTH_LIMIT (1024)"
        },
        {
          "id": "STATE-DEPTH-OK",
          "label": "Depth Within Limit",
          "type": "State",
          "description": "Can proceed with nested execution"
        },
        {
          "id": "STATE-DEPTH-EXCEEDED",
          "label": "Call Depth Exceeded",
          "type": "State",
          "description": "Cannot create due to depth limit"
        },
        {
          "id": "ACTION-CHECK-NONCE-OVERFLOW",
          "label": "Check Nonce Overflow",
          "type": "Action",
          "description": "Verify sender nonce < 2^64 - 1"
        },
        {
          "id": "STATE-NONCE-OK",
          "label": "Nonce Valid",
          "type": "State",
          "description": "Nonce can be incremented"
        },
        {
          "id": "STATE-NONCE-OVERFLOW",
          "label": "Nonce Overflow",
          "type": "State",
          "description": "Sender nonce at maximum"
        },
        {
          "id": "ACTION-INCREMENT-SENDER-NONCE",
          "label": "Increment Sender Nonce",
          "type": "Action",
          "description": "Increase sender's nonce by 1"
        },
        {
          "id": "ACTION-TRANSFER-ENDOWMENT",
          "label": "Transfer Endowment Value",
          "type": "Action",
          "description": "Move value from sender to new contract address"
        },
        {
          "id": "ACTION-CREATE-CHILD-EVM",
          "label": "Create Child EVM Context",
          "type": "Action",
          "description": "Spawn new EVM execution context for init code"
        },
        {
          "id": "ACTION-EXECUTE-INIT-CODE",
          "label": "Execute Init Code",
          "type": "Action",
          "description": "Run initialization bytecode in child EVM"
        },
        {
          "id": "STATE-INIT-EXECUTION-SUCCESS",
          "label": "Init Code Execution Success",
          "type": "State",
          "description": "Init code ran successfully, returned runtime bytecode"
        },
        {
          "id": "STATE-INIT-EXECUTION-FAILURE",
          "label": "Init Code Execution Failed",
          "type": "State",
          "description": "Init code reverted or ran out of gas"
        },
        {
          "id": "ACTION-SET-CONTRACT-CODE",
          "label": "Set Contract Code",
          "type": "Action",
          "description": "Store returned bytecode at new contract address"
        },
        {
          "id": "ACTION-INCORPORATE-CHILD-SUCCESS",
          "label": "Incorporate Child State on Success",
          "type": "Action",
          "description": "Merge child EVM state changes into parent"
        },
        {
          "id": "ACTION-INCORPORATE-CHILD-ERROR",
          "label": "Incorporate Child State on Error",
          "type": "Action",
          "description": "Discard child state changes, keep gas accounting"
        },
        {
          "id": "ACTION-PUSH-CREATE-RESULT",
          "label": "Push Creation Result",
          "type": "Action",
          "description": "Push new contract address (success) or 0 (failure) to stack"
        },
        {
          "id": "STATE-CREATE-COMPLETE",
          "label": "Contract Creation Complete",
          "type": "State",
          "description": "CREATE/CREATE2 finished, result on stack"
        }
      ],
      "edges": [
        {
          "id": "EDGE-START-CREATE",
          "source": "STATE-CREATE-INITIATED",
          "target": "ACTION-POP-CREATE-PARAMS",
