    "total_findings": 9,
    "high": 1,
    "medium": 4,
    "low": 4,
    "key_patterns": [
      "whenTokensSupplied missing in claimTokenAllocation (AbstractSale) and withdrawRaisedCapital (PreLiquid variants)",
      "LegionVestingFactory has no access control on creation functions - permissionless vesting creation",
      "setAcceptedCapital in AbstractSale lacks whenNotPaused",
      "LegionCapitalRaise.cancel() lacks whenTokensNotSupplied equivalent",
      "withdrawExcessInvestedCapital in AbstractSale lacks whenSaleResultsArePublished and whenRefundPeriodIsOver"
    ],
    "bouncer_notes": [
      "LegionBouncer uses OwnableRoles (Solady) with a single BROADCASTER_ROLE (_ROLE_0)",
      "Only BROADCASTER_ROLE can call functionCall() to execute arbitrary calls on target contracts",
      "Owner can grant/revoke BROADCASTER_ROLE via OwnableRoles",
      "The bouncer address is cached in each sale/raise contract and refreshable via syncLegionAddresses()",
      "Changing the bouncer in the registry requires a syncLegionAddresses() call on each affected contract - this is a risk if not done atomically"
    ],
    "factory_notes": [
      "All sale/raise/distributor factories use onlyOwner for create functions",
      "LegionVestingFactory is the ONLY factory without access control - any address can deploy vesting contracts",
      "Factory ownership pattern uses Solady Ownable with _initializeOwner in constructor"
    ]
  }
