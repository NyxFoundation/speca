{
  "audit_title": "Legion Protocol - Comprehensive Access Control Audit",
  "audit_date": "2026-03-28",
  "auditor": "Claude Sonnet 4.6 (Automated)",
  "scope": "src/ - all Solidity files",
  "findings": [
    {
      "id": "AC-001",
      "severity": "High",
      "title": "claimTokenAllocation missing whenTokensSupplied in LegionAbstractSale",
      "description": "LegionAbstractSale.claimTokenAllocation() transfers tokens to investors but does not include the `whenTokensSupplied` modifier. Without this guard, the function can be called before tokens have been deposited by the project, which will cause the SafeTransfer call to revert with an insufficient balance error or - if tokens were sent directly to the contract from another source - allow claims against unintended token balances. The contract may hold funds from cancelled sales or emergency withdrawals, creating confusion. By contrast, withdrawRaisedCapital() correctly enforces `whenTokensSupplied`.",
      "file": "src/sales/LegionAbstractSale.sol",
      "function": "claimTokenAllocation",
      "missing_modifier": "whenTokensSupplied",
      "comparison": "withdrawRaisedCapital() in the same contract has `whenTokensSupplied`; LegionPreLiquidApprovedSale.claimTokenAllocation() correctly includes `whenTokensSupplied`",
      "actual_modifiers": ["whenNotPaused", "whenSaleNotCanceled", "whenRefundPeriodIsOver", "whenSaleResultsArePublished"],
      "expected_modifiers": ["whenNotPaused", "whenSaleNotCanceled", "whenRefundPeriodIsOver", "whenSaleResultsArePublished", "whenTokensSupplied"]
    },
    {
      "id": "AC-002",
      "severity": "Medium",
      "title": "withdrawExcessInvestedCapital missing whenSaleResultsArePublished in LegionAbstractSale",
      "description": "LegionAbstractSale.withdrawExcessInvestedCapital() only has `whenNotPaused` and `whenSaleNotCanceled`. There is no check that sale results have been published (i.e., the merkle root exists) before investors can claim excess capital. Although the internal `_verifyCanClaimExcessCapital` performs a merkle proof check, if acceptedCapitalMerkleRoot is zero (unset), the proof would always fail, but this is a runtime failure rather than a clear access-control guard. The function lacks `whenSaleResultsArePublished` and `whenRefundPeriodIsOver`, which are present on comparable capital-settlement functions.",
      "file": "src/sales/LegionAbstractSale.sol",
      "function": "withdrawExcessInvestedCapital",
      "missing_modifier": "whenSaleResultsArePublished, whenRefundPeriodIsOver",
      "comparison": "claimTokenAllocation() has `whenSaleResultsArePublished` and `whenRefundPeriodIsOver`; LegionPreLiquidApprovedSale.withdrawExcessInvestedCapital() also has no such guards but does verify merkle",
      "actual_modifiers": ["whenNotPaused", "whenSaleNotCanceled"],
      "expected_modifiers": ["whenNotPaused", "whenSaleNotCanceled", "whenSaleResultsArePublished", "whenRefundPeriodIsOver"]
    },
    {
      "id": "AC-003",
      "severity": "Medium",
      "title": "setAcceptedCapital missing whenNotPaused in LegionAbstractSale",
      "description": "LegionAbstractSale.setAcceptedCapital() is restricted to `onlyLegion` and `whenSaleNotCanceled`, but does NOT include `whenNotPaused`. This means Legion can update the accepted capital merkle root even when the contract is paused. All other state-changing Legion-only functions (pause, unpause, publishSaleResults, emergencyWithdraw, syncLegionAddresses, transferInvestorPosition) consistently include `whenNotPaused` or are themselves the pause toggle. Allowing merkle root updates during a paused state could create unexpected state during an incident.",
      "file": "src/sales/LegionAbstractSale.sol",
      "function": "setAcceptedCapital",
      "missing_modifier": "whenNotPaused",
      "comparison": "publishSaleResults() (FixedPriceSale/SealedBidAuction) includes `whenNotPaused`; all other state-mutating onlyLegion functions include `whenNotPaused`",
      "actual_modifiers": ["onlyLegion", "whenSaleNotCanceled"],
      "expected_modifiers": ["onlyLegion", "whenNotPaused", "whenSaleNotCanceled"]
    },
    {
      "id": "AC-004",
      "severity": "Medium",
      "title": "LegionPreLiquidApprovedSale.withdrawRaisedCapital missing whenTokensSupplied",
      "description": "LegionPreLiquidApprovedSale.withdrawRaisedCapital() has `onlyProject`, `whenNotPaused`, `whenSaleNotCanceled`, `whenSaleEnded`, and `whenRefundPeriodIsOver` but does NOT check `whenTokensSupplied`. This differs from LegionAbstractSale.withdrawRaisedCapital() which requires `whenTokensSupplied` and `whenSaleResultsArePublished`. The PreLiquid flow requires tokens to be supplied before capital can be withdrawn (otherwise the project could withdraw capital without having provided tokens). The internal `_verifyCanWithdrawCapital()` checks `totalCapitalRaised != 0` but that is only set by `publishRaisedCapital()`, not by token supply — so a project could potentially withdraw capital before token supply.",
      "file": "src/sales/LegionPreLiquidApprovedSale.sol",
      "function": "withdrawRaisedCapital",
      "missing_modifier": "whenTokensSupplied",
      "comparison": "LegionAbstractSale.withdrawRaisedCapital() has `whenTokensSupplied`; LegionPreLiquidOpenApplicationSale.withdrawRaisedCapital() also lacks `whenTokensSupplied`",
      "actual_modifiers": ["onlyProject", "whenNotPaused", "whenSaleNotCanceled", "whenSaleEnded", "whenRefundPeriodIsOver"],
      "expected_modifiers": ["onlyProject", "whenNotPaused", "whenSaleNotCanceled", "whenSaleEnded", "whenRefundPeriodIsOver", "whenTokensSupplied"]
    },
    {
      "id": "AC-005",
      "severity": "Medium",
      "title": "LegionPreLiquidOpenApplicationSale.withdrawRaisedCapital missing whenTokensSupplied",
      "description": "Same issue as AC-004 but in LegionPreLiquidOpenApplicationSale. The function overrides LegionAbstractSale.withdrawRaisedCapital() and removes the `whenTokensSupplied` modifier that is present in the base class. This allows the project to withdraw raised capital without having supplied tokens to investors.",
      "file": "src/sales/LegionPreLiquidOpenApplicationSale.sol",
      "function": "withdrawRaisedCapital",
      "missing_modifier": "whenTokensSupplied",
      "comparison": "LegionAbstractSale.withdrawRaisedCapital() (base) has `whenTokensSupplied`",
      "actual_modifiers": ["onlyProject", "whenNotPaused", "whenSaleEnded", "whenRefundPeriodIsOver", "whenSaleNotCanceled"],
      "expected_modifiers": ["onlyProject", "whenNotPaused", "whenSaleEnded", "whenRefundPeriodIsOver", "whenSaleNotCanceled", "whenTokensSupplied"]
    },
    {
      "id": "AC-006",
      "severity": "Medium",
      "title": "LegionCapitalRaise.cancel() missing whenTokensNotSupplied",
      "description": "LegionCapitalRaise.cancel() only has `onlyProject`, `whenNotPaused`, and `whenRaiseNotCanceled`. It does NOT check that tokens have not been supplied (no `whenTokensNotSupplied` equivalent). Compare this with LegionPreLiquidApprovedSale.cancel() and LegionPreLiquidOpenApplicationSale.cancel() which both include `whenTokensNotSupplied`. Without this guard, the project could cancel a capital raise after tokens have already been supplied, potentially stranding investor funds.",
      "file": "src/raise/LegionCapitalRaise.sol",
      "function": "cancel",
      "missing_modifier": "whenTokensNotSupplied (or equivalent raise-level guard)",
      "comparison": "LegionPreLiquidApprovedSale.cancel() has `whenTokensNotSupplied`; LegionPreLiquidOpenApplicationSale.cancel() has `whenTokensNotSupplied`; LegionAbstractSale.cancel() has `whenSaleResultsNotPublished`",
      "actual_modifiers": ["onlyProject", "whenNotPaused", "whenRaiseNotCanceled"],
      "expected_modifiers": ["onlyProject", "whenNotPaused", "whenRaiseNotCanceled", "whenTokensNotSupplied"]
    },
    {
      "id": "AC-007",
      "severity": "Low",
      "title": "LegionVestingFactory.createLinearVesting and createLinearEpochVesting have no access control",
      "description": "LegionVestingFactory is the only factory without an `onlyOwner` (or equivalent) guard on its creation functions. Both `createLinearVesting()` and `createLinearEpochVesting()` are callable by any address. While the resulting vesting contracts set a `beneficiary` and `vestingController` provided by the caller, an arbitrary actor can create vesting contracts with arbitrary parameters, potentially confusing off-chain monitoring or wasting gas. All other factories (LegionFixedPriceSaleFactory, LegionPreLiquidApprovedSaleFactory, LegionPreLiquidOpenApplicationSaleFactory, LegionSealedBidAuctionSaleFactory, LegionTokenDistributorFactory, LegionCapitalRaiseFactory) enforce `onlyOwner`. Note: the intended callers are sale contracts via LegionVestingManager, but any caller can invoke this factory directly.",
      "file": "src/factories/LegionVestingFactory.sol",
      "function": "createLinearVesting, createLinearEpochVesting",
      "missing_modifier": "onlyOwner (or whitelist of authorized sale contracts)",
      "comparison": "All other factories (LegionFixedPriceSaleFactory, LegionCapitalRaiseFactory, LegionTokenDistributorFactory, LegionSealedBidAuctionSaleFactory, LegionPreLiquidApprovedSaleFactory, LegionPreLiquidOpenApplicationSaleFactory) use `onlyOwner`",
      "actual_modifiers": [],
      "expected_modifiers": ["onlyOwner or onlyAuthorizedSaleContract"]
    },
    {
      "id": "AC-008",
      "severity": "Low",
      "title": "LegionTokenDistributor.claimTokenAllocation missing whenTokensSupplied",
      "description": "LegionTokenDistributor.claimTokenAllocation() only has `whenNotPaused`. The internal `_verifyCanClaimTokenAllocation()` does verify some conditions, but there is no `whenTokensSupplied` modifier as a first-class guard. While internally the tokensSupplied flag is checked, for consistency with the rest of the protocol and for gas efficiency (fail-fast pattern), a modifier-level check should be present. Compare with LegionPreLiquidApprovedSale.claimTokenAllocation() which has `whenTokensSupplied` as an explicit modifier.",
      "file": "src/distribution/LegionTokenDistributor.sol",
      "function": "claimTokenAllocation",
      "missing_modifier": "whenTokensSupplied",
      "comparison": "LegionPreLiquidApprovedSale.claimTokenAllocation() explicitly includes `whenTokensSupplied` modifier",
      "actual_modifiers": ["whenNotPaused"],
      "expected_modifiers": ["whenNotPaused", "whenTokensSupplied"]
    },
    {
      "id": "AC-009",
      "severity": "Low",
      "title": "LegionPreLiquidApprovedSale.syncLegionAddresses missing whenNotPaused",
      "description": "LegionPreLiquidApprovedSale.syncLegionAddresses() only has `onlyLegion` with no `whenNotPaused`. Contrast with LegionAbstractSale.syncLegionAddresses() which also only has `onlyLegion`, but in the abstract sale context `syncLegionAddresses` is consistent. However, in the PreLiquidApprovedSale, _syncLegionAddresses updates s_saleConfig.legionBouncer which affects who can call `onlyLegion` functions. Syncing the bouncer address while paused could re-enable control unexpectedly. This is a consistency concern.",
      "file": "src/sales/LegionPreLiquidApprovedSale.sol",
      "function": "syncLegionAddresses",
      "missing_modifier": "whenNotPaused",
      "comparison": "LegionAbstractSale.syncLegionAddresses() also lacks `whenNotPaused` - consistent within the abstract hierarchy but potentially risky for the standalone PreLiquidApprovedSale",
      "actual_modifiers": ["onlyLegion"],
      "expected_modifiers": ["onlyLegion", "whenNotPaused"]
    }
  ],
