    "text": "Exchange rate must equal (cash + borrows - reserves) / total_ctoken_supply at all times.",
    "type": "invariant",
    "assertion": "forall t: exchange_rate(t) == (reserve.cash + reserve.borrows - reserve.cash_reserve) / reserve.total_ctoken_supply",
    "severity": "CRITICAL",
    "covers": "SG-002",
    "reachability": {
      "classification": "external-reachable",
      "entry_points": [
        "Transaction",
        "FlashLoan"
      ],
      "attacker_controlled": true,
      "bug_bounty_scope": "in-scope"
