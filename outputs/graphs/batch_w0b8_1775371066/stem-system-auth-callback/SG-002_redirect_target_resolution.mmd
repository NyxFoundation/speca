---
title: "redirect_target_resolution (stem-system auth/callback/route.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_read_cookies: oauthRedirectCookie = cookies.get('oauth_redirect')
    q_read_cookies --> q_read_client_cookie: oauthRedirectClient = cookies.get('oauth_redirect_client')
    q_read_client_cookie --> q_read_next_param: nextParam = searchParams.get('next')

    q_read_next_param --> q_sanitize_httponly: oauthRedirectCookie exists
    q_read_next_param --> q_sanitize_next: oauthRedirectCookie is undefined

    q_sanitize_httponly --> q_try_parse_cookie: try new URL(oauthRedirectCookie)
    q_try_parse_cookie --> q_cookie_abs: parse succeeds
    q_try_parse_cookie --> q_cookie_rel: parse fails (relative path)
    q_cookie_abs --> q_sanitize_next: oauthRedirectPath = pathname + search
    q_cookie_rel --> q_sanitize_next: oauthRedirectPath = oauthRedirectCookie

    q_sanitize_next --> q_try_parse_next: nextParam exists
    q_sanitize_next --> q_sanitize_client: nextParam is undefined

    q_try_parse_next --> q_next_abs: parse succeeds
    q_try_parse_next --> q_next_rel: parse fails (relative path)
    q_next_abs --> q_sanitize_client: nextParam = pathname + search
    q_next_rel --> q_sanitize_client: nextParam unchanged

    q_sanitize_client --> q_try_parse_client: oauthRedirectClient exists
    q_sanitize_client --> q_resolve_next: oauthRedirectClient is undefined

    q_try_parse_client --> q_client_abs: parse succeeds
    q_try_parse_client --> q_client_rel: parse fails (relative path)
    q_client_abs --> q_resolve_next: clientRedirectPath = pathname + search
    q_client_rel --> q_resolve_next: clientRedirectPath = oauthRedirectClient

    q_resolve_next --> q_check_relative: next = oauthRedirectPath || nextParam || clientRedirectPath || '/dashboard'
    q_check_relative --> q_safe_redirect: next.startsWith('/')
    q_check_relative --> q_default_redirect: !next.startsWith('/')
    q_safe_redirect --> [*]: redirectUrl = origin + next
    q_default_redirect --> [*]: redirectUrl = origin + '/dashboard'

    note right of q_resolve_next
        INV-001: redirect target is resolved from 4 sources in priority order (httpOnly cookie, next param, client cookie, default)
        INV-002: absolute URLs are stripped to pathname + search (open redirect mitigation)
        INV-003: final redirectUrl only allows paths starting with '/' (relative path guard)
        INV-004: URL parsing via try/catch means malformed URLs fall through as relative paths
    end note
