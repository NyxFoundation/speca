---
title: "repayBorrow (Compound Whitepaper)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: msg.sender calls repayBorrow(amount) or repayBorrowBehalf(account, amount)
    q_validate --> q_accrue: amount > 0
    q_validate --> q_error_zero: amount = 0
    q_accrue --> q_calc_owed: accrueInterest()
    q_calc_owed --> q_determine_repay: borrowBalanceCurrent = borrowBalance[borrower] * (currentIndex / borrowIndex[borrower])
    q_determine_repay --> q_transfer_in: repayAmount = min(amount, borrowBalanceCurrent)
    q_transfer_in --> q_update_balance: transferFrom(msg.sender, market, repayAmount)
    q_update_balance --> q_checkpoint: borrowBalance[borrower] = borrowBalanceCurrent - repayAmount
    q_checkpoint --> [*]: borrowIndex[borrower] = currentIndex; totalBorrows = totalBorrows - repayAmount
    q_error_zero --> [*]: revert

    note right of q_calc_owed
        INV-001: borrowBalanceCurrent includes all accrued interest up to current block
        INV-002: borrowBalanceCurrent = storedBalance * (currentIndex / storedIndex)
    end note

    note right of q_update_balance
        INV-003: repayAmount must not exceed current borrow balance
        INV-004: totalBorrows must decrease by exactly repayAmount
        INV-005: underlying transfer must succeed before updating borrow balance
    end note
