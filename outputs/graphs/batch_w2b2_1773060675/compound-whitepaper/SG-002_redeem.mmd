---
title: "redeem (Compound Whitepaper)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: msg.sender calls redeem(amount) or redeemUnderlying(amountUnderlying)
    q_validate --> q_accrue: amount > 0 or amountUnderlying > 0
    q_validate --> q_error_zero: amount = 0 and amountUnderlying = 0
    q_accrue --> q_exchange: accrueInterest()
    q_exchange --> q_calc: exchangeRate = (underlyingBalance + totalBorrowBalance - reserves) / cTokenSupply
    q_calc --> q_check_liquidity: redeemAmount = amount * exchangeRate OR redeemTokens = amountUnderlying / exchangeRate
    q_check_liquidity --> q_comptroller: comptroller.redeemAllowed(msg.sender, redeemTokens)
    q_comptroller --> q_check_cash: allowed = true
    q_comptroller --> q_error_collateral: allowed = false (insufficient collateral)
    q_check_cash --> q_transfer_out: market.cash >= redeemAmount
    q_check_cash --> q_error_liquidity: market.cash < redeemAmount
    q_transfer_out --> q_update: transfer(msg.sender, redeemAmount)
    q_update --> [*]: cTokenBalance[msg.sender] = cTokenBalance[msg.sender] - redeemTokens; cTokenSupply = cTokenSupply - redeemTokens
    q_error_zero --> [*]: revert
    q_error_collateral --> [*]: revert insufficient collateral
    q_error_liquidity --> [*]: revert insufficient liquidity

    note right of q_check_liquidity
        INV-001: redeem must not cause borrowing to exceed borrowing capacity
        INV-002: protocol must have sufficient cash (underlying tokens) for withdrawal
    end note

    note right of q_exchange
        INV-003: exchangeRate is consistent before and after redeem (only cTokenSupply and underlyingBalance change proportionally)
    end note
