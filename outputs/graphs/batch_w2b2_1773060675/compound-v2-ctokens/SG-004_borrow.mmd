---
title: "borrow (Compound V2: cTokens)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue: accrueInterest()
    q_accrue --> q_error_accrue: accrueInterest failed
    q_error_accrue --> [*]: return BORROW_ACCRUE_INTEREST_FAILED
    q_accrue --> q_freshness: check block.number == accrualBlockNumber
    q_freshness --> q_error_fresh: market not fresh
    q_error_fresh --> [*]: return BORROW_FRESHNESS_CHECK
    q_freshness --> q_comptroller: borrowAllowed(cToken, borrower, borrowAmount)
    q_comptroller --> q_error_comptroller: comptroller rejected
    q_error_comptroller --> [*]: return BORROW_COMPTROLLER_REJECTION
    q_comptroller --> q_check_cash: check getCash() >= borrowAmount
    q_check_cash --> q_error_cash: insufficient cash
    q_error_cash --> [*]: return BORROW_CASH_NOT_AVAILABLE
    q_check_cash --> q_calc_balance: accountBorrowNew = accountBorrow + borrowAmount
    q_calc_balance --> q_calc_total: totalBorrowsNew = totalBorrows + borrowAmount
    q_calc_total --> q_transfer_out: doTransferOut(borrower, borrowAmount)
    q_transfer_out --> q_update_borrow: accountBorrows[borrower] = accountBorrowNew
    q_update_borrow --> q_update_total: totalBorrows = totalBorrowsNew
    q_update_total --> q_emit: emit Borrow(borrower, borrowAmount, accountBorrowNew, totalBorrowsNew)
    q_emit --> [*]: return NO_ERROR

    note right of q_check_cash
        INV-001: getCash() >= borrowAmount (sufficient liquidity)
        INV-002: borrower account liquidity >= 0 after borrow (collateral sufficient)
    end note

    note right of q_calc_balance
        INV-003: accountBorrowNew = accountBorrowPrior + borrowAmount
        INV-004: totalBorrowsNew = totalBorrowsPrior + borrowAmount
        INV-005: borrower receives exactly borrowAmount of underlying
    end note
