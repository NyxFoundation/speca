---
title: "liquidateBorrow (Compound V2: cTokens)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue_borrow: accrueInterest() on borrow market
    q_accrue_borrow --> q_error_accrue_b: accrue borrow interest failed
    q_error_accrue_b --> [*]: return LIQUIDATE_ACCRUE_BORROW_INTEREST_FAILED
    q_accrue_borrow --> q_accrue_collateral: accrueInterest() on collateral market
    q_accrue_collateral --> q_error_accrue_c: accrue collateral interest failed
    q_error_accrue_c --> [*]: return LIQUIDATE_ACCRUE_COLLATERAL_INTEREST_FAILED
    q_accrue_collateral --> q_check_self: check liquidator != borrower
    q_check_self --> q_error_self: liquidator is borrower
    q_error_self --> [*]: return LIQUIDATE_LIQUIDATOR_IS_BORROWER
    q_check_self --> q_check_amount_zero: check repayAmount > 0
    q_check_amount_zero --> q_error_zero: close amount is zero
    q_error_zero --> [*]: return LIQUIDATE_CLOSE_AMOUNT_IS_ZERO
    q_check_amount_zero --> q_check_amount_max: check repayAmount != uint(-1)
    q_check_amount_max --> q_error_max: close amount is uint max
    q_error_max --> [*]: return LIQUIDATE_CLOSE_AMOUNT_IS_UINT_MAX
    q_check_amount_max --> q_comptroller: liquidateBorrowAllowed(borrowMarket, collateralMarket, liquidator, borrower, repayAmount)
    q_comptroller --> q_error_comptroller: comptroller rejected
    q_error_comptroller --> [*]: return LIQUIDATE_COMPTROLLER_REJECTION
    q_comptroller --> q_freshness_borrow: check borrow market fresh
    q_freshness_borrow --> q_error_fresh_b: borrow market not fresh
    q_error_fresh_b --> [*]: return LIQUIDATE_FRESHNESS_CHECK
    q_freshness_borrow --> q_freshness_collateral: check collateral market fresh
    q_freshness_collateral --> q_error_fresh_c: collateral market not fresh
    q_error_fresh_c --> [*]: return LIQUIDATE_COLLATERAL_FRESHNESS_CHECK
    q_freshness_collateral --> q_repay: repayBorrowFresh(liquidator, borrower, repayAmount)
    q_repay --> q_error_repay: repay failed
    q_error_repay --> [*]: return LIQUIDATE_REPAY_BORROW_FRESH_FAILED
    q_repay --> q_calc_seize: seizeTokens = comptroller.liquidateCalculateSeizeTokens(borrowMarket, collateralMarket, actualRepayAmount)
    q_calc_seize --> q_error_calc: calculation failed
    q_error_calc --> [*]: return LIQUIDATE_COMPTROLLER_CALCULATE_AMOUNT_SEIZE_FAILED
    q_calc_seize --> q_seize: collateral.seize(liquidator, borrower, seizeTokens)
    q_seize --> q_error_seize: seize failed
    q_error_seize --> [*]: return seize error code
    q_seize --> q_emit: emit LiquidateBorrow(liquidator, borrower, actualRepayAmount, collateral, seizeTokens)
    q_emit --> [*]: return NO_ERROR

    note right of q_check_self
        INV-001: liquidator != borrower (cannot self-liquidate)
        INV-002: 0 < repayAmount < uint(-1)
    end note

    note right of q_calc_seize
        INV-003: seizeTokens = actualRepayAmount * liquidationIncentive * priceBorrow / priceCollateral / exchangeRateCollateral
        INV-004: borrower account liquidity was negative before liquidation
        INV-005: repayAmount <= closeFactor * accountBorrows[borrower] (close factor limit)
    end note

    note right of q_seize
        INV-006: collateral cTokens transferred from borrower to liquidator
        INV-007: liquidator receives discounted collateral (liquidation incentive)
        INV-008: totalSupply of collateral market unchanged by seize
    end note
