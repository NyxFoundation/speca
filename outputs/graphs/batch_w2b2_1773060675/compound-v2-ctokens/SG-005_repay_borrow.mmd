---
title: "repayBorrow (Compound V2: cTokens)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue: accrueInterest()
    q_accrue --> q_error_accrue: accrueInterest failed
    q_error_accrue --> [*]: return REPAY_BORROW_ACCRUE_INTEREST_FAILED
    q_accrue --> q_freshness: check block.number == accrualBlockNumber
    q_freshness --> q_error_fresh: market not fresh
    q_error_fresh --> [*]: return REPAY_BORROW_FRESHNESS_CHECK
    q_freshness --> q_resolve_amount: repayAmount == uint(-1) ? accountBorrows : repayAmount
    q_resolve_amount --> q_transfer_in: doTransferIn(payer, actualRepayAmount)
    q_transfer_in --> q_error_transfer: transfer in failed
    q_error_transfer --> [*]: return REPAY_BORROW_TRANSFER_IN_NOT_POSSIBLE
    q_transfer_in --> q_calc_balance: accountBorrowNew = accountBorrow - actualRepayAmount
    q_calc_balance --> q_calc_total: totalBorrowsNew = totalBorrows - actualRepayAmount
    q_calc_total --> q_update_borrow: accountBorrows[borrower] = accountBorrowNew
    q_update_borrow --> q_update_total: totalBorrows = totalBorrowsNew
    q_update_total --> q_emit: emit RepayBorrow(payer, borrower, actualRepayAmount, accountBorrowNew, totalBorrowsNew)
    q_emit --> [*]: return NO_ERROR

    note right of q_resolve_amount
        INV-001: if repayAmount == uint(-1), repay full borrow balance
        INV-002: actualRepayAmount <= accountBorrows[borrower]
    end note

    note right of q_calc_balance
        INV-003: accountBorrowNew = accountBorrowPrior - actualRepayAmount
        INV-004: totalBorrowsNew = totalBorrowsPrior - actualRepayAmount
        INV-005: accountBorrowNew >= 0 (no underflow)
    end note
