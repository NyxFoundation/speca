---
title: "accrueInterest (Compound V2: cTokens)"
---
stateDiagram-v2
    direction TB
    [*] --> q_get_block: currentBlockNumber = block.number
    q_get_block --> q_check_fresh: check accrualBlockNumber == currentBlockNumber
    q_check_fresh --> q_already_fresh: already accrued this block
    q_already_fresh --> [*]: return NO_ERROR
    q_check_fresh --> q_calc_blocks: blockDelta = currentBlockNumber - accrualBlockNumber
    q_calc_blocks --> q_get_rate: borrowRatePerBlock = interestRateModel.getBorrowRate(getCash, totalBorrows, totalReserves)
    q_get_rate --> q_error_rate: rate model error
    q_error_rate --> [*]: return INTEREST_RATE_MODEL_ERROR
    q_get_rate --> q_calc_interest: simpleInterestFactor = borrowRatePerBlock * blockDelta
    q_calc_interest --> q_calc_borrow_accum: interestAccumulated = simpleInterestFactor * totalBorrows
    q_calc_borrow_accum --> q_update_borrows: totalBorrowsNew = totalBorrows + interestAccumulated
    q_update_borrows --> q_update_reserves: totalReservesNew = totalReserves + interestAccumulated * reserveFactorMantissa
    q_update_reserves --> q_update_index: borrowIndexNew = borrowIndex + simpleInterestFactor * borrowIndex
    q_update_index --> q_update_block: accrualBlockNumber = currentBlockNumber
    q_update_block --> q_store_borrows: totalBorrows = totalBorrowsNew
    q_store_borrows --> q_store_reserves: totalReserves = totalReservesNew
    q_store_reserves --> q_store_index: borrowIndex = borrowIndexNew
    q_store_index --> [*]: return NO_ERROR

    note right of q_calc_interest
        INV-001: simpleInterestFactor = borrowRate * blockDelta
        INV-002: interestAccumulated = simpleInterestFactor * totalBorrows (simple interest model)
    end note

    note right of q_update_reserves
        INV-003: totalBorrowsNew = totalBorrows + interestAccumulated
        INV-004: totalReservesNew = totalReserves + interestAccumulated * reserveFactor
        INV-005: borrowIndexNew = borrowIndex * (1 + simpleInterestFactor)
        INV-006: reserveFactor in [0, 1] (portion of interest to reserves)
    end note

    note right of q_update_block
        INV-007: accrualBlockNumber updated to current block (freshness guarantee)
        INV-008: idempotent within same block (no-op if already accrued)
    end note
