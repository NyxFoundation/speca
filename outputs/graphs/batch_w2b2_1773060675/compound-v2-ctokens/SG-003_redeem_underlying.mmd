---
title: "redeemUnderlying (Compound V2: cTokens)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue: accrueInterest()
    q_accrue --> q_error_accrue: accrueInterest failed
    q_error_accrue --> [*]: return REDEEM_ACCRUE_INTEREST_FAILED
    q_accrue --> q_freshness: check block.number == accrualBlockNumber
    q_freshness --> q_error_fresh: market not fresh
    q_error_fresh --> [*]: return REDEEM_FRESHNESS_CHECK
    q_freshness --> q_exchange: exchangeRate = (getCash() + totalBorrows - totalReserves) / totalSupply
    q_exchange --> q_error_exchange: exchange rate read failed
    q_error_exchange --> [*]: return REDEEM_EXCHANGE_RATE_READ_FAILED
    q_exchange --> q_calc: redeemTokens = redeemAmount / exchangeRate
    q_calc --> q_comptroller: redeemAllowed(cToken, redeemer, redeemTokens)
    q_comptroller --> q_error_comptroller: comptroller rejected
    q_error_comptroller --> [*]: return REDEEM_COMPTROLLER_REJECTION
    q_comptroller --> q_check_cash: check getCash() >= redeemAmount
    q_check_cash --> q_error_cash: insufficient cash
    q_error_cash --> [*]: return REDEEM_TRANSFER_OUT_NOT_POSSIBLE
    q_check_cash --> q_update_supply: totalSupply = totalSupply - redeemTokens
    q_update_supply --> q_update_balance: accountTokens[redeemer] = accountTokens[redeemer] - redeemTokens
    q_update_balance --> q_transfer_out: doTransferOut(redeemer, redeemAmount)
    q_transfer_out --> q_emit: emit Redeem(redeemer, redeemAmount, redeemTokens)
    q_emit --> [*]: return NO_ERROR

    note right of q_calc
        INV-001: redeemTokens = redeemAmount / exchangeRate (rounded up possible)
        INV-002: totalSupply decreases by exactly redeemTokens
        INV-003: user receives exactly redeemAmount of underlying
    end note

    note right of q_check_cash
        INV-004: getCash() >= redeemAmount (sufficient liquidity)
        INV-005: account liquidity remains non-negative after redeem
    end note
