---
title: "repayBorrowBehalf (Compound V2: cTokens)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue: accrueInterest()
    q_accrue --> q_error_accrue: accrueInterest failed
    q_error_accrue --> [*]: return REPAY_BEHALF_ACCRUE_INTEREST_FAILED
    q_accrue --> q_freshness: check block.number == accrualBlockNumber
    q_freshness --> q_error_fresh: market not fresh
    q_error_fresh --> [*]: return REPAY_BORROW_FRESHNESS_CHECK
    q_freshness --> q_check_borrower: check borrower != address(0)
    q_check_borrower --> q_error_borrower: invalid borrower
    q_error_borrower --> [*]: return BAD_INPUT
    q_check_borrower --> q_resolve_amount: repayAmount == uint(-1) ? accountBorrows[borrower] : repayAmount
    q_resolve_amount --> q_transfer_in: doTransferIn(msg.sender, actualRepayAmount)
    q_transfer_in --> q_error_transfer: transfer in failed
    q_error_transfer --> [*]: return REPAY_BORROW_TRANSFER_IN_NOT_POSSIBLE
    q_transfer_in --> q_calc_balance: accountBorrowNew = accountBorrows[borrower] - actualRepayAmount
    q_calc_balance --> q_calc_total: totalBorrowsNew = totalBorrows - actualRepayAmount
    q_calc_total --> q_update_borrow: accountBorrows[borrower] = accountBorrowNew
    q_update_borrow --> q_update_total: totalBorrows = totalBorrowsNew
    q_update_total --> q_emit: emit RepayBorrow(msg.sender, borrower, actualRepayAmount, accountBorrowNew, totalBorrowsNew)
    q_emit --> [*]: return NO_ERROR

    note right of q_check_borrower
        INV-001: borrower != address(0) (valid target)
        INV-002: payer (msg.sender) != borrower is allowed
    end note

    note right of q_calc_balance
        INV-003: funds transferred from msg.sender, not borrower
        INV-004: accountBorrows[borrower] decreases by actualRepayAmount
        INV-005: totalBorrows decreases by actualRepayAmount
    end note
