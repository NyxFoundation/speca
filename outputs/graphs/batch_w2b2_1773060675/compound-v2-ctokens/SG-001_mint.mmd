---
title: "mint (Compound V2: cTokens)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue: accrueInterest()
    q_accrue --> q_error_accrue: accrueInterest failed
    q_error_accrue --> [*]: return MINT_ACCRUE_INTEREST_FAILED
    q_accrue --> q_comptroller: mintAllowed(cToken, minter, mintAmount)
    q_comptroller --> q_error_comptroller: comptroller rejected
    q_error_comptroller --> [*]: return MINT_COMPTROLLER_REJECTION
    q_comptroller --> q_freshness: check block.number == accrualBlockNumber
    q_freshness --> q_error_fresh: market not fresh
    q_error_fresh --> [*]: return MINT_FRESHNESS_CHECK
    q_freshness --> q_exchange: exchangeRate = (getCash() + totalBorrows - totalReserves) / totalSupply
    q_exchange --> q_error_exchange: exchange rate calculation failed
    q_error_exchange --> [*]: return MINT_EXCHANGE_CALCULATION_FAILED
    q_exchange --> q_transfer_in: doTransferIn(msg.sender, mintAmount)
    q_transfer_in --> q_error_transfer: transfer in failed
    q_error_transfer --> [*]: return MINT_TRANSFER_IN_FAILED
    q_transfer_in --> q_calc_tokens: mintTokens = mintAmount / exchangeRate
    q_calc_tokens --> q_update_supply: totalSupply = totalSupply + mintTokens
    q_update_supply --> q_update_balance: accountTokens[minter] = accountTokens[minter] + mintTokens
    q_update_balance --> q_emit: emit Mint(minter, mintAmount, mintTokens)
    q_emit --> [*]: return NO_ERROR

    note right of q_exchange
        INV-001: exchangeRate = (getCash + totalBorrows - totalReserves) / totalSupply
        INV-002: totalSupply increases by exactly mintAmount / exchangeRate
        INV-003: underlying token balance of contract increases by exactly mintAmount
    end note

    note right of q_calc_tokens
        INV-004: mintTokens = actualMintAmount / exchangeRate (rounded down)
        INV-005: accountTokens[minter] post >= accountTokens[minter] pre
    end note
