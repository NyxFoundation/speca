---
title: "repay (Current Finance - Pebble Protocol Lending)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: app.validate_market(market)
    q_validate --> q_version: app.ensure_version_matches()
    q_version --> q_check_circuit: assert(!market.has_circuit_break_triggered())
    q_check_circuit --> q_error: circuit break triggered
    q_check_circuit --> q_timestamp: now = clock.timestamp_ms() / 1000
    q_timestamp --> q_capture: repay_amount = coin.value()
    q_capture --> q_handle_repay: market.handle_repay(obligation_id, coin, now, ctx)
    q_handle_repay --> q_accrue_interest: accrue_interest on reserve
    q_accrue_interest --> q_repay_debt: obligation.repay_debt(amount, borrow_index)
    q_repay_debt --> q_check_residual: residual = debt_amount <= repay_amount?
    q_check_residual --> q_full_repay: debt <= repay_amount; residual = repay - debt_ceil
    q_check_residual --> q_partial_repay: debt > repay_amount; residual = 0
    q_full_repay --> q_enforce_min: enforce_post_borrow_repay_invariant
    q_partial_repay --> q_enforce_min
    q_enforce_min --> q_update_miner: miner.update_obligation_reward_manager(borrow_type, obligation_id, total_borrow.floor(), clock)
    q_update_miner --> q_emit: emit RepayEvent
    q_emit --> q_check_refund: refund_amount > 0?
    q_check_refund --> q_transfer: transfer refund to sender
    q_check_refund --> q_destroy_zero: destroy_zero(refund)
    q_transfer --> [*]: return
    q_destroy_zero --> [*]: return

    note right of q_repay_debt
        INV-001: Interest accrued before repay to ensure accurate debt calculation
        INV-002: Repay can be on behalf of any obligation (repay_on_behalf)
        INV-003: Overpayment results in refund; excess treated as protocol donation
    end note

    note right of q_enforce_min
        INV-004: Remaining debt must meet min_borrow_amount or be zero (fully repaid)
        INV-005: Debt record removed from WitTable when debt cleared completely
    end note
