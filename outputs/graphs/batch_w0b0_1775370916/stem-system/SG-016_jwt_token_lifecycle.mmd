---
title: "jwt_token_lifecycle (stem-system: JWT Generation and Verification)"
---
stateDiagram-v2
    direction TB
    [*] --> q_generate: generateAccessToken(payload, clientId)
    q_generate --> q_build_claims: build claims (sub, display_name, discord_id, generation, status, scope, iss, aud, iat, exp)
    q_build_claims --> q_sign: jwt.sign(claims, JWT_SECRET, HS256)
    q_sign --> q_token_out: return signed JWT string
    q_token_out --> [*]: token issued

    state verify_flow {
        [*] --> q_verify_input: verifyAccessToken(token, clientId?)
        q_verify_input --> q_jwt_verify: jwt.verify(token, JWT_SECRET, algorithms=[HS256], issuer, audience)
        q_jwt_verify --> q_verify_fail: throws error
        q_jwt_verify --> q_extract: success
        q_verify_fail --> q_null: return null
        q_extract --> q_payload: extract sub, display_name, discord_id, generation, status, scope
        q_payload --> q_return: return JWTPayload
    }

    note right of q_build_claims
        INV-001: exp = iat + 30 days (TOKEN_EXPIRY.ACCESS_TOKEN = 2592000s)
        INV-002: iss = NEXT_PUBLIC_APP_URL or localhost:3000
        INV-003: aud = clientId of the requesting application
    end note

    note right of q_sign
        INV-004: JWT_SECRET defaults to 'your-secret-key-change-in-production' if env var missing
        INV-005: only HS256 algorithm is used for signing and verification
    end note
