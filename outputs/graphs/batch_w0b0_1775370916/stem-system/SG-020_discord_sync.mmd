---
title: "discord_sync (stem-system: Fire-and-Forget Discord Bot Sync)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_config: apiUrl AND token configured?
    q_check_config --> q_no_config: missing config
    q_check_config --> q_dispatch: configured

    q_no_config --> [*]: log error, return (no-op)

    state role_sync {
        [*] --> q_role_fetch: POST /api/roles/sync with discord_uid
        q_role_fetch --> q_role_ok: 2xx response
        q_role_fetch --> q_role_err: error or non-2xx
        q_role_ok --> [*]: log success
        q_role_err --> [*]: log error, swallow exception
    }

    state nickname_sync {
        [*] --> q_nick_fetch: POST /api/nickname/update with discord_uid and name
        q_nick_fetch --> q_nick_ok: 2xx response
        q_nick_fetch --> q_nick_err: error or non-2xx
        q_nick_ok --> [*]: log success
        q_nick_err --> [*]: log error, swallow exception
    }

    state sync_all {
        [*] --> q_sync_all_fetch: POST /api/roles/sync-all
        q_sync_all_fetch --> q_sync_result: parse JSON result
        q_sync_result --> q_sync_msg: build message (synced, failed, total)
        q_sync_msg --> [*]: return message
    }

    q_dispatch --> role_sync: syncDiscordRoles
    q_dispatch --> nickname_sync: syncDiscordNickname
    q_dispatch --> sync_all: syncAllDiscordRoles

    note right of q_dispatch
        INV-001: all Discord API calls are fire-and-forget (errors logged, never thrown)
        INV-002: Bearer token auth used for all Discord bot API calls
        INV-003: cache='no-store' prevents stale responses
    end note
