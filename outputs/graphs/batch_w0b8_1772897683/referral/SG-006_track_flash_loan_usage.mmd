---
title: "track_flash_loan_usage (protocol::referral)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: self, fee, referral_code, who, ctx
    q_validate --> q_error_invalid: !self.code_owner.contains(referral_code)
    q_validate --> q_calc: self.code_owner.contains(referral_code)
    q_error_invalid --> [*]: abort referral_invalid_referral_code()
    q_calc --> q_referee_split: initial_fee = fee.value(), referer = look_up_code_owner(referral_code)
    q_referee_split --> q_calc_remaining: referee_rebates_amount = initial_fee * referee_discount_bps / DENOMINATOR
    q_calc_remaining --> q_referee_balance: referee_rebates = fee.split(referee_rebates_amount, ctx).into_balance()
    q_referee_balance --> q_referrer_calc: fee_remaining = initial_fee - referee_rebates_amount
    q_referrer_calc --> q_referrer_split: referrer_rebates_amount = fee_remaining * referrer_discount_bps / DENOMINATOR
    q_referrer_split --> q_referrer_balance: referrer_rebates = fee.split(referrer_rebates_amount, ctx).into_balance()
    q_referrer_balance --> q_update_referee: self.update_user_rebate(who, referee_rebates)
    q_update_referee --> q_emit: emit ReferralRecordedEvent
    q_emit --> q_update_referrer: self.update_user_rebate(referer, referrer_rebates)
    q_update_referrer --> [*]: return fee

    note right of q_calc
        INV-001: referee_rebates_amount = initial_fee * referee_discount_bps / DENOMINATOR
        INV-002: referrer_rebates_amount = (initial_fee - referee_rebates_amount) * referrer_discount_bps / DENOMINATOR
        INV-003: Returned fee value = initial_fee - referee_rebates_amount - referrer_rebates_amount
        INV-004: Total rebates distributed never exceed initial_fee
        INV-005: referral_code must exist in code_owner table
    end note
