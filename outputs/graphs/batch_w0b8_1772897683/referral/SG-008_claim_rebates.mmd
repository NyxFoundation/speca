---
title: "claim_rebates (protocol::referral)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_pause: self, ctx
    q_check_pause --> q_error_paused: self.is_claim_paused
    q_check_pause --> q_get_sender: !self.is_claim_paused
    q_error_paused --> [*]: abort referral_claim_paused()
    q_get_sender --> q_check_records: sender = ctx.sender(), coin_type = type_name::with_defining_ids()
    q_check_records --> q_error_no_rebates: !self.user_rebates_records.contains(sender)
    q_check_records --> q_check_coin: self.user_rebates_records.contains(sender)
    q_error_no_rebates --> [*]: abort referral_no_rebates()
    q_check_coin --> q_error_no_token: !user_rebates.contains(coin_type)
    q_check_coin --> q_get_amount: user_rebates.contains(coin_type)
    q_error_no_token --> [*]: abort referral_rebate_no_token()
    q_get_amount --> q_check_zero: amount = *user_rebates.get(coin_type)
    q_check_zero --> q_error_zero: amount == 0
    q_check_zero --> q_remove: amount != 0
    q_error_zero --> [*]: abort referral_claim_zero_value_rebate()
    q_remove --> q_split: user_rebates.remove(coin_type)
    q_split --> [*]: balance.split(amount).into_coin(ctx)

    note right of q_check_records
        INV-001: Claims are blocked when is_claim_paused is true
        INV-002: User must have rebate records for the specific CoinType
        INV-003: Amount must be non-zero (sanity check)
        INV-004: After claim, the coin_type entry is removed from user records
        INV-005: Balance in self.rebates must have sufficient funds for split
    end note
