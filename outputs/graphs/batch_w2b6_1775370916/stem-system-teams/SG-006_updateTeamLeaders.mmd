---
title: "updateTeamLeaders (stem-system teams.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_auth: checkAdmin()
    q_auth --> q_fetch_old: oldLeaders = team_leaders.select(member_id).eq(team_id)
    q_auth --> q_error: checkAdmin throws
    q_fetch_old --> q_fetch_old_err: query error
    q_fetch_old --> q_delete_old: oldLeaderIds = oldLeaders.map(member_id)
    q_fetch_old_err --> q_error: throw
    q_delete_old --> q_delete_err: delete error
    q_delete_old --> q_check_new: team_leaders.delete().eq(team_id) success
    q_delete_err --> q_error: throw
    q_check_new --> q_insert_new: memberIds.length > 0
    q_check_new --> q_build_sync: memberIds.length == 0
    q_insert_new --> q_insert_err: insert error
    q_insert_new --> q_build_sync: insert success
    q_insert_err --> q_error: throw
    q_build_sync --> q_check_sync: idsToSync = union(oldLeaderIds, memberIds)
    q_check_sync --> q_query_members: idsToSync.length > 0
    q_check_sync --> q_revalidate: idsToSync.length == 0
    q_query_members --> q_query_err: query error
    q_query_members --> q_sync_loop: membersToSync fetched
    q_query_err --> q_error: throw
    q_sync_loop --> q_sync_iter: for member of membersToSync
    q_sync_iter --> q_sync_iter: syncDiscordRoles(member.discord_uid), next member
    q_sync_iter --> q_revalidate: all members synced
    q_revalidate --> [*]: revalidatePath, return error null
    q_error --> [*]: return error message

    note right of q_delete_old
        INV-001: Old leaders are deleted before new leaders are inserted (replace-all pattern)
        INV-002: Both old and new leader member IDs are synced with Discord
        INV-003: Discord sync uses union of old and new IDs to ensure removed leaders also get role updates
    end note

    note right of q_sync_loop
        INV-004: syncDiscordRoles is called sequentially (await in loop), not in parallel
        INV-005: syncDiscordRoles never throws, so one failed sync does not abort remaining syncs
    end note
