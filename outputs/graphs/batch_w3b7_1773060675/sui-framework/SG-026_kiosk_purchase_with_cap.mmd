---
title: "purchase_with_cap (Sui Framework: kiosk)"
---
stateDiagram-v2
    direction TB
    [*] --> q_destruct_cap: PurchaseCap(id, item_id, kiosk_id, min_price) destructured
    q_destruct_cap --> q_delete_cap_id: id.delete()
    q_delete_cap_id --> q_check_amount: paid = payment.value()
    q_check_amount --> q_abort_amount: paid < min_price
    q_abort_amount --> [*]: abort EIncorrectAmount
    q_check_amount --> q_check_kiosk: paid >= min_price
    q_check_kiosk --> q_abort_kiosk: object::id(self) != kiosk_id
    q_abort_kiosk --> [*]: abort EWrongKiosk
    q_check_kiosk --> q_remove_listing: correct kiosk
    q_remove_listing --> q_collect: df::remove(Listing(id, exclusive=true))
    q_collect --> q_profit: coin::put(self.profits, payment)
    q_profit --> q_dec_count: self.item_count - 1
    q_dec_count --> q_remove_lock: df::remove_if_exists(Lock)
    q_remove_lock --> q_get_item: dof::remove(Item)
    q_get_item --> [*]: return (item, TransferRequest)

    note right of q_check_amount
        INV-001: payment must be >= min_price (not exact match)
        INV-002: PurchaseCap is consumed (one-time use)
        INV-003: kiosk_id must match (prevents cross-kiosk attacks)
        INV-004: exclusive listing removed atomically
    end note
