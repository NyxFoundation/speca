---
title: "purchase (Sui Framework: kiosk)"
---
stateDiagram-v2
    direction TB
    [*] --> q_get_price: price = df::remove(Listing(id, exclusive=false))
    q_get_price --> q_get_item: inner = dof::remove(Item(id))
    q_get_item --> q_dec_count: self.item_count = self.item_count - 1
    q_dec_count --> q_check_price: assert price == payment.value()
    q_check_price --> q_abort_price: price != payment
    q_abort_price --> [*]: abort EIncorrectAmount
    q_check_price --> q_remove_lock: price matches
    q_remove_lock --> q_collect: df::remove_if_exists(Lock(id))
    q_collect --> q_profit: coin::put(self.profits, payment)
    q_profit --> q_emit: emit ItemPurchased event
    q_emit --> [*]: return (item, TransferRequest)

    note right of q_check_price
        INV-001: exact price match required (no overpayment)
        INV-002: payment goes to kiosk profits (not owner directly)
        INV-003: Lock removed on purchase (locked items can be sold)
        INV-004: TransferRequest hot potato must be resolved in TransferPolicy
        INV-005: item_count decremented atomically
    end note
