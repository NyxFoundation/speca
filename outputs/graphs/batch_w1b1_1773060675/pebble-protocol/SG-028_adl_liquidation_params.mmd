---
title: "ADL liquidation_ltv / liquidation_incentive (Pebble Protocol: Auto-Deleverage)"
---
stateDiagram-v2
    direction TB
    state ltv_flow {
        [*] --> q_calc_hours: hours = secs_since_activation / 3600
        q_calc_hours --> q_calc_reduction: reduction = hourly_drop * hours
        q_calc_reduction --> q_calc_ltv: ltv = liquidation_factor_base - reduction (saturating)
        q_calc_ltv --> [*]: return ltv
    }

    state incentive_flow {
        [*] --> q_calc_days: days = secs_since_activation / 86400
        q_calc_days --> q_calc_addon: add_on = daily_penalty * days
        q_calc_addon --> q_calc_incentive: incentive = incentive_base + add_on
        q_calc_incentive --> [*]: return incentive
    }

    note right of ltv_flow
        INV-001: liquidation_ltv decreases over time (more positions become liquidatable)
        INV-002: saturating_sub ensures ltv >= 0
        INV-003: lower ltv means easier to trigger liquidation
    end note

    note right of incentive_flow
        INV-004: liquidation_incentive increases over time (greater reward for liquidators)
        INV-005: ADL incentive capped by normal liquidation_incentive
        INV-006: ensures liquidators are attracted to deleverage positions
    end note
