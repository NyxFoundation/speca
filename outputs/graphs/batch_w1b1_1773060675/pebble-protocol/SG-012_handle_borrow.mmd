---
title: "handle_borrow (Pebble Protocol: Market Internal)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_amount: assert borrow_amount != 0
    q_check_amount --> q_load_asset: asset = assets.load_mut_by_type(name)
    q_load_asset --> q_check_paused: assert !borrow_paused
    q_check_paused --> q_get_config: load min_borrow_amount, max_borrow_amount
    q_get_config --> q_load_obligation: obligation = obligations.borrow_mut(obligation_id)
    q_load_obligation --> q_check_market: assert obligation.market_id() == self.id
    q_check_market --> q_rate_limit: emode.borrow_limiter.add_outflow(now, borrow_amount)
    q_rate_limit --> q_get_old_borrow: old_total_borrow = obligation old debt amount
    q_get_old_borrow --> q_refresh_interest: refresh_obligation_borrow_interest_with_new_borrow
    q_refresh_interest --> q_get_index: borrow_index = reserve.borrow_index().value()
    q_get_index --> q_try_borrow: obligation.try_borrow_asset(borrow_amount, borrow_index)
    q_try_borrow --> q_enforce_min: enforce_post_borrow_repay_invariant(min_borrow_amount)
    q_enforce_min --> q_update_emode: emode_group.update_asset_borrow(old, new)
    q_update_emode --> q_check_emode_limit: assert emode_total_borrow <= emode_max_borrow
    q_check_emode_limit --> q_safety_check: is_obligation_safe(oracle, registry, clock)
    q_safety_check --> q_error_unsafe: not safe
    q_error_unsafe --> [*]: abort obligation_not_safe
    q_safety_check --> q_reserve_borrow: reserve.borrow_amount(borrow_amount)
    q_reserve_borrow --> q_check_max: assert reserve.debt.ceil() <= max_borrow_amount
    q_check_max --> [*]: return (balance, borrow_index, total_borrow)

    note right of q_try_borrow
        INV-001: cannot borrow asset used as collateral in same obligation
        INV-002: first borrow initializes debt with current borrow_index
        INV-003: subsequent borrows accrue interest first then add amount
    end note

    note right of q_reserve_borrow
        INV-004: reserve must have enough cash minus reserves for borrow
        INV-005: total debt ceiling enforced at asset level
    end note
