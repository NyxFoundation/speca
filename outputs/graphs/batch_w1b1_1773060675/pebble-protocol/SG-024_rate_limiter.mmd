---
title: "add_outflow / reduce_outflow (Pebble Protocol: Rate Limiter)"
---
stateDiagram-v2
    direction TB
    state add_outflow_flow {
        [*] --> q_count: curr_outflow = count_current_outflow(now)
        q_count --> q_check_limit: assert curr_outflow + value <= outflow_limit
        q_check_limit --> q_get_segment: segment_index = (now / segment_duration) % num_segments
        q_get_segment --> q_check_stale: segment.index != timestamp_index?
        q_check_stale --> q_reset: yes, reset segment (index = timestamp_index, value = 0)
        q_check_stale --> q_no_reset: no, keep existing value
        q_reset --> q_add: segment.value += value
        q_no_reset --> q_add
        q_add --> [*]: return
    }

    state reduce_outflow_flow {
        [*] --> q_get_seg: segment_index = (now / segment_duration) % num_segments
        q_get_seg --> q_check_stale2: segment.index != timestamp_index?
        q_check_stale2 --> q_reset2: yes, reset segment
        q_check_stale2 --> q_no_reset2: no, keep existing
        q_reset2 --> q_reduce: segment.value = max(0, segment.value - reduced_value)
        q_no_reset2 --> q_reduce
        q_reduce --> [*]: return
    }

    note right of add_outflow_flow
        INV-001: outflow sum across cycle must not exceed outflow_limit
        INV-002: stale segments are auto-reset (sliding window)
        INV-003: cycle = cycle_duration / segment_duration segments
    end note

    note right of reduce_outflow_flow
        INV-004: reduce only affects current segment (not full cycle)
        INV-005: reduce uses saturating subtraction (floor at 0)
    end note
