---
title: "exchange_rate / util_rate (Pebble Protocol: Reserve)"
---
stateDiagram-v2
    direction TB
    state exchange_rate_flow {
        [*] --> q_check_supply: total_supply == 0?
        q_check_supply --> q_default: yes, return 1.0
        q_default --> [*]: return Decimal(1)
        q_check_supply --> q_calc_num: numerator = cash + debt - cash_reserve
        q_calc_num --> q_calc_den: denominator = total_supply
        q_calc_den --> q_div: exchange_rate = numerator / denominator
        q_div --> [*]: return exchange_rate
    }

    state util_rate_flow {
        [*] --> q_check_debt: debt.is_zero()?
        q_check_debt --> q_zero_util: yes, return 0.0
        q_zero_util --> [*]: return Decimal(0)
        q_check_debt --> q_calc_denom: denominator = cash + debt - cash_reserve
        q_calc_denom --> q_calc_util: util_rate = debt / denominator
        q_calc_util --> [*]: return util_rate
    }

    note right of exchange_rate_flow
        INV-001: exchange_rate >= 1.0 under normal conditions
        INV-002: exchange_rate increases as interest accrues
        INV-003: cash_reserve is excluded from depositor value
    end note

    note right of util_rate_flow
        INV-004: util_rate in range [0, 1] under normal conditions
        INV-005: util_rate = 0 when no borrows exist
    end note
