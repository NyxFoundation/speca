---
title: "borrow_amount / repay_amount (Pebble Protocol: Reserve)"
---
stateDiagram-v2
    direction TB
    state borrow_flow {
        [*] --> q_borrow_check: assert cash - cash_reserve.ceil() > amount
        q_borrow_check --> q_borrow_debt: debt = debt + amount
        q_borrow_debt --> q_borrow_withdraw: withdraw_underlying(amount)
        q_borrow_withdraw --> [*]: return Balance
    }

    state repay_flow {
        [*] --> q_repay_check: debt < repay_amount?
        q_repay_check --> q_overpay: yes (overpayment)
        q_repay_check --> q_normal_repay: no (normal repay)
        q_overpay --> q_clear_debt: cash_reserve += (repay - debt.ceil())
        q_clear_debt --> q_zero_debt: debt = 0
        q_zero_debt --> q_repay_deposit: deposit_underlying(coin)
        q_repay_deposit --> [*]: return
        q_normal_repay --> q_reduce_debt: debt = debt - repay_amount
        q_reduce_debt --> q_repay_deposit2: deposit_underlying(coin)
        q_repay_deposit2 --> [*]: return
    }

    note right of borrow_flow
        INV-001: available liquidity = cash - cash_reserve.ceil()
        INV-002: borrow must not exceed available liquidity
        INV-003: cash decreases by borrow amount
    end note

    note right of repay_flow
        INV-004: overpayment treated as donation to cash_reserve
        INV-005: cash increases by full repay amount
    end note
