---
title: "borrow_flash_loan (Pebble Protocol: Flash Loan)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: ensure_version_matches()
    q_version --> q_validate: validate_market(market)
    q_validate --> q_permission: ensure_has_permission(cap, flash_loan)
    q_permission --> q_inner: borrow_flash_loan_inner(market, amount, emode_group, ctx)
    q_inner --> q_circuit_break: check circuit_break
    q_circuit_break --> q_error_cb: circuit_break triggered
    q_error_cb --> [*]: abort market_under_circuit_break
    q_circuit_break --> q_check_paused: check flash_loan_paused
    q_check_paused --> q_error_paused: flash loan paused
    q_error_paused --> [*]: abort flash_loan_paused_for_asset
    q_check_paused --> q_check_ongoing: check flash_loan_ongoing
    q_check_ongoing --> q_error_ongoing: already ongoing
    q_error_ongoing --> [*]: abort flash_loan_ongoing
    q_check_ongoing --> q_lock: flash_loan_triggered()
    q_lock --> q_calc_fee: fee = flash_loan_fee_rate.int_mul(amount)
    q_calc_fee --> q_check_fee: fee != 0
    q_check_fee --> q_error_fee: fee == 0
    q_error_fee --> [*]: abort flash_loan_fee_too_small
    q_check_fee --> q_borrow_reserve: reserve.borrow_flash_loan(amount)
    q_borrow_reserve --> q_emit: emit BorrowFlashLoanEvent
    q_emit --> [*]: return (Coin, FlashLoan hot potato)

    note right of q_borrow_reserve
        INV-001: amount must be less than reserve cash
        INV-002: flash_loan_lock prevents re-entrancy
        INV-003: fee calculated from emode flash_loan_fee_rate
        INV-004: FlashLoan is a hot potato that must be consumed
    end note
