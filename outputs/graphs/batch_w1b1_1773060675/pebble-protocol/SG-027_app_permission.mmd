---
title: "ensure_has_permission / validate_market (Pebble Protocol: App)"
---
stateDiagram-v2
    direction TB
    state permission_flow {
        [*] --> q_get_whitelist: whitelist = borrow PackageWhitestKey
        q_get_whitelist --> q_check_contains: whitelist.contains(id)?
        q_check_contains --> q_error_not_listed: no
        q_error_not_listed --> [*]: abort caller_not_whitelisted
        q_check_contains --> q_get_perm: permission = whitelist.get(id)
        q_get_perm --> q_check_mask: mask = 1u32 << what
        q_check_mask --> q_check_bit: (permission & mask) != 0?
        q_check_bit --> q_error_no_perm: no
        q_error_no_perm --> [*]: abort caller_has_no_permission
        q_check_bit --> [*]: return (authorized)
    }

    state validate_market_flow {
        [*] --> q_check_registered: markets.contains(MarketType)?
        q_check_registered --> q_error_not_found: no
        q_error_not_found --> [*]: abort market_not_found
        q_check_registered --> q_check_id: markets[MarketType] == object::id(market)?
        q_check_id --> q_error_invalid: no
        q_error_invalid --> [*]: abort invalid_market
        q_check_id --> [*]: return (valid)
    }

    note right of permission_flow
        INV-001: permission is a bitmask (u32), each bit = one capability
        INV-002: PackageCallerCap ID must be in whitelist
        INV-003: specific permission bit must be set for the operation
    end note

    note right of validate_market_flow
        INV-004: MarketType must be registered in ProtocolApp
        INV-005: Market object ID must match registered ID (no spoofing)
    end note
