---
title: "borrow_flash_loan / repay_flash_loan (Pebble Protocol: Reserve)"
---
stateDiagram-v2
    direction TB
    state borrow_flash {
        [*] --> q_check_cash: assert amount < cash
        q_check_cash --> q_withdraw: flash_loan_withdraw(amount)
        q_withdraw --> [*]: return (Balance, ReserveFlashLoan hot_potato)
    }

    state repay_flash {
        [*] --> q_check_repay: assert coin.value() == original_amount
        q_check_repay --> q_join: underlying_balance.join(coin)
        q_join --> q_check_fee: fee.value() == 0?
        q_check_fee --> q_destroy_zero: yes, destroy_zero(fee)
        q_destroy_zero --> [*]: return
        q_check_fee --> q_add_reserve: no, increase_reserve_only(fee)
        q_add_reserve --> [*]: return
    }

    note right of borrow_flash
        INV-001: flash loan does NOT update cash or debt fields (temporary withdrawal)
        INV-002: amount must be strictly less than total cash
        INV-003: ReserveFlashLoan is a hot potato ensuring repayment in same tx
    end note

    note right of repay_flash
        INV-004: exact original amount must be returned
        INV-005: fee goes entirely to cash_reserve
        INV-006: flash_loan_withdraw bypasses cash -= amount tracking
    end note
