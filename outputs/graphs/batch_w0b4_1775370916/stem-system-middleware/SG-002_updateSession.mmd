---
title: "updateSession (stem-system middleware.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_init: supabaseResponse = NextResponse.next(request)
    q_init --> q_create_client: supabase = createServerClient(URL, ANON_KEY, cookieHandlers)
    q_create_client --> q_get_user: user = await supabase.auth.getUser()
    q_get_user --> q_check_public: isPublicPath = checkPublicPaths(pathname)

    q_check_public --> q_unauth_protected: !user and !isPublicPath
    q_check_public --> q_auth_login: user and pathname.startsWith("/login")
    q_check_public --> q_return_default: otherwise

    q_unauth_protected --> q_redirect_login: loginRedirect = redirect("/login")
    q_redirect_login --> q_copy_login: copySessionCookies(supabaseResponse, loginRedirect)
    q_copy_login --> [*]: return loginRedirect

    q_auth_login --> q_check_redirect: redirectParam = searchParams.get("redirect")
    q_check_redirect --> q_validate_redirect: redirectParam exists
    q_check_redirect --> q_redirect_dash: redirectParam is null

    q_validate_redirect --> q_parse_url: redirectUrl = new URL(redirectParam)
    q_parse_url --> q_origin_check: parse succeeded
    q_parse_url --> q_redirect_dash: parse threw (invalid URL)

    q_origin_check --> q_oauth_redirect: origin matches and pathname.startsWith("/oauth/")
    q_origin_check --> q_redirect_dash: origin mismatch or not /oauth/ path

    q_oauth_redirect --> q_copy_oauth: copySessionCookies(supabaseResponse, oauthRedirect)
    q_copy_oauth --> [*]: return oauthRedirect

    q_redirect_dash --> q_copy_dash: dashRedirect = redirect("/dashboard")
    q_copy_dash --> [*]: return dashRedirect

    q_return_default --> [*]: return supabaseResponse

    note right of q_check_public
        INV-001: Public paths are /login, /auth/callback, /oauth, /api
        INV-002: Unauthenticated users cannot reach non-public paths
    end note

    note right of q_validate_redirect
        INV-003: OAuth redirect only accepted if same origin AND /oauth/ prefix
        INV-004: Invalid redirect URLs fall through to dashboard redirect
    end note

    note right of q_redirect_login
        INV-005: Session cookies are always copied to redirect responses
        INV-006: Refreshed tokens propagate even on redirect
    end note

    note right of q_create_client
        INV-007: Cookie setAll handler propagates cookies to both request and response
        INV-008: supabaseResponse is reassigned on setAll to capture updated request cookies
    end note
