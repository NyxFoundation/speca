stateDiagram-v2
    direction TB
    [*] --> q_assert: assert not state._snapshots
    q_assert --> q_check: address in state._storage_tries
    q_check --> q_compute: address found
    q_check --> q_empty: address not found
    q_compute --> [*]: return root(state._storage_tries[address])
    q_empty --> [*]: return EMPTY_TRIE_ROOT
