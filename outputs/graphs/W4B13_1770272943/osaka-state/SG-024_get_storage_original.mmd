stateDiagram-v2
    direction TB
    [*] --> q_check_created: address in state.created_accounts
    q_check_created --> q_return_zero_created: address was created
    q_check_created --> q_get_snapshot: address not created
    q_return_zero_created --> [*]: return U256(0)
    q_get_snapshot --> q_get_trie: _, original_trie = state._snapshots[0]
    q_get_trie --> q_check_trie: original_account_trie = original_trie.get(address)
    q_check_trie --> q_zero: trie is None
    q_check_trie --> q_lookup: trie exists
    q_zero --> q_assert: original_value = U256(0)
    q_lookup --> q_assert: original_value = trie_get(original_account_trie, key)
    q_assert --> [*]: return original_value
