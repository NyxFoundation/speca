stateDiagram-v2
    direction TB
    [*] --> q_check_balance: sender.balance < amount
    q_check_balance --> q_error: balance insufficient
    q_check_balance --> q_reduce: balance sufficient
    q_error --> [*]: raise AssertionError
    q_reduce --> q_increase: sender.balance -= amount
    q_increase --> q_modify_recipient: modify_state(state, sender_address, reduce_sender_balance)
    q_modify_recipient --> [*]: modify_state(state, recipient_address, increase_recipient_balance)
