stateDiagram-v2
    direction TB
    [*] --> q_calc_cost: intrinsic_gas, calldata_floor = calculate_intrinsic_cost(tx)
    q_calc_cost --> q_check_gas: max(intrinsic_gas, calldata_floor) > tx.gas
    q_check_gas --> q_error_gas: gas insufficient
    q_check_gas --> q_check_nonce: gas sufficient
    q_error_gas --> [*]: raise InsufficientTransactionGasError
    q_check_nonce --> q_error_nonce: nonce >= U64.MAX_VALUE
    q_check_nonce --> q_check_initcode: nonce < U64.MAX_VALUE
    q_error_nonce --> [*]: raise NonceOverflowError
    q_check_initcode --> q_error_initcode: tx.to == Bytes0 and len(tx.data) > MAX_INIT_CODE_SIZE
    q_check_initcode --> q_check_gaslimit: not contract creation or data within limit
    q_error_initcode --> [*]: raise InitCodeTooLargeError
    q_check_gaslimit --> q_error_gaslimit: tx.gas > TX_MAX_GAS_LIMIT
    q_check_gaslimit --> q_return: tx.gas <= TX_MAX_GAS_LIMIT
    q_error_gaslimit --> [*]: raise TransactionGasLimitExceededError
    q_return --> [*]: return (intrinsic_gas, calldata_floor)
