stateDiagram-v2
    direction TB
    [*] --> q_check_legacy: isinstance(tx, LegacyTransaction)
    q_check_legacy --> q_return_legacy: tx is LegacyTransaction
    q_check_legacy --> q_check_access: tx is not LegacyTransaction
    q_return_legacy --> [*]: return tx
    q_check_access --> q_return_access: tx is AccessListTransaction
    q_check_access --> q_check_fee: tx is not AccessListTransaction
    q_return_access --> [*]: return b"\\x01" + rlp.encode(tx)
    q_check_fee --> q_return_fee: tx is FeeMarketTransaction
    q_check_fee --> q_check_blob: tx is not FeeMarketTransaction
    q_return_fee --> [*]: return b"\\x02" + rlp.encode(tx)
    q_check_blob --> q_return_blob: tx is BlobTransaction
    q_check_blob --> q_check_setcode: tx is not BlobTransaction
    q_return_blob --> [*]: return b"\\x03" + rlp.encode(tx)
    q_check_setcode --> q_return_setcode: tx is SetCodeTransaction
    q_check_setcode --> q_error: tx is unknown type
    q_return_setcode --> [*]: return b"\\x04" + rlp.encode(tx)
    q_error --> [*]: raise Exception
