stateDiagram-v2
    direction TB
    [*] --> q_count_zeros: zero_bytes = 0
    q_count_zeros --> q_iter_bytes: for byte in tx.data
    q_iter_bytes --> q_inc_zero: byte == 0
    q_iter_bytes --> q_iter_bytes: byte != 0
    q_inc_zero --> q_iter_bytes: zero_bytes += 1
    q_iter_bytes --> q_calc_tokens: iteration complete
    q_calc_tokens --> q_calc_floor: tokens = zero_bytes + (len(data) - zero_bytes) * 4
    q_calc_floor --> q_calc_data: calldata_floor = tokens * FLOOR_CALLDATA_COST + TX_BASE_COST
    q_calc_data --> q_check_create: data_cost = tokens * STANDARD_CALLDATA_TOKEN_COST
    q_check_create --> q_create_cost: tx.to == Bytes0
    q_check_create --> q_no_create: tx.to != Bytes0
    q_create_cost --> q_check_access_list: create_cost = TX_CREATE_COST + init_code_cost(len(tx.data))
    q_no_create --> q_check_access_list: create_cost = 0
    q_check_access_list --> q_iter_access: tx has access_list
    q_check_access_list --> q_check_auth: tx has no access_list
    q_iter_access --> q_acc_addr: for access in tx.access_list
    q_acc_addr --> q_acc_slots: cost += TX_ACCESS_LIST_ADDRESS_COST
    q_acc_slots --> q_iter_access: cost += len(slots) * TX_ACCESS_LIST_STORAGE_KEY_COST
    q_iter_access --> q_check_auth: access list iteration complete
    q_check_auth --> q_calc_auth: tx is SetCodeTransaction
    q_check_auth --> q_return: tx is not SetCodeTransaction
    q_calc_auth --> q_return: auth_cost = PER_EMPTY_ACCOUNT_COST * len(authorizations)
    q_return --> [*]: return (TX_BASE_COST + data_cost + create_cost + access_list_cost + auth_cost, calldata_floor)
