stateDiagram-v2
    direction TB
    [*] --> q_check_type: isinstance(tx, Bytes)
    q_check_type --> q_check_prefix: tx is Bytes
    q_check_type --> q_return_legacy: tx is LegacyTransaction
    q_return_legacy --> [*]: return tx
    q_check_prefix --> q_decode_access: tx[0] == 1
    q_check_prefix --> q_check_p2: tx[0] != 1
    q_decode_access --> [*]: return rlp.decode_to(AccessListTransaction, tx[1:])
    q_check_p2 --> q_decode_fee: tx[0] == 2
    q_check_p2 --> q_check_p3: tx[0] != 2
    q_decode_fee --> [*]: return rlp.decode_to(FeeMarketTransaction, tx[1:])
    q_check_p3 --> q_decode_blob: tx[0] == 3
    q_check_p3 --> q_check_p4: tx[0] != 3
    q_decode_blob --> [*]: return rlp.decode_to(BlobTransaction, tx[1:])
    q_check_p4 --> q_decode_setcode: tx[0] == 4
    q_check_p4 --> q_error: tx[0] is unknown
    q_decode_setcode --> [*]: return rlp.decode_to(SetCodeTransaction, tx[1:])
    q_error --> [*]: raise TransactionTypeError(tx[0])
