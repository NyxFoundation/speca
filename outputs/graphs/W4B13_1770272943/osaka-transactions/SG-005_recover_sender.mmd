stateDiagram-v2
    direction TB
    [*] --> q_extract_sig: r, s = tx.r, tx.s
    q_extract_sig --> q_check_r: 0 >= r or r >= SECP256K1N
    q_check_r --> q_error_r: r invalid
    q_check_r --> q_check_s: r valid
    q_error_r --> [*]: raise InvalidSignatureError("bad r")
    q_check_s --> q_error_s: 0 >= s or s > SECP256K1N / 2
    q_check_s --> q_dispatch: s valid
    q_error_s --> [*]: raise InvalidSignatureError("bad s")
    q_dispatch --> q_legacy_v: tx is LegacyTransaction
    q_dispatch --> q_access_parity: tx is AccessListTransaction
    q_dispatch --> q_fee_parity: tx is FeeMarketTransaction
    q_dispatch --> q_blob_parity: tx is BlobTransaction
    q_dispatch --> q_setcode_parity: tx is SetCodeTransaction
    q_legacy_v --> q_legacy_pre155: v == 27 or v == 28
    q_legacy_v --> q_legacy_155: v != 27 and v != 28
    q_legacy_pre155 --> q_compute_addr: recover(r, s, v-27, signing_hash_pre155(tx))
    q_legacy_155 --> q_check_chain: chain_id_x2 = chain_id * 2
    q_check_chain --> q_error_v: v != 35+chain_id_x2 and v != 36+chain_id_x2
    q_check_chain --> q_compute_addr: recover(r, s, v-35-chain_id_x2, signing_hash_155(tx, chain_id))
    q_error_v --> [*]: raise InvalidSignatureError("bad v")
    q_access_parity --> q_error_parity_a: y_parity not in (0, 1)
    q_access_parity --> q_compute_addr: recover(r, s, y_parity, signing_hash_2930(tx))
    q_error_parity_a --> [*]: raise InvalidSignatureError("bad y_parity")
    q_fee_parity --> q_error_parity_f: y_parity not in (0, 1)
    q_fee_parity --> q_compute_addr: recover(r, s, y_parity, signing_hash_1559(tx))
    q_error_parity_f --> [*]: raise InvalidSignatureError("bad y_parity")
    q_blob_parity --> q_error_parity_b: y_parity not in (0, 1)
    q_blob_parity --> q_compute_addr: recover(r, s, y_parity, signing_hash_4844(tx))
    q_error_parity_b --> [*]: raise InvalidSignatureError("bad y_parity")
    q_setcode_parity --> q_error_parity_s: y_parity not in (0, 1)
    q_setcode_parity --> q_compute_addr: recover(r, s, y_parity, signing_hash_7702(tx))
    q_error_parity_s --> [*]: raise InvalidSignatureError("bad y_parity")
    q_compute_addr --> [*]: return Address(keccak256(public_key)[12:32])
