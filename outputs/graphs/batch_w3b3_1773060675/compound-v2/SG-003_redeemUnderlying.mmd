---
title: "redeemUnderlying (Compound V2: cToken)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue: accrueInterest()
    q_accrue --> q_accrue_fail: accrueInterest failed
    q_accrue_fail --> [*]: return REDEEM_ACCRUE_INTEREST_FAILED
    q_accrue --> q_freshness: accrueInterest succeeded
    q_freshness --> q_stale: accrualBlockNumber != currentBlock
    q_stale --> [*]: return REDEEM_FRESHNESS_CHECK
    q_freshness --> q_exchange: accrualBlockNumber == currentBlock
    q_exchange --> q_exchange_fail: exchangeRate read failed
    q_exchange_fail --> [*]: return REDEEM_EXCHANGE_RATE_READ_FAILED
    q_exchange --> q_calc: exchangeRate = (getCash + totalBorrows - totalReserves) / totalSupply
    q_calc --> q_comptroller: redeemTokens = redeemAmount / exchangeRate
    q_comptroller --> q_reject: comptroller rejects
    q_reject --> [*]: return REDEEM_COMPTROLLER_REJECTION
    q_comptroller --> q_cash_check: redeemAllowed(cToken, redeemer, redeemTokens)
    q_cash_check --> q_no_cash: getCash < redeemAmount
    q_no_cash --> [*]: return REDEEM_TRANSFER_OUT_NOT_POSSIBLE
    q_cash_check --> q_update: getCash >= redeemAmount
    q_update --> q_transfer_out: totalSupply = totalSupply - redeemTokens; accountTokens[redeemer] -= redeemTokens
    q_transfer_out --> [*]: doTransferOut(redeemer, redeemAmount); emit Redeem(redeemer, redeemAmount, redeemTokens); return NO_ERROR

    note right of q_calc
        INV-001: redeemTokens = redeemAmount / exchangeRate (inverse of redeem)
        INV-002: Rounding of redeemTokens division may leave dust
        INV-003: getCash must be >= redeemAmount
    end note
