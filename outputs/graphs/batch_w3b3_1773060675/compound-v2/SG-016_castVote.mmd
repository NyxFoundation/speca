---
title: "castVote (Compound V2: Governor Bravo)"
---
stateDiagram-v2
    direction TB
    [*] --> q_state_check: proposalState = state(proposalId)
    q_state_check --> q_not_active: proposalState != Active
    q_not_active --> [*]: revert "voting is closed"
    q_state_check --> q_support_check: proposalState == Active
    q_support_check --> q_invalid_support: support > 2
    q_invalid_support --> [*]: revert "invalid vote type"
    q_support_check --> q_receipt_check: support in (0=against, 1=for, 2=abstain)
    q_receipt_check --> q_already_voted: receipt.hasVoted == true
    q_already_voted --> [*]: revert "voter already voted"
    q_receipt_check --> q_get_votes: receipt.hasVoted == false
    q_get_votes --> q_record: votes = comp.getPriorVotes(voter, proposal.startBlock)
    q_record --> q_for: support == 1
    q_for --> q_store: proposal.forVotes += votes
    q_record --> q_against: support == 0
    q_against --> q_store: proposal.againstVotes += votes
    q_record --> q_abstain: support == 2
    q_abstain --> q_store: proposal.abstainVotes += votes
    q_store --> [*]: receipt.hasVoted = true; receipt.support = support; receipt.votes = votes; emit VoteCast

    note right of q_get_votes
        INV-001: Voting weight from getPriorVotes at proposal startBlock
        INV-002: Cannot vote twice on same proposal
        INV-003: Vote types: 0=against, 1=for, 2=abstain
    end note

    note right of q_store
        INV-004: Voting weight is snapshot at proposal creation, not current balance
        INV-005: Prevents buying votes after proposal is created
    end note
