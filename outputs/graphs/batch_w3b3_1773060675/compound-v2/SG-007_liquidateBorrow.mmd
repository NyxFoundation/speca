---
title: "liquidateBorrow (Compound V2: cToken)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue_borrow: accrueInterest() on borrow market
    q_accrue_borrow --> q_accrue_fail_b: accrueInterest failed
    q_accrue_fail_b --> [*]: return LIQUIDATE_ACCRUE_BORROW_INTEREST_FAILED
    q_accrue_borrow --> q_accrue_collateral: accrueInterest succeeded
    q_accrue_collateral --> q_accrue_fail_c: accrueInterest on collateral failed
    q_accrue_fail_c --> [*]: return LIQUIDATE_ACCRUE_COLLATERAL_INTEREST_FAILED
    q_accrue_collateral --> q_freshness: both markets accrued
    q_freshness --> q_stale: either market not fresh
    q_stale --> [*]: return LIQUIDATE_FRESHNESS_CHECK
    q_freshness --> q_self_check: both markets fresh
    q_self_check --> q_self_liq: liquidator == borrower
    q_self_liq --> [*]: return LIQUIDATE_LIQUIDATOR_IS_BORROWER
    q_self_check --> q_amount_check: liquidator != borrower
    q_amount_check --> q_zero: repayAmount == 0
    q_zero --> [*]: return LIQUIDATE_CLOSE_AMOUNT_IS_ZERO
    q_amount_check --> q_max: repayAmount == uint(-1)
    q_max --> [*]: return LIQUIDATE_CLOSE_AMOUNT_IS_UINT_MAX
    q_amount_check --> q_comptroller: 0 < repayAmount < uint(-1)
    q_comptroller --> q_reject: comptroller rejects
    q_reject --> [*]: return LIQUIDATE_COMPTROLLER_REJECTION
    q_comptroller --> q_close_factor: liquidateBorrowAllowed(cTokenBorrowed, cTokenCollateral, liquidator, borrower, repayAmount)
    q_close_factor --> q_repay: repayAmount <= borrowBalance * closeFactor
    q_repay --> q_repay_fail: repayBorrowFresh failed
    q_repay_fail --> [*]: return LIQUIDATE_REPAY_BORROW_FRESH_FAILED
    q_repay --> q_seize_calc: repayBorrowFresh(liquidator, borrower, repayAmount) succeeded
    q_seize_calc --> q_seize_fail: seize calculation failed
    q_seize_fail --> [*]: return LIQUIDATE_COMPTROLLER_CALCULATE_AMOUNT_SEIZE_FAILED
    q_seize_calc --> q_seize: seizeTokens = repayAmount * liquidationIncentive * priceBorrowed / (priceCollateral * exchangeRate)
    q_seize --> q_seize_error: seize failed
    q_seize_error --> [*]: return LIQUIDATE_SEIZE error
    q_seize --> [*]: cTokenCollateral.seize(liquidator, borrower, seizeTokens); emit LiquidateBorrow; return NO_ERROR

    note right of q_close_factor
        INV-001: repayAmount <= borrowBalance * closeFactor (max liquidatable per tx)
        INV-002: borrower must have shortfall (negative liquidity) to be liquidatable
    end note

    note right of q_seize
        INV-003: seizeTokens includes liquidation incentive premium
        INV-004: liquidator cannot be the borrower (self-liquidation forbidden)
        INV-005: seizeTokens = repayAmount * liquidationIncentive * priceBorrowed / (priceCollateral * exchangeRate)
    end note
