---
title: "repayBorrow (Compound V2: cToken)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue: accrueInterest()
    q_accrue --> q_accrue_fail: accrueInterest failed
    q_accrue_fail --> [*]: return REPAY_BORROW_ACCRUE_INTEREST_FAILED
    q_accrue --> q_freshness: accrueInterest succeeded
    q_freshness --> q_stale: accrualBlockNumber != currentBlock
    q_stale --> [*]: return REPAY_BORROW_FRESHNESS_CHECK
    q_freshness --> q_comptroller: accrualBlockNumber == currentBlock
    q_comptroller --> q_reject: comptroller rejects
    q_reject --> [*]: return REPAY_BORROW_COMPTROLLER_REJECTION
    q_comptroller --> q_calc: repayBorrowAllowed(cToken, payer, borrower, repayAmount)
    q_calc --> q_max_check: accountBorrows = borrowBalanceStored(borrower)
    q_max_check --> q_actual_full: repayAmount == uint(-1)
    q_actual_full --> q_transfer_in: actualRepayAmount = accountBorrows
    q_max_check --> q_transfer_in: repayAmount != uint(-1); actualRepayAmount = repayAmount
    q_transfer_in --> q_transfer_fail: token transfer in failed
    q_transfer_fail --> [*]: return REPAY_BORROW_TRANSFER_IN_NOT_POSSIBLE
    q_transfer_in --> q_update: doTransferIn(payer, actualRepayAmount)
    q_update --> q_emit: accountBorrowsNew = accountBorrows - actualRepayAmount; totalBorrowsNew = totalBorrows - actualRepayAmount
    q_emit --> [*]: emit RepayBorrow(payer, borrower, actualRepayAmount, accountBorrowsNew, totalBorrowsNew); return NO_ERROR

    note right of q_max_check
        INV-001: repayAmount = uint(-1) means repay full borrow balance
        INV-002: actualRepayAmount <= accountBorrows (cannot overpay)
    end note

    note right of q_update
        INV-003: totalBorrows decreases by exactly actualRepayAmount
        INV-004: accountBorrows includes accrued interest via borrowIndex
    end note
