---
title: "mint (Compound V2: cToken)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue: accrueInterest()
    q_accrue --> q_accrue_fail: accrueInterest failed
    q_accrue_fail --> [*]: return MINT_ACCRUE_INTEREST_FAILED
    q_accrue --> q_comptroller: mintAllowed(cToken, minter, mintAmount)
    q_comptroller --> q_reject: comptroller rejects
    q_reject --> [*]: return MINT_COMPTROLLER_REJECTION
    q_comptroller --> q_freshness: comptroller allows
    q_freshness --> q_stale: accrualBlockNumber != currentBlock
    q_stale --> [*]: return MINT_FRESHNESS_CHECK
    q_freshness --> q_exchange: accrualBlockNumber == currentBlock
    q_exchange --> q_exchange_fail: exchangeRate calculation failed
    q_exchange_fail --> [*]: return MINT_EXCHANGE_CALCULATION_FAILED
    q_exchange --> q_transfer_in: exchangeRate = (getCash + totalBorrows - totalReserves) / totalSupply
    q_transfer_in --> q_transfer_fail: token transfer in failed
    q_transfer_fail --> [*]: return MINT_TRANSFER_IN_FAILED
    q_transfer_in --> q_calc: actualMintAmount = doTransferIn(minter, mintAmount)
    q_calc --> q_update: mintTokens = actualMintAmount / exchangeRate
    q_update --> q_emit: totalSupply = totalSupply + mintTokens; accountTokens[minter] = accountTokens[minter] + mintTokens
    q_emit --> [*]: emit Mint(minter, actualMintAmount, mintTokens); return NO_ERROR

    note right of q_exchange
        INV-001: exchangeRate = (getCash + totalBorrows - totalReserves) / totalSupply
        INV-002: totalSupply increases by exactly mintTokens
        INV-003: actualMintAmount may differ from mintAmount due to transfer fees
    end note

    note right of q_comptroller
        INV-004: Comptroller.mintAllowed must approve before any state change
    end note
