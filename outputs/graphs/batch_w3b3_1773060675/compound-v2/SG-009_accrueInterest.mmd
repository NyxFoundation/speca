---
title: "accrueInterest (Compound V2: cToken)"
---
stateDiagram-v2
    direction TB
    [*] --> q_block_check: currentBlockNumber = getBlockNumber()
    q_block_check --> q_noop: accrualBlockNumber == currentBlockNumber
    q_noop --> [*]: return NO_ERROR (already accrued this block)
    q_block_check --> q_borrow_rate: accrualBlockNumber != currentBlockNumber
    q_borrow_rate --> q_rate_fail: interestRateModel.getBorrowRate() fails
    q_rate_fail --> [*]: return INTEREST_RATE_MODEL_ERROR
    q_borrow_rate --> q_calc: borrowRateMantissa = getBorrowRate(getCash, totalBorrows, totalReserves)
    q_calc --> q_interest: blockDelta = currentBlockNumber - accrualBlockNumber
    q_interest --> q_apply: simpleInterestFactor = borrowRateMantissa * blockDelta
    q_apply --> q_update_borrows: interestAccumulated = simpleInterestFactor * totalBorrows
    q_update_borrows --> q_update_reserves: totalBorrowsNew = totalBorrows + interestAccumulated
    q_update_reserves --> q_update_index: totalReservesNew = totalReserves + interestAccumulated * reserveFactorMantissa
    q_update_index --> q_store: borrowIndexNew = borrowIndex + simpleInterestFactor * borrowIndex
    q_store --> [*]: accrualBlockNumber = currentBlockNumber; borrowIndex = borrowIndexNew; totalBorrows = totalBorrowsNew; totalReserves = totalReservesNew; return NO_ERROR

    note right of q_calc
        INV-001: borrowRate comes from interestRateModel based on utilization
        INV-002: Interest compounds per-block, not continuously
    end note

    note right of q_update_reserves
        INV-003: reserveFactor portion of interest goes to reserves
        INV-004: totalReserves += interestAccumulated * reserveFactor
        INV-005: borrowIndex scales all individual borrow balances
    end note

    note right of q_store
        INV-006: accrualBlockNumber updated to current block (freshness)
        INV-007: No interest accrued if no blocks have passed (idempotent same block)
    end note
