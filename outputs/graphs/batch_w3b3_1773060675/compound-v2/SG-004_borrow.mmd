---
title: "borrow (Compound V2: cToken)"
---
stateDiagram-v2
    direction TB
    [*] --> q_accrue: accrueInterest()
    q_accrue --> q_accrue_fail: accrueInterest failed
    q_accrue_fail --> [*]: return BORROW_ACCRUE_INTEREST_FAILED
    q_accrue --> q_freshness: accrueInterest succeeded
    q_freshness --> q_stale: accrualBlockNumber != currentBlock
    q_stale --> [*]: return BORROW_FRESHNESS_CHECK
    q_freshness --> q_comptroller: accrualBlockNumber == currentBlock
    q_comptroller --> q_reject: comptroller rejects
    q_reject --> [*]: return BORROW_COMPTROLLER_REJECTION
    q_comptroller --> q_cash_check: borrowAllowed(cToken, borrower, borrowAmount)
    q_cash_check --> q_no_cash: getCash < borrowAmount
    q_no_cash --> [*]: return BORROW_CASH_NOT_AVAILABLE
    q_cash_check --> q_calc: getCash >= borrowAmount
    q_calc --> q_update: accountBorrowsNew = accountBorrows + borrowAmount; totalBorrowsNew = totalBorrows + borrowAmount
    q_update --> q_transfer_out: accountBorrows[borrower] = accountBorrowsNew; totalBorrows = totalBorrowsNew
    q_transfer_out --> [*]: doTransferOut(borrower, borrowAmount); emit Borrow(borrower, borrowAmount, accountBorrowsNew, totalBorrowsNew); return NO_ERROR

    note right of q_comptroller
        INV-001: Comptroller checks account liquidity allows new borrow
        INV-002: Market must be entered before borrowing
        INV-003: borrowAmount must not exceed account liquidity
    end note

    note right of q_calc
        INV-004: totalBorrows increases by exactly borrowAmount
        INV-005: accountBorrows includes accrued interest via borrowIndex
    end note
