---
title: "borrow_flash_loan (Current Finance: Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: ensure_version_matches()
    q_version --> q_validate: validate_market()
    q_validate --> q_permission: ensure_has_permission(cap, flash_loan)
    q_permission --> q_check_paused: flash_loan_paused()
    q_check_paused --> q_error_paused: flash_loan_paused == true
    q_check_paused --> q_check_ongoing: flash_loan_paused == false
    q_error_paused --> [*]: abort flash_loan_paused_for_asset
    q_check_ongoing --> q_error_ongoing: flash_loan_ongoing == true
    q_check_ongoing --> q_trigger_lock: flash_loan_ongoing == false
    q_error_ongoing --> [*]: abort flash_loan_ongoing
    q_trigger_lock --> q_circuit: asset.flash_loan_triggered()
    q_circuit --> q_error_cb: circuit_break == true
    q_circuit --> q_get_fee: circuit_break == false
    q_error_cb --> [*]: abort market_under_circuit_break
    q_get_fee --> q_check_fee: fee = flash_loan_fee_rate * amount
    q_check_fee --> q_error_fee: fee == 0
    q_check_fee --> q_borrow: fee > 0
    q_error_fee --> [*]: abort reserve_flash_loan_fee_too_small
    q_borrow --> q_check_cash: reserve.borrow_flash_loan(amount)
    q_check_cash --> q_error_cash: amount >= cash
    q_check_cash --> q_split: amount < cash
    q_error_cash --> [*]: abort reserve_flash_loan_more_than_cash
    q_split --> q_emit: split balance from underlying
    q_emit --> [*]: return (Coin, FlashLoan hot potato)

    note right of q_trigger_lock
        INV-001: flash_loan_lock prevents reentrancy (only one flash loan at a time per asset)
        INV-002: flash loan fee rate is per emode group
        INV-003: fee must be > 0 (prevents zero-fee exploits)
        INV-004: flash loan amount < total cash (not <=)
        INV-005: flash loan does NOT update debt or borrow_index
        INV-006: FlashLoan is a hot potato (must be consumed in same transaction)
    end note
