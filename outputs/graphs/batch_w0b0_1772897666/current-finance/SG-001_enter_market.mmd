---
title: "enter_market (Current Finance: Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: ensure_version_matches()
    q_version --> q_validate: validate_market()
    q_validate --> q_emode_check: assert_emode_group_exists(emode_group)
    q_emode_check --> q_circuit: has_circuit_break_triggered()
    q_circuit --> q_error_cb: circuit_break == true
    q_circuit --> q_create_obligation: circuit_break == false
    q_error_cb --> [*]: abort market_under_circuit_break
    q_create_obligation --> q_store: obligation::new(market_id, emode_group)
    q_store --> q_add_to_market: market.handle_new_obligation(obligation)
    q_add_to_market --> q_emit: emit ObligationCreatedEvent
    q_emit --> [*]: return obligation_owner_cap

    note right of q_create_obligation
        INV-001: obligation.lending_market_id == market.id
        INV-002: obligation.emode_group must exist in registry
        INV-003: market operations blocked when circuit_break == true
    end note
