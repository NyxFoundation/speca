---
title: "deposit (Current Finance: Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: ensure_version_matches()
    q_version --> q_validate: validate_market()
    q_validate --> q_circuit: has_circuit_break_triggered()
    q_circuit --> q_error_cb: circuit_break == true
    q_circuit --> q_timestamp: circuit_break == false
    q_error_cb --> [*]: abort market_under_circuit_break
    q_timestamp --> q_handle_mint: now = clock.timestamp_ms() / 1000
    q_handle_mint --> q_check_zero: coin.value() != 0
    q_check_zero --> q_error_zero: coin.value() == 0
    q_check_zero --> q_check_paused: coin.value() > 0
    q_error_zero --> [*]: abort no_zero_amount
    q_check_paused --> q_error_paused: deposit_paused == true
    q_check_paused --> q_accrue: deposit_paused == false
    q_error_paused --> [*]: abort deposit_paused_for_asset
    q_accrue --> q_check_limit: accrue_interest(reserve, now)
    q_check_limit --> q_error_limit: deposit_limit_breached == true
    q_check_limit --> q_mint: deposit_limit_breached == false
    q_error_limit --> [*]: abort market_deposit_limit_exceeded
    q_mint --> q_deposit_ctoken: reserve.mint_ctokens(coin)
    q_deposit_ctoken --> q_check_market: obligation.deposit_ctoken(ctoken)
    q_check_market --> q_error_market: obligation.market_id != market.id
    q_check_market --> q_check_borrow_col: obligation.market_id == market.id
    q_error_market --> [*]: abort obligation_from_different_market
    q_check_borrow_col --> q_error_borrow_col: debts contains CoinType
    q_check_borrow_col --> q_reduce_limiter: debts not contain CoinType
    q_error_borrow_col --> [*]: abort obligation_deposit_borrowed_asset
    q_reduce_limiter --> q_update_mining: emode.deposit_limiter.reduce_outflow(now, amount)
    q_update_mining --> q_emit: update_obligation_reward_manager()
    q_emit --> [*]: emit DepositEvent

    note right of q_deposit_ctoken
        INV-001: Cannot deposit an asset that is already borrowed by same obligation
        INV-002: ctoken_amount = deposit_amount / exchange_rate
        INV-003: exchange_rate = (cash + borrows - reserves) / total_supply
        INV-004: total_deposit + deposit_amount <= max_deposit_amount
    end note
