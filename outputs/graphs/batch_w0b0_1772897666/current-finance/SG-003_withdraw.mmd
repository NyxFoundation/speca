---
title: "withdraw (Current Finance: Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate: validate_market(), ensure_version_matches()
    q_validate --> q_circuit: has_circuit_break_triggered()
    q_circuit --> q_error_cb: circuit_break == true
    q_circuit --> q_timestamp: circuit_break == false
    q_error_cb --> [*]: abort market_under_circuit_break
    q_timestamp --> q_check_zero: now = clock.timestamp_ms() / 1000
    q_check_zero --> q_error_zero: ctoken_amount == 0
    q_check_zero --> q_check_paused: ctoken_amount > 0
    q_error_zero --> [*]: abort no_zero_amount
    q_check_paused --> q_error_paused: withdraw_paused == true
    q_check_paused --> q_check_market: withdraw_paused == false
    q_error_paused --> [*]: abort withdraw_paused_for_asset
    q_check_market --> q_error_market: obligation.market_id != market.id
    q_check_market --> q_refresh: obligation.market_id == market.id
    q_error_market --> [*]: abort obligation_from_different_market
    q_refresh --> q_withdraw_ctokens: refresh_obligation_assets_interest(now)
    q_withdraw_ctokens --> q_safety_check: obligation.withdraw_ctokens(ctoken_amount)
    q_safety_check --> q_error_unsafe: is_obligation_safe == false
    q_safety_check --> q_burn: is_obligation_safe == true
    q_error_unsafe --> [*]: abort obligation_not_safe_after_operation
    q_burn --> q_add_limiter: reserve.burn_ctokens(ctokens)
    q_add_limiter --> q_try_stop_adl: emode.deposit_limiter.add_outflow(now, amount)
    q_try_stop_adl --> q_update_mining: try_stop_collateral_deleverage()
    q_update_mining --> q_emit: update_obligation_reward_manager()
    q_emit --> [*]: return Coin

    note right of q_safety_check
        INV-001: weighted_debt_value <= collateral_weighted_value after withdrawal
        INV-002: withdraw_amount = ctoken_amount * exchange_rate
        INV-003: cash >= cash_reserve after withdrawal
        INV-004: deposit outflow rate limit enforced per emode group
    end note
