---
title: "borrow (Current Finance: Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: ensure_version_matches()
    q_version --> q_validate: validate_market()
    q_validate --> q_circuit: has_circuit_break_triggered()
    q_circuit --> q_error_cb: circuit_break == true
    q_circuit --> q_timestamp: circuit_break == false
    q_error_cb --> [*]: abort market_under_circuit_break
    q_timestamp --> q_check_zero: now = clock.timestamp_ms() / 1000
    q_check_zero --> q_error_zero: borrow_amount == 0
    q_check_zero --> q_check_paused: borrow_amount > 0
    q_error_zero --> [*]: abort no_zero_amount
    q_check_paused --> q_error_paused: borrow_paused == true
    q_check_paused --> q_check_market: borrow_paused == false
    q_error_paused --> [*]: abort borrow_paused_for_asset
    q_check_market --> q_error_market: obligation.market_id != market.id
    q_check_market --> q_rate_limit: obligation.market_id == market.id
    q_error_market --> [*]: abort obligation_from_different_market
    q_rate_limit --> q_error_rate: outflow exceeds limit
    q_rate_limit --> q_refresh: outflow within limit
    q_error_rate --> [*]: abort outflow_reach_limit_error
    q_refresh --> q_try_borrow: refresh_obligation_borrow_interest(now)
    q_try_borrow --> q_check_collateral: obligation.try_borrow_asset(amount, borrow_index)
    q_check_collateral --> q_error_col_borrow: CoinType is collateral of obligation
    q_check_collateral --> q_enforce_min: CoinType not collateral
    q_error_col_borrow --> [*]: abort obligation_borrow_collateral_asset
    q_enforce_min --> q_error_min: debt < min_borrow_amount
    q_enforce_min --> q_emode_limit: debt >= min_borrow_amount
    q_error_min --> [*]: abort obligation_borrow_below_min
    q_emode_limit --> q_error_emode: emode_group_total_borrow > max_borrow_amount
    q_emode_limit --> q_safety: emode_group_total_borrow <= max_borrow_amount
    q_error_emode --> [*]: abort emode_borrow_limit_exceeded
    q_safety --> q_error_unsafe: is_obligation_safe == false
    q_safety --> q_reserve_borrow: is_obligation_safe == true
    q_error_unsafe --> [*]: abort obligation_not_safe_after_operation
    q_reserve_borrow --> q_check_max: reserve.borrow_amount(amount)
    q_check_max --> q_error_max: reserve.debt > max_borrow_amount
    q_check_max --> q_update_mining: reserve.debt <= max_borrow_amount
    q_error_max --> [*]: abort market_borrow_limit_exceeded
    q_update_mining --> q_emit: update_obligation_reward_manager()
    q_emit --> [*]: return Coin

    note right of q_safety
        INV-001: Cannot borrow asset used as own collateral
        INV-002: weighted_debt_value <= collateral_weighted_value after borrow
        INV-003: debt >= min_borrow_amount (prevents dust borrows)
        INV-004: emode group total borrow <= emode max_borrow_amount
        INV-005: reserve total debt <= asset max_borrow_amount
        INV-006: cash - cash_reserve > borrow_amount (liquidity check)
        INV-007: borrow outflow rate limit enforced per emode group
    end note
