---
title: "repay_flash_loan (Current Finance: Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: ensure_version_matches()
    q_version --> q_validate: validate_market()
    q_validate --> q_check_ongoing: asset.flash_loan_ongoing()
    q_check_ongoing --> q_error_not_ongoing: flash_loan_ongoing == false
    q_check_ongoing --> q_unlock: flash_loan_ongoing == true
    q_error_not_ongoing --> [*]: abort flash_loan_not_ongoing
    q_unlock --> q_check_amount: asset.flash_loan_finished()
    q_check_amount --> q_error_amount: coin.value() != loan.amount + loan.fee
    q_check_amount --> q_split_fee: coin.value() == loan.amount + loan.fee
    q_error_amount --> [*]: abort reserve_flash_loan_not_paid_enough
    q_split_fee --> q_check_referral: fee_coin = coin.split(fee)
    q_check_referral --> q_has_referral: maybe_referral_code is some
    q_check_referral --> q_repay_reserve: maybe_referral_code is none
    q_has_referral --> q_track_referral: referral.track_flash_loan_usage(fee_coin, code)
    q_track_referral --> q_check_fee_after: fee_coin reduced by referral rebate
    q_check_fee_after --> q_error_zero_fee: fee_coin.value() == 0 after rebate
    q_check_fee_after --> q_repay_reserve: fee_coin.value() > 0 after rebate
    q_error_zero_fee --> [*]: abort reserve_flash_loan_fee_too_small
    q_repay_reserve --> q_check_repay: reserve.repay_flash_loan(loan, coin, fee_coin)
    q_check_repay --> q_error_repay: coin.value() != loan.amount
    q_check_repay --> q_deposit: coin.value() == loan.amount
    q_error_repay --> [*]: abort reserve_flash_loan_not_paid_enough
    q_deposit --> q_fee_handling: underlying_balance.join(coin)
    q_fee_handling --> q_zero_fee: fee_coin.value() == 0
    q_fee_handling --> q_add_reserve: fee_coin.value() > 0
    q_zero_fee --> [*]: fee_coin.destroy_zero()
    q_add_reserve --> [*]: cash_reserve += fee, cash += fee

    note right of q_unlock
        INV-001: flash_loan_lock released (reentrancy guard cleared)
        INV-002: exact repay amount required (loan.amount + fee)
        INV-003: fee goes to cash_reserve (protocol revenue)
        INV-004: referral rebate cannot reduce fee to zero
        INV-005: hot potato FlashLoan consumed (destroyed)
    end note
