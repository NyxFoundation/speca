---
title: "updateMemberAdmin (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_admin: checkAdmin()
    q_admin --> q_init: admin verified
    q_init --> q_validate: profileAdminUpdateSchema.safeParse(values)
    q_validate --> q_check_valid: parsedData.success?
    q_check_valid --> q_err_valid: !success
    q_err_valid --> [*]: return error (first validation error)
    q_check_valid --> q_prepare: success
    q_prepare --> q_build_name: fullName = (last_name + first_name).replace whitespace
    q_build_name --> q_get_user: supabaseAdmin.auth.admin.getUserById(userId)
    q_get_user --> q_check_get: getUserError?
    q_check_get --> q_err_get: error
    q_err_get --> [*]: return error "failed to get user info"
    q_check_get --> q_update_meta: OK
    q_update_meta --> q_meta: supabaseAdmin.auth.admin.updateUserById(userId, metadata with name)
    q_meta --> q_check_meta: userUpdateError?
    q_check_meta --> q_err_meta: error
    q_err_meta --> [*]: return error "failed to update metadata"
    q_check_meta --> q_ensure_gen: OK
    q_ensure_gen --> q_role: ensureGenerationRoleExists(generation)
    q_role --> q_update_member: members.update(generation, student_number, status).eq(userId)
    q_update_member --> q_check_member: memberUpdateError?
    q_check_member --> q_err_member: error
    q_err_member --> [*]: return error "failed to update member table"
    q_check_member --> q_delete_teams: OK
    q_delete_teams --> q_del: member_team_relations.delete().eq(member_id, userId)
    q_del --> q_check_del: deleteTeamsError?
    q_check_del --> q_err_del: error
    q_err_del --> [*]: return error "failed to delete team relations"
    q_check_del --> q_insert_teams: team_ids exist and length > 0
    q_insert_teams --> q_ins: member_team_relations.insert(newRelations)
    q_check_del --> q_discord: no team_ids
    q_ins --> q_check_ins: insertTeamsError?
    q_check_ins --> q_err_ins: error
    q_err_ins --> [*]: return error "failed to update teams"
    q_check_ins --> q_discord: OK
    q_discord --> q_nick: syncDiscordNickname(provider_id, fullName)
    q_nick --> q_roles: syncDiscordRoles(provider_id)
    q_roles --> q_revalidate: revalidatePath(/admin/members)
    q_revalidate --> [*]: return error = null

    note right of q_admin
        INV-001: Requires admin privileges (checkAdmin throws on failure)
    end note

    note right of q_delete_teams
        INV-002: Team relations are replaced atomically (delete all, then insert new)
    end note

    note right of q_update_member
        INV-003: Admin can modify generation, student_number, and status for any member
    end note
