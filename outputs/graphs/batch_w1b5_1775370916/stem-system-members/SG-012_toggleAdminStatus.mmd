---
title: "toggleAdminStatus (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_init: supabase = createClient()
    q_init --> q_auth: user = supabase.auth.getUser()
    q_auth --> q_check_auth: user exists?
    q_check_auth --> q_err_auth: !user
    q_err_auth --> [*]: return error "authentication required"
    q_check_auth --> q_query_admin: user exists
    q_query_admin --> q_select: admin = members.select(is_admin).eq(user.id)
    q_select --> q_check_admin: admin.is_admin?
    q_check_admin --> q_err_admin: !admin.is_admin
    q_err_admin --> [*]: return error "admin privileges required"
    q_check_admin --> q_check_self: admin.is_admin
    q_check_self --> q_err_self: user.id == userId (targeting self)
    q_err_self --> [*]: return error "cannot change own admin status"
    q_check_self --> q_toggle: user.id != userId
    q_toggle --> q_update: members.update(is_admin = !currentStatus).eq(userId)
    q_update --> q_check_update: error?
    q_check_update --> q_err_update: error
    q_err_update --> [*]: return error "failed to update admin status"
    q_check_update --> q_revalidate: OK
    q_revalidate --> [*]: return error = null

    note right of q_check_self
        INV-001: Admin cannot modify their own admin status (self-protection)
    end note

    note right of q_toggle
        INV-002: Toggle inverts the current boolean status (!currentStatus)
    end note

    note right of q_check_admin
        INV-003: Admin check is performed inline (not via checkAdmin helper)
    end note
