---
title: "updateMemberTeams (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_init: supabase = createClient()
    q_init --> q_auth: user = supabase.auth.getUser()
    q_auth --> q_check_auth: user exists?
    q_check_auth --> q_err_auth: !user
    q_err_auth --> [*]: return error "authentication required"
    q_check_auth --> q_query_admin: user exists
    q_query_admin --> q_check_admin: admin.is_admin?
    q_check_admin --> q_err_admin: !admin.is_admin
    q_err_admin --> [*]: return error "admin privileges required"
    q_check_admin --> q_delete: admin.is_admin
    q_delete --> q_del_rel: member_team_relations.delete().eq(member_id, memberId)
    q_del_rel --> q_check_del: deleteError?
    q_check_del --> q_err_del: error
    q_err_del --> [*]: return error (thrown)
    q_check_del --> q_check_teams: OK
    q_check_teams --> q_insert: teamIds.length > 0
    q_insert --> q_ins: member_team_relations.insert(newRelations)
    q_ins --> q_check_ins: insertError?
    q_check_ins --> q_err_ins: error
    q_err_ins --> [*]: return error (thrown)
    q_check_ins --> q_sync: OK
    q_check_teams --> q_sync: teamIds empty
    q_sync --> q_get_member: members.select(discord_uid).eq(memberId)
    q_get_member --> q_check_member: member found?
    q_check_member --> q_discord: member found
    q_discord --> q_roles: syncDiscordRoles(member.discord_uid)
    q_check_member --> q_revalidate: no member
    q_roles --> q_revalidate: done
    q_revalidate --> [*]: return error = null

    note right of q_delete
        INV-001: Team relations are replaced atomically (delete all, then insert new)
    end note

    note right of q_sync
        INV-002: Discord roles are synced after team change to reflect new team roles
    end note
