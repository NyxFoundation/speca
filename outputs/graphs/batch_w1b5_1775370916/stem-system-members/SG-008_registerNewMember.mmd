---
title: "registerNewMember (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_init: supabase = createClient(), supabaseAdmin = createAdminClient()
    q_init --> q_auth: user = supabase.auth.getUser()
    q_auth --> q_check_auth: user exists?
    q_check_auth --> q_err_auth: !user
    q_err_auth --> [*]: return error "login required"
    q_check_auth --> q_dup_check: user exists
    q_dup_check --> q_select_existing: query members where user_id and deleted_at is null
    q_select_existing --> q_check_dup: existingMember found?
    q_check_dup --> q_err_dup: existingMember exists
    q_err_dup --> [*]: return error "already registered"
    q_check_dup --> q_validate: no existing member
    q_validate --> q_parse: registerSchema.safeParse(values)
    q_parse --> q_check_valid: parsedData.success?
    q_check_valid --> q_err_valid: !success
    q_err_valid --> [*]: return error (first validation error)
    q_check_valid --> q_calc_gen: success
    q_calc_gen --> q_gen_obog: status == 2 (OB/OG)
    q_gen_obog --> q_gen_set: finalGeneration = directGeneration
    q_calc_gen --> q_gen_student: status == 0 or 1
    q_gen_student --> q_gen_set: finalGeneration = calculateGeneration(status, grade, academicYear)
    q_gen_set --> q_check_gen: finalGeneration != null?
    q_check_gen --> q_err_gen: finalGeneration == null
    q_err_gen --> [*]: return error "cannot calculate generation"
    q_check_gen --> q_prepare: finalGeneration valid
    q_prepare --> q_ensure_role: ensureGenerationRoleExists(finalGeneration)
    q_ensure_role --> q_insert: members.insert(user data with generation, status, discord info)
    q_insert --> q_check_insert: insert successful?
    q_check_insert --> q_err_insert: memberInsertError
    q_err_insert --> [*]: return error "failed to create member"
    q_check_insert --> q_update_meta: insert OK
    q_update_meta --> q_admin_update: supabaseAdmin.auth.admin.updateUserById(metadata with name)
    q_admin_update --> q_teams: check team_ids
    q_teams --> q_insert_teams: team_ids.length > 0
    q_insert_teams --> q_sync: member_team_relations.insert(relations)
    q_teams --> q_sync: no team_ids
    q_sync --> q_discord_nick: syncDiscordNickname(discord_uid, fullName)
    q_discord_nick --> q_discord_roles: syncDiscordRoles(discord_uid)
    q_discord_roles --> q_revalidate: revalidatePath(/dashboard, /admin/members)
    q_revalidate --> [*]: return error = null

    note right of q_check_auth
        INV-001: User must be authenticated to register
    end note

    note right of q_check_dup
        INV-002: Duplicate check only considers non-deleted members (deleted_at is null)
    end note

    note right of q_calc_gen
        INV-003: OB/OG members provide generation directly; students have it calculated
    end note

    note right of q_prepare
        INV-004: fullName = (last_name + first_name) with whitespace stripped
    end note

    note right of q_insert
        INV-005: New members always have is_admin = false
    end note
