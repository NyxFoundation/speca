---
title: "getAllMemberNames (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_env: apiUrl = env.STEM_BOT_API_URL, token = env.BEARER_TOKEN
    q_env --> q_check: apiUrl and token defined?
    q_check --> q_null_early: !apiUrl or !token
    q_null_early --> [*]: return null
    q_check --> q_fetch: both defined
    q_fetch --> q_get: fetch GET /api/members
    q_get --> q_check_res: response received
    q_check_res --> q_error_res: !response.ok
    q_error_res --> [*]: return null
    q_check_res --> q_parse: response.ok
    q_parse --> q_validate: data = response.json()
    q_validate --> q_invalid: !data.success or !Array.isArray(data.data)
    q_invalid --> [*]: return null
    q_validate --> q_reduce: data valid
    q_reduce --> q_build_map: nameMap = data.data.reduce(uid to name)
    q_build_map --> [*]: return nameMap
    q_get --> q_catch: fetch throws exception
    q_catch --> [*]: return null

    note right of q_validate
        INV-001: API response must have success=true and data as array
    end note

    note right of q_build_map
        INV-002: nameMap keys are Discord UIDs, values are display names
    end note
