---
title: "checkAdmin (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_create: supabase = createClient()
    q_create --> q_getuser: user = supabase.auth.getUser()
    q_getuser --> q_check_auth: user exists?
    q_check_auth --> q_error_auth: !user
    q_error_auth --> [*]: throw "Authentication required"
    q_check_auth --> q_query_admin: user exists
    q_query_admin --> q_select: admin = members.select(is_admin).eq(user.id)
    q_select --> q_check_admin: admin.is_admin?
    q_check_admin --> q_error_admin: !admin.is_admin
    q_error_admin --> [*]: throw "Administrator privileges required"
    q_check_admin --> [*]: admin.is_admin (return void)

    note right of q_check_auth
        INV-001: User must be authenticated before admin check
    end note

    note right of q_check_admin
        INV-002: Admin status is determined solely by is_admin flag in members table
    end note
