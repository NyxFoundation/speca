---
title: "updateStatusesForNewAcademicYear (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_admin: checkAdmin()
    q_admin --> q_validate: highSchoolFirstYearGeneration > 0?
    q_validate --> q_err_val: !valid or <= 0
    q_err_val --> [*]: return error "specify valid generation"
    q_validate --> q_calc: valid
    q_calc --> q_gen: compute HS generations [gen, gen-1, gen-2] and JHS generations [gen+1, gen+2, gen+3]
    q_gen --> q_count: supabase.members.select(count).is(deleted_at, null)
    q_count --> q_update_hs: update members SET status=1 WHERE generation IN highSchoolGenerations
    q_update_hs --> q_check_hs: hsError?
    q_check_hs --> q_err_hs: error
    q_err_hs --> [*]: return error "failed to update HS"
    q_check_hs --> q_update_jhs: OK
    q_update_jhs --> q_jhs: update members SET status=0 WHERE generation IN juniorHighGenerations
    q_jhs --> q_check_jhs: jhsError?
    q_check_jhs --> q_err_jhs: error
    q_err_jhs --> [*]: return error "failed to update JHS"
    q_check_jhs --> q_update_ob: OK
    q_update_ob --> q_ob: update members SET status=2 WHERE generation NOT IN allStudentGenerations
    q_ob --> q_check_ob: obError?
    q_check_ob --> q_err_ob: error
    q_err_ob --> [*]: return error "failed to update OB/OG"
    q_check_ob --> q_sync: OK
    q_sync --> q_sync_all: syncAllDiscordRoles()
    q_sync_all --> q_revalidate: revalidatePath(/admin/members)
    q_revalidate --> [*]: return message "updated all N members"

    note right of q_calc
        INV-001: HS 1st year = gen, 2nd = gen-1, 3rd = gen-2
        INV-002: JHS 3rd year = gen+1, 2nd = gen+2, 1st = gen+3
    end note

    note right of q_update_ob
        INV-003: Any generation not in the 6 active student generations becomes OB/OG (status=2)
    end note

    note right of q_update_hs
        INV-004: Only non-deleted members (deleted_at is null) are updated
    end note

    note right of q_sync_all
        INV-005: All Discord roles are re-synced after status changes
    end note
