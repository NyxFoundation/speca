---
title: "deleteMember (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_init: supabase = createClient()
    q_init --> q_auth: user = supabase.auth.getUser()
    q_auth --> q_check_auth: user exists?
    q_check_auth --> q_err_auth: !user
    q_err_auth --> [*]: return error "authentication required"
    q_check_auth --> q_query_admin: user exists
    q_query_admin --> q_select: admin = members.select(is_admin).eq(user.id)
    q_select --> q_check_admin: admin.is_admin?
    q_check_admin --> q_err_admin: !admin.is_admin
    q_err_admin --> [*]: return error "admin privileges required"
    q_check_admin --> q_check_self: admin.is_admin
    q_check_self --> q_err_self: user.id == userId
    q_err_self --> [*]: return error "cannot delete yourself"
    q_check_self --> q_delete: user.id != userId
    q_delete --> q_update: members.update(deleted_at = now()).eq(userId)
    q_update --> q_check_update: error?
    q_check_update --> q_err_update: error
    q_err_update --> [*]: return error "failed to delete member"
    q_check_update --> q_revalidate: OK
    q_revalidate --> [*]: return error = null

    note right of q_delete
        INV-001: Soft delete only (sets deleted_at timestamp, does not remove row)
    end note

    note right of q_check_self
        INV-002: Admin cannot delete their own account (self-protection)
    end note
