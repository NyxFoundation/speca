---
title: "resyncDiscordMember (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_init: supabase = createClient(), supabaseAdmin = createAdminClient()
    q_init --> q_auth: user = supabase.auth.getUser()
    q_auth --> q_check_auth: user exists?
    q_check_auth --> q_err_auth: !user
    q_err_auth --> [*]: return error "login required"
    q_check_auth --> q_validate: user exists
    q_validate --> q_parse: reSyncSchema.safeParse(values)
    q_parse --> q_check_valid: parsedData.success?
    q_check_valid --> q_err_valid: !success
    q_err_valid --> [*]: return error (first validation error)
    q_check_valid --> q_extract: success
    q_extract --> q_get_uid: discordUid = user.user_metadata.provider_id
    q_get_uid --> q_check_uid: discordUid present?
    q_check_uid --> q_err_uid: !discordUid
    q_err_uid --> [*]: return error "Discord UID not found"
    q_check_uid --> q_member_check: discordUid present
    q_member_check --> q_select: members.select where user_id and deleted_at is null
    q_select --> q_check_member: memberProfile found?
    q_check_member --> q_err_member: !memberProfile
    q_err_member --> [*]: return error "member not found, registration required"
    q_check_member --> q_update_meta: memberProfile found
    q_update_meta --> q_admin_update: supabaseAdmin.auth.admin.updateUserById(metadata with name)
    q_admin_update --> q_check_update: update successful?
    q_check_update --> q_err_update: userUpdateError
    q_err_update --> [*]: return error "failed to update user info"
    q_check_update --> q_sync: update OK
    q_sync --> q_nick: syncDiscordNickname(discordUid, fullName)
    q_nick --> q_roles: syncDiscordRoles(discordUid)
    q_roles --> q_revalidate: revalidatePath(/dashboard)
    q_revalidate --> [*]: return error = null

    note right of q_check_member
        INV-001: Resync requires existing non-deleted member profile
    end note

    note right of q_update_meta
        INV-002: fullName = (last_name + first_name) with whitespace stripped
    end note

    note right of q_check_update
        INV-003: Unlike registerNewMember, metadata update failure here IS a blocking error
    end note
