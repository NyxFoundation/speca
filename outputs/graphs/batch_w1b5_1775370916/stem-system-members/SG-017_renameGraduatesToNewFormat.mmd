---
title: "renameGraduatesToNewFormat (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_admin: checkAdmin()
    q_admin --> q_init: supabase = createAdminClient()
    q_init --> q_fetch_ob: members.select(user_id, discord_uid).eq(status, 2).is(deleted_at, null)
    q_fetch_ob --> q_check_fetch: fetchError?
    q_check_fetch --> q_err_fetch: error
    q_err_fetch --> [*]: return error "failed to fetch OB/OG members"
    q_check_fetch --> q_check_empty: OK
    q_check_empty --> q_no_members: !obMembers or length == 0
    q_no_members --> [*]: return message "no OB/OG members found"
    q_check_empty --> q_fetch_users: obMembers exist
    q_fetch_users --> q_list: supabaseAdmin.auth.admin.listUsers(page 1, perPage 1000)
    q_list --> q_check_users: usersError?
    q_check_users --> q_err_users: error
    q_err_users --> [*]: return error "failed to fetch user info"
    q_check_users --> q_build_map: OK
    q_build_map --> q_map: userMap = Map(user.id to user)
    q_map --> q_iter: for member of obMembers
    q_iter --> q_get_user: user = userMap.get(member.user_id)
    q_get_user --> q_check_user: user and discord_uid present?
    q_check_user --> q_skip: !user or !discord_uid
    q_skip --> q_iter_next: failCount++, continue
    q_check_user --> q_build_name: both present
    q_build_name --> q_name: fullName = (last_name + first_name).replace whitespace
    q_name --> q_check_name: fullName not empty?
    q_check_name --> q_skip_name: empty fullName
    q_skip_name --> q_iter_next: failCount++, continue
    q_check_name --> q_sync: fullName not empty
    q_sync --> q_nick: syncDiscordNickname(discord_uid, fullName)
    q_nick --> q_iter_next: successCount++
    q_iter_next --> q_iter: next member
    q_iter --> q_done: all members processed
    q_done --> [*]: return message "updated N graduates, M skipped"

    note right of q_iter
        INV-001: Only OB/OG members (status=2) with discord_uid are processed
    end note

    note right of q_list
        INV-002: User list is fetched in a single page (max 1000 users)
    end note

    note right of q_build_name
        INV-003: Name is built from user_metadata last_name + first_name, whitespace stripped
    end note
