---
title: "updateMyProfile (stem-system members.ts)"
---
stateDiagram-v2
    direction TB
    [*] --> q_init: supabase = createClient(), supabaseAdmin = createAdminClient()
    q_init --> q_auth: user = supabase.auth.getUser()
    q_auth --> q_check_auth: user exists?
    q_check_auth --> q_err_auth: !user
    q_err_auth --> [*]: return error "login required"
    q_check_auth --> q_validate: user exists
    q_validate --> q_parse: profileUpdateSchema.safeParse(values)
    q_parse --> q_check_valid: parsedData.success?
    q_check_valid --> q_err_valid: !success
    q_err_valid --> [*]: return error "invalid data"
    q_check_valid --> q_update: success
    q_update --> q_db: supabaseAdmin.members.update(student_number).eq(user.id)
    q_db --> q_check_update: update successful?
    q_check_update --> q_err_update: error
    q_err_update --> [*]: return error "profile update failed"
    q_check_update --> q_sync: update OK
    q_sync --> q_get_member: members.select(discord_uid).eq(user.id)
    q_get_member --> q_check_member: member found?
    q_check_member --> q_discord: member found
    q_discord --> q_get_name: getMemberDisplayName(member.discord_uid)
    q_get_name --> q_check_name: realName obtained?
    q_check_name --> q_nick: realName exists
    q_nick --> q_roles: syncDiscordNickname(discord_uid, realName)
    q_check_name --> q_roles: no realName (skip nickname)
    q_roles --> q_sync_roles: syncDiscordRoles(discord_uid)
    q_check_member --> q_revalidate: no member (skip Discord sync)
    q_sync_roles --> q_revalidate: done
    q_revalidate --> [*]: return error = null

    note right of q_update
        INV-001: Self-service profile update only allows changing student_number
    end note

    note right of q_db
        INV-002: Uses supabaseAdmin (admin client) for the update, bypassing RLS
    end note

    note right of q_discord
        INV-003: Discord nickname is re-synced using the display name from Discord API, not local data
    end note
