---
title: "team_management (stem-system: Clubhouse Manager)"
---
stateDiagram-v2
    direction TB
    [*] --> q_check_session: server action invoked
    q_check_session --> q_error_unauth: no authenticated session
    q_check_session --> q_check_admin: session valid
    q_error_unauth --> [*]: return error
    q_check_admin --> q_error_forbidden: checkAdmin() returns false
    q_check_admin --> q_determine_op: user is admin
    q_error_forbidden --> [*]: return 403 forbidden
    q_determine_op --> q_create_team: operation = create
    q_determine_op --> q_update_team: operation = update
    q_determine_op --> q_delete_team: operation = delete
    q_determine_op --> q_assign_member: operation = assign member to team
    q_determine_op --> q_remove_member: operation = remove member from team
    q_determine_op --> q_set_leader: operation = set team leader
    q_create_team --> q_validate_team: validate name, discord_role_id
    q_validate_team --> q_insert_team: insert into teams table
    q_insert_team --> [*]: return success
    q_update_team --> q_validate_update: validate update fields
    q_validate_update --> q_apply_team_update: update team record
    q_apply_team_update --> [*]: return success
    q_delete_team --> q_remove_relations: delete member_team_relations for team
    q_remove_relations --> q_remove_leaders: delete team_leaders for team
    q_remove_leaders --> q_delete_team_row: delete team row
    q_delete_team_row --> [*]: return success
    q_assign_member --> q_insert_relation: insert into member_team_relations(member_id, team_id)
    q_insert_relation --> [*]: return success
    q_remove_member --> q_delete_relation: delete from member_team_relations
    q_delete_relation --> [*]: return success
    q_set_leader --> q_upsert_leader: upsert into team_leaders(team_id, member_id)
    q_upsert_leader --> [*]: return success

    note right of q_check_admin
        INV-001: all team management operations require admin privileges
    end note

    note right of q_delete_team
        INV-002: team deletion cascades to member_team_relations and team_leaders
        INV-003: team deletion is physical (not logical)
    end note

    note right of q_assign_member
        INV-004: (member_id, team_id) pair must be unique in member_team_relations
    end note
