stateDiagram-v2
    direction TB
    [*] --> q_init_evals: evals = CosetEvals()
    q_init_evals --> q_iter: i = 0
    q_iter --> q_compute: i < FIELD_ELEMENTS_PER_CELL
    q_iter --> q_return: i >= FIELD_ELEMENTS_PER_CELL
    q_compute --> q_slice: start = i * BYTES_PER_FIELD_ELEMENT
    q_slice --> q_convert: end = (i + 1) * BYTES_PER_FIELD_ELEMENT
    q_convert --> q_iter: evals[i] = bytes_to_bls_field(cell[start:end])
    q_return --> [*]: return evals
