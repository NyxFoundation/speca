stateDiagram-v2
    direction TB
    [*] --> q_validate: assert lengths match and commitments unique
    q_validate --> q_validate_idx: assert commitment_index < len(commitments) for all
    q_validate_idx --> q_challenge: r = compute_verify_cell_kzg_proof_batch_challenge(...)
    q_challenge --> q_powers: r_powers = compute_powers(r, num_cells)
    q_powers --> q_ll: LL = g1_lincomb(proofs, r_powers)
    q_ll --> q_lr: LR = KZG_SETUP_G2_MONOMIAL[n]
    q_lr --> q_weights: weights = [0] * num_commitments
    q_weights --> q_iter_w: for k in range(num_cells)
    q_iter_w --> q_acc_weight: has next k
    q_iter_w --> q_rlc: no more k
    q_acc_weight --> q_iter_w: weights[commitment_indices[k]] += r_powers[k]
    q_rlc --> q_interp_init: RLC = g1_lincomb(commitments, weights)
    q_interp_init --> q_iter_interp: sum_interp = [0]*n
    q_iter_interp --> q_interp_k: has next k
    q_iter_interp --> q_rli: no more k
    q_interp_k --> q_scale_interp: interp = interpolate(coset_for_cell(k), evals[k])
    q_scale_interp --> q_add_interp: scaled = multiply([r_powers[k]], interp)
    q_add_interp --> q_iter_interp: sum_interp = add(sum_interp, scaled)
    q_rli --> q_iter_rlp: RLI = g1_lincomb(KZG_SETUP_G1_MONOMIAL[:n], sum_interp)
    q_iter_rlp --> q_rlp_k: has next k
    q_iter_rlp --> q_rlp: no more k
    q_rlp_k --> q_coset_shift: h_k = coset_shift_for_cell(cell_indices[k])
    q_coset_shift --> q_wrp: wrp = r_powers[k] * h_k^n
    q_wrp --> q_iter_rlp: append wrp
    q_rlp --> q_rl: RLP = g1_lincomb(proofs, weighted_r_powers)
    q_rl --> q_combine: RL = RLC - RLI + RLP
    q_combine --> q_pairing: pairing_check([[LL, LR], [RL, neg(G2[0])]])
    q_pairing --> [*]: return pairing result
