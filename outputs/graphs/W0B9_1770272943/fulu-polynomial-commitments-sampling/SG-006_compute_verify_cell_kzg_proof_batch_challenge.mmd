stateDiagram-v2
    direction TB
    [*] --> q_init_hash: hashinput = RANDOM_CHALLENGE_KZG_CELL_BATCH_DOMAIN
    q_init_hash --> q_append_params: append FIELD_ELEMENTS_PER_BLOB, FIELD_ELEMENTS_PER_CELL
    q_append_params --> q_append_lengths: append len(commitments), len(cell_indices)
    q_append_lengths --> q_iter_commits: for commitment in commitments
    q_iter_commits --> q_append_commit: has next commitment
    q_iter_commits --> q_iter_cells: no more commitments
    q_append_commit --> q_iter_commits: hashinput += commitment
    q_iter_cells --> q_append_cell_data: has next cell k
    q_iter_cells --> q_hash: no more cells
    q_append_cell_data --> q_append_indices: hashinput += commitment_indices[k]
    q_append_indices --> q_append_cell_idx: hashinput += cell_indices[k]
    q_append_cell_idx --> q_iter_evals: for coset_eval in cosets_evals[k]
    q_iter_evals --> q_append_eval: has next eval
    q_iter_evals --> q_append_proof: no more evals
    q_append_eval --> q_iter_evals: hashinput += bls_field_to_bytes(coset_eval)
    q_append_proof --> q_iter_cells: hashinput += proofs[k]
    q_hash --> [*]: return hash_to_bls_field(hashinput)
