stateDiagram-v2
    direction TB
    [*] --> q_validate: assert cell_index < CELLS_PER_EXT_BLOB
    q_validate --> q_roots: roots = compute_roots_of_unity(FIELD_ELEMENTS_PER_EXT_BLOB)
    q_roots --> q_permute: roots_brp = bit_reversal_permutation(roots)
    q_permute --> [*]: return roots_brp[FIELD_ELEMENTS_PER_CELL * cell_index]
