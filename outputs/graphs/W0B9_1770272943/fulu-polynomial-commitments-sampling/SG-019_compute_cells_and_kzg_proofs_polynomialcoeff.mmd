stateDiagram-v2
    direction TB
    [*] --> q_init: cells = [], proofs = []
    q_init --> q_iter: for i in range(CELLS_PER_EXT_BLOB)
    q_iter --> q_coset: has next i
    q_iter --> q_return: no more i
    q_coset --> q_proof: coset = coset_for_cell(CellIndex(i))
    q_proof --> q_convert: proof, ys = compute_kzg_proof_multi_impl(poly, coset)
    q_convert --> q_append: cell = coset_evals_to_cell(ys)
    q_append --> q_iter: cells.append(cell), proofs.append(proof)
    q_return --> [*]: return (cells, proofs)
