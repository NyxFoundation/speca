stateDiagram-v2
    direction TB
    [*] --> q_copy: vals = copy(vals)
    q_copy --> q_get_shift: shift_factor = BLSFieldElement(PRIMITIVE_ROOT_OF_UNITY)
    q_get_shift --> q_check_inv: check inv flag
    q_check_inv --> q_inv_fft: inv == True
    q_check_inv --> q_fwd_shift: inv == False
    q_fwd_shift --> q_fwd_fft: vals = shift_vals(vals, shift_factor)
    q_fwd_fft --> [*]: return fft_field(vals, roots_of_unity, inv=False)
    q_inv_fft --> q_inv_result: result = fft_field(vals, roots_of_unity, inv=True)
    q_inv_result --> [*]: return shift_vals(result, shift_factor.inverse())
