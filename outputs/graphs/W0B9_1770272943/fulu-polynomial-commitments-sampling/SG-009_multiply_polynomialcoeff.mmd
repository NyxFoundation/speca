stateDiagram-v2
    direction TB
    [*] --> q_validate: assert len(a) + len(b) <= FIELD_ELEMENTS_PER_EXT_BLOB
    q_validate --> q_init: r = PolynomialCoeff([0])
    q_init --> q_iter: for power, coef in enumerate(a)
    q_iter --> q_build_summand: has next (power, coef)
    q_iter --> q_return: no more elements
    q_build_summand --> q_scale: summand = [0]*power + [coef * x for x in b]
    q_scale --> q_iter: r = add_polynomialcoeff(r, summand)
    q_return --> [*]: return r
