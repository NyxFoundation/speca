stateDiagram-v2
    direction TB
    [*] --> q_check_inv: check inv flag
    q_check_inv --> q_inverse: inv == True
    q_check_inv --> q_forward: inv == False
    q_inverse --> q_compute_invlen: invlen = len(vals)^(BLS_MODULUS - 2)
    q_compute_invlen --> q_rev_roots: reversed_roots = roots[0:1] + roots[:0:-1]
    q_rev_roots --> q_ifft: result = _fft_field(vals, reversed_roots)
    q_ifft --> q_scale: scale each x by invlen
    q_scale --> [*]: return scaled result
    q_forward --> q_fwd_fft: result = _fft_field(vals, roots_of_unity)
    q_fwd_fft --> [*]: return result
