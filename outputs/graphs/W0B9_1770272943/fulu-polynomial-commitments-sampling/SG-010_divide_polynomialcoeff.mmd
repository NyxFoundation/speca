stateDiagram-v2
    direction TB
    [*] --> q_copy: a = copy(a)
    q_copy --> q_init: o = [], apos = len(a)-1, bpos = len(b)-1, diff = apos-bpos
    q_init --> q_check: check diff >= 0
    q_check --> q_quot: diff >= 0
    q_check --> q_return: diff < 0
    q_quot --> q_compute: quot = a[apos] / b[bpos]
    q_compute --> q_prepend: o.insert(0, quot)
    q_prepend --> q_subtract: for i in range(bpos, -1, -1)
    q_subtract --> q_update: a[diff+i] = a[diff+i] - b[i]*quot
    q_update --> q_decrement: apos -= 1, diff -= 1
    q_decrement --> q_check: loop back
    q_return --> [*]: return o
