stateDiagram-v2
    direction TB
    [*] --> q_validate_len: assert all input lengths equal
    q_validate_len --> q_validate_commit: for each commitment_bytes assert len == BYTES_PER_COMMITMENT
    q_validate_commit --> q_validate_cell_idx: for each cell_index assert < CELLS_PER_EXT_BLOB
    q_validate_cell_idx --> q_validate_cell: for each cell assert len == BYTES_PER_CELL
    q_validate_cell --> q_validate_proof: for each proof_bytes assert len == BYTES_PER_PROOF
    q_validate_proof --> q_dedup: deduplicated_commitments = unique(commitments_bytes)
    q_dedup --> q_map_indices: commitment_indices = map to deduplicated indices
    q_map_indices --> q_convert_evals: cosets_evals = [cell_to_coset_evals(c) for c in cells]
    q_convert_evals --> q_convert_proofs: proofs = [bytes_to_kzg_proof(p) for p in proofs_bytes]
    q_convert_proofs --> q_verify: verify_cell_kzg_proof_batch_impl(...)
    q_verify --> [*]: return verification result
