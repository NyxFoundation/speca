stateDiagram-v2
    direction TB
    [*] --> q_check_base: check len(vals)
    q_check_base --> q_return_base: len(vals) == 1
    q_check_base --> q_recurse: len(vals) > 1
    q_return_base --> [*]: return vals
    q_recurse --> q_left: L = _fft_field(vals[::2], roots_of_unity[::2])
    q_left --> q_right: R = _fft_field(vals[1::2], roots_of_unity[::2])
    q_right --> q_alloc: o = [BLSFieldElement(0) for _ in vals]
    q_alloc --> q_iter: i = 0
    q_iter --> q_butterfly: i < len(L)
    q_iter --> q_return: i >= len(L)
    q_butterfly --> q_combine: y_times_root = y * roots_of_unity[i]
    q_combine --> q_store: o[i] = x + y_times_root
    q_store --> q_iter: o[i + len(L)] = x - y_times_root
    q_return --> [*]: return o
