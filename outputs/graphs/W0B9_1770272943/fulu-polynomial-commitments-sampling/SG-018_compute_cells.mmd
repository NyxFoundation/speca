stateDiagram-v2
    direction TB
    [*] --> q_validate: assert len(blob) == BYTES_PER_BLOB
    q_validate --> q_poly: polynomial = blob_to_polynomial(blob)
    q_poly --> q_coeff: polynomial_coeff = polynomial_eval_to_coeff(polynomial)
    q_coeff --> q_init_cells: cells = []
    q_init_cells --> q_iter: for i in range(CELLS_PER_EXT_BLOB)
    q_iter --> q_coset: has next i
    q_iter --> q_return: no more i
    q_coset --> q_eval: coset = coset_for_cell(CellIndex(i))
    q_eval --> q_to_cell: ys = [evaluate_polynomialcoeff(poly, z) for z in coset]
    q_to_cell --> q_iter: cells.append(coset_evals_to_cell(ys))
    q_return --> [*]: return cells
