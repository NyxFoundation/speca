---
title: Transaction Validation Dispatch (Osaka Exceptions)
---
stateDiagram-v2
    direction TB

    [*] --> q_init : start
    q_init --> q_type_check : receive transaction
    q_type_check --> q_gas_limit : type is known
    q_type_check --> q_err_type : type is unknown
    q_err_type --> [*] : raise TransactionTypeError(transaction_type)

    q_gas_limit --> q_fee_check : gas_limit <= max_gas_limit
    q_gas_limit --> q_err_gas : gas_limit > max_gas_limit
    q_err_gas --> [*] : raise TransactionGasLimitExceededError

    q_fee_check --> q_priority_check : max_fee_per_gas >= base_fee_per_gas
    q_fee_check --> q_err_fee : max_fee_per_gas < base_fee_per_gas
    q_err_fee --> [*] : raise InsufficientMaxFeePerGasError

    q_priority_check --> q_contract_check : priority_fee <= max_fee_per_gas
    q_priority_check --> q_err_priority : priority_fee > max_fee_per_gas
    q_err_priority --> [*] : raise PriorityFeeGreaterThanMaxFeeError

    q_contract_check --> q_initcode_check : not contract_creation or type allows it
    q_contract_check --> q_err_contract : contract_creation and type disallows it
    q_err_contract --> [*] : raise TransactionTypeContractCreationError

    q_initcode_check --> q_auth_check : init_code_size <= max_size
    q_initcode_check --> q_err_initcode : init_code_size > max_size
    q_err_initcode --> [*] : raise InitCodeTooLargeError

    q_auth_check --> q_valid : authorization_list is valid or absent
    q_auth_check --> q_err_auth : authorization_list is empty
    q_err_auth --> [*] : raise EmptyAuthorizationListError

    q_valid --> [*] : transaction accepted

    note right of q_type_check
        INV-008: All validation checks are sequential
        failure at any point halts further validation
    end note

    note right of q_valid
        INV-009: Exactly one exception per invalid tx
        INV-010: All exception classes extend InvalidTransaction
        INV-011: Valid tx passes all guards
    end note
