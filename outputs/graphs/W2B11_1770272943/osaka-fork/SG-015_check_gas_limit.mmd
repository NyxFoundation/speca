stateDiagram-v2
    direction TB
    [*] --> q_calc: max_adjustment_delta = parent_gas_limit // GAS_LIMIT_ADJUSTMENT_FACTOR
    q_calc --> q_check_high: gas_limit >= parent_gas_limit + max_adjustment_delta
    q_check_high --> q_false1: true
    q_false1 --> [*]: return False
    q_check_high --> q_check_low: false
    q_check_low --> q_false2: gas_limit <= parent_gas_limit - max_adjustment_delta
    q_false2 --> [*]: return False
    q_check_low --> q_check_min: false
    q_check_min --> q_false3: gas_limit < GAS_LIMIT_MINIMUM
    q_false3 --> [*]: return False
    q_check_min --> [*]: return True
