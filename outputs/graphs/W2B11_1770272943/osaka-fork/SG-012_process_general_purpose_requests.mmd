stateDiagram-v2
    direction TB
    [*] --> q_deposits: deposit_requests = parse_deposit_requests(block_output)
    q_deposits --> q_check_deposits: len(deposit_requests) > 0
    q_check_deposits --> q_append_deposits: true
    q_append_deposits --> q_withdrawal_sys: requests.append(DEPOSIT_REQUEST_TYPE + deposit_requests)
    q_check_deposits --> q_withdrawal_sys: false
    q_withdrawal_sys --> q_check_wd: system_withdrawal_tx_output = process_checked_system_transaction(WITHDRAWAL_REQUEST_PREDEPLOY)
    q_check_wd --> q_append_wd: len(return_data) > 0
    q_append_wd --> q_consolidation_sys: requests.append(WITHDRAWAL_REQUEST_TYPE + return_data)
    q_check_wd --> q_consolidation_sys: len(return_data) == 0
    q_consolidation_sys --> q_check_consol: system_consolidation_tx_output = process_checked_system_transaction(CONSOLIDATION_REQUEST_PREDEPLOY)
    q_check_consol --> q_append_consol: len(return_data) > 0
    q_append_consol --> [*]: requests.append(CONSOLIDATION_REQUEST_TYPE + return_data)
    q_check_consol --> [*]: len(return_data) == 0
