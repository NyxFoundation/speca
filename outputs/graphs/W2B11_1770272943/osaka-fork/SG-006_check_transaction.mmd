stateDiagram-v2
    direction TB
    [*] --> q_avail: gas_available = block_gas_limit - block_gas_used
    q_avail --> q_check_gas: blob_gas_available = MAX_BLOB_GAS - blob_gas_used
    q_check_gas --> q_err_gas: tx.gas > gas_available
    q_err_gas --> [*]: raise GasUsedExceedsLimitError
    q_check_gas --> q_blob_gas: tx.gas <= gas_available
    q_blob_gas --> q_check_blob_gas: tx_blob_gas_used = calculate_total_blob_gas(tx)
    q_check_blob_gas --> q_err_blob_gas: tx_blob_gas_used > blob_gas_available
    q_err_blob_gas --> [*]: raise BlobGasLimitExceededError
    q_check_blob_gas --> q_recover: blob gas within limit
    q_recover --> q_check_type: sender = recover_sender(chain_id, tx)
    q_check_type --> q_eip1559: tx is FeeMarket or Blob or SetCode
    q_eip1559 --> q_check_priority: max_fee_per_gas < max_priority_fee
    q_check_priority --> q_err_priority: true
    q_err_priority --> [*]: raise PriorityFeeGreaterThanMaxFeeError
    q_check_priority --> q_check_max_fee: false
    q_check_max_fee --> q_err_max_fee: max_fee_per_gas < base_fee_per_gas
    q_err_max_fee --> [*]: raise InsufficientMaxFeePerGasError
    q_check_max_fee --> q_calc_eff: fees valid
    q_calc_eff --> q_post_fee: effective_gas_price = priority_fee + base_fee
    q_check_type --> q_legacy: tx is Legacy or AccessList
    q_legacy --> q_check_legacy_price: gas_price < base_fee_per_gas
    q_check_legacy_price --> q_err_legacy: true
    q_err_legacy --> [*]: raise InvalidBlock
    q_check_legacy_price --> q_post_fee: effective_gas_price = tx.gas_price
    q_post_fee --> q_check_blob_tx: isinstance(tx, BlobTransaction)
    q_check_blob_tx --> q_blob_validate: true
    q_blob_validate --> q_check_blob_count: blob_count = len(tx.blob_versioned_hashes)
    q_check_blob_count --> q_err_no_blob: blob_count == 0
    q_err_no_blob --> [*]: raise NoBlobDataError
    q_check_blob_count --> q_check_blob_limit: blob_count > 0
    q_check_blob_limit --> q_err_blob_limit: blob_count > BLOB_COUNT_LIMIT
    q_err_blob_limit --> [*]: raise BlobCountExceededError
    q_check_blob_limit --> q_check_versions: blob_count within limit
    q_check_versions --> q_err_version: any hash version != KZG
    q_err_version --> [*]: raise InvalidBlobVersionedHashError
    q_check_versions --> q_check_blob_price: all versions valid
    q_check_blob_price --> q_err_blob_price: max_fee_per_blob_gas < blob_gas_price
    q_err_blob_price --> [*]: raise InsufficientMaxFeePerBlobGasError
    q_check_blob_price --> q_post_blob: blob fee valid
    q_check_blob_tx --> q_post_blob: false
    q_post_blob --> q_check_contract: isinstance(tx, BlobTransaction or SetCodeTransaction)
    q_check_contract --> q_err_contract: tx.to is not Address
    q_err_contract --> [*]: raise TransactionTypeContractCreationError
    q_check_contract --> q_check_setcode: tx.to is Address
    q_check_setcode --> q_check_authz: isinstance(tx, SetCodeTransaction)
    q_check_authz --> q_err_authz: not any(tx.authorizations)
    q_err_authz --> [*]: raise EmptyAuthorizationListError
    q_check_authz --> q_check_nonce: authorizations not empty
    q_check_setcode --> q_check_nonce: not SetCodeTransaction
    q_check_contract --> q_check_nonce: not Blob or SetCode type
    q_check_nonce --> q_err_nonce_low: sender_account.nonce > tx.nonce
    q_err_nonce_low --> [*]: raise NonceMismatchError nonce too low
    q_check_nonce --> q_err_nonce_high: sender_account.nonce < tx.nonce
    q_err_nonce_high --> [*]: raise NonceMismatchError nonce too high
    q_check_nonce --> q_check_balance: nonce matches
    q_check_balance --> q_err_balance: balance < max_gas_fee + tx.value
    q_err_balance --> [*]: raise InsufficientBalanceError
    q_check_balance --> q_check_eoa: balance sufficient
    q_check_eoa --> q_err_sender: sender has code and not valid delegation
    q_err_sender --> [*]: raise InvalidSenderError
    q_check_eoa --> [*]: return (sender, effective_gas_price, blob_hashes, tx_blob_gas)
