stateDiagram-v2
    direction TB
    [*] --> q_trie_set: trie_set(transactions_trie, rlp.encode(index), encode_transaction(tx))
    q_trie_set --> q_validate: intrinsic_gas, calldata_floor = validate_transaction(tx)
    q_validate --> q_check: sender, eff_price, blob_hashes, tx_blob_gas = check_transaction(block_env, block_output, tx)
    q_check --> q_get_sender: sender_account = get_account(state, sender)
    q_get_sender --> q_check_blob_type: isinstance(tx, BlobTransaction)
    q_check_blob_type --> q_calc_blob_fee: true
    q_calc_blob_fee --> q_deduct: blob_gas_fee = calculate_data_fee(excess_blob_gas, tx)
    q_check_blob_type --> q_deduct: false, blob_gas_fee = 0
    q_deduct --> q_nonce: gas = tx.gas - intrinsic_gas, increment_nonce(state, sender)
    q_nonce --> q_balance_sub: sender_balance = balance - effective_gas_fee - blob_gas_fee
    q_balance_sub --> q_access_list: set_account_balance(state, sender, sender_balance)
    q_access_list --> q_build_access: build access_list_addresses and access_list_storage_keys
    q_build_access --> q_build_tx_env: tx_env = TransactionEnvironment(origin=sender, ...)
    q_build_tx_env --> q_prepare: message = prepare_message(block_env, tx_env, tx)
    q_prepare --> q_execute: tx_output = process_message_call(message)
    q_execute --> q_refund_calc: tx_gas_used = tx.gas - tx_output.gas_left
    q_refund_calc --> q_floor: tx_gas_refund = min(gas_used // 5, refund_counter)
    q_floor --> q_gas_left: tx_gas_used = max(gas_used - refund, calldata_floor_gas_cost)
    q_gas_left --> q_refund_sender: gas_refund_amount = tx_gas_left * effective_gas_price
    q_refund_sender --> q_pay_miner: set_account_balance(sender, balance + gas_refund_amount)
    q_pay_miner --> q_destroy: set_account_balance(coinbase, balance + transaction_fee)
    q_destroy --> q_iter_delete: for address in accounts_to_delete
    q_iter_delete --> q_destroy_acct: destroy_account(state, address)
    q_destroy_acct --> q_iter_delete: next account
    q_iter_delete --> q_update_output: all accounts destroyed
    q_update_output --> q_receipt: block_gas_used += tx_gas_used, blob_gas_used += tx_blob_gas
    q_receipt --> q_trie_receipt: receipt = make_receipt(tx, error, block_gas_used, logs)
    q_trie_receipt --> [*]: trie_set(receipts_trie, receipt_key, receipt), block_logs += tx_output.logs
