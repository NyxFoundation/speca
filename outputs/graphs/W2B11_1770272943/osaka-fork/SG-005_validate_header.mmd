stateDiagram-v2
    direction TB
    [*] --> q_check_number: header.number < 1
    q_check_number --> q_err1: true
    q_err1 --> [*]: raise InvalidBlock
    q_check_number --> q_get_parent: false
    q_get_parent --> q_check_excess: parent_header = chain.blocks[-1].header
    q_check_excess --> q_err2: header.excess_blob_gas != calculate_excess_blob_gas(parent_header)
    q_err2 --> [*]: raise InvalidBlock
    q_check_excess --> q_check_gas_used: excess matches
    q_check_gas_used --> q_err3: header.gas_used > header.gas_limit
    q_err3 --> [*]: raise InvalidBlock
    q_check_gas_used --> q_check_base_fee: gas_used valid
    q_check_base_fee --> q_err4: expected_base_fee != header.base_fee_per_gas
    q_err4 --> [*]: raise InvalidBlock
    q_check_base_fee --> q_check_time: base_fee matches
    q_check_time --> q_err5: header.timestamp <= parent_header.timestamp
    q_err5 --> [*]: raise InvalidBlock
    q_check_time --> q_check_num_seq: timestamp valid
    q_check_num_seq --> q_err6: header.number != parent_header.number + 1
    q_err6 --> [*]: raise InvalidBlock
    q_check_num_seq --> q_check_extra: number sequential
    q_check_extra --> q_err7: len(header.extra_data) > 32
    q_err7 --> [*]: raise InvalidBlock
    q_check_extra --> q_check_diff: extra_data valid
    q_check_diff --> q_err8: header.difficulty != 0
    q_err8 --> [*]: raise InvalidBlock
    q_check_diff --> q_check_nonce: difficulty zero
    q_check_nonce --> q_err9: header.nonce != 0x0000000000000000
    q_err9 --> [*]: raise InvalidBlock
    q_check_nonce --> q_check_ommers: nonce zero
    q_check_ommers --> q_err10: header.ommers_hash != EMPTY_OMMER_HASH
    q_err10 --> [*]: raise InvalidBlock
    q_check_ommers --> q_check_parent: ommers valid
    q_check_parent --> q_err11: header.parent_hash != keccak256(rlp.encode(parent_header))
    q_err11 --> [*]: raise InvalidBlock
    q_check_parent --> [*]: parent_hash valid
