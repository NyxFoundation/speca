---
title: "withdraw_collateral (Scallop Lend: Borrowing)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate_key: verify obligation_key matches obligation.id
    q_validate_key --> q_error_auth: key mismatch
    q_validate_key --> q_accrue: key valid
    q_error_auth --> [*]: revert "unauthorized"
    q_accrue --> q_check_balance: accrue_interest(obligation)
    q_check_balance --> q_error_balance: obligation.collaterals[coin_type] < withdraw_amount
    q_check_balance --> q_simulate: obligation.collaterals[coin_type] >= withdraw_amount
    q_error_balance --> [*]: revert "insufficient collateral balance"
    q_simulate --> q_calc_new_collateral: new_collateral_value = calculate_collateral_value(obligation) - (withdraw_amount * price * weight)
    q_calc_new_collateral --> q_calc_debt: debt_value = calculate_debt_value(obligation)
    q_calc_debt --> q_check_health: debt_value <= new_collateral_value
    q_check_health --> q_error_health: debt_value > new_collateral_value
    q_check_health --> q_check_rate_limit: debt_value <= new_collateral_value
    q_error_health --> [*]: revert "would make position unhealthy"
    q_check_rate_limit --> q_error_limit: exceeds 24h outflow limit
    q_check_rate_limit --> q_execute: within rate limit
    q_error_limit --> [*]: revert "outflow limit exceeded"
    q_execute --> q_update: obligation.collaterals[coin_type] -= withdraw_amount
    q_update --> [*]: transfer(coin(withdraw_amount), user_address)

    note right of q_check_health
        INV-001: After withdrawal, debt_value <= collateral_value must hold
        INV-002: withdraw_amount > 0
    end note

    note right of q_check_rate_limit
        INV-003: Collateral withdrawals count toward 24h outflow limit
    end note
