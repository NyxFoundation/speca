---
title: "borrow (Scallop Lend: Borrowing)"
---
stateDiagram-v2
    direction TB
    [*] --> q_validate_key: verify obligation_key matches obligation.id
    q_validate_key --> q_error_auth: key mismatch
    q_validate_key --> q_accrue: key valid
    q_error_auth --> [*]: revert "unauthorized"
    q_accrue --> q_calc_collateral: accrue_interest(obligation)
    q_calc_collateral --> q_calc_debt: collateral_value = calculate_collateral_value(obligation)
    q_calc_debt --> q_calc_new_debt: current_debt = calculate_debt_value(obligation)
    q_calc_new_debt --> q_check_health: new_debt = (borrow_amount * oracle_price * borrow_weight) + current_debt
    q_check_health --> q_error_health: new_debt > collateral_value
    q_check_health --> q_check_rate_limit: new_debt <= collateral_value
    q_error_health --> [*]: revert "insufficient collateral"
    q_check_rate_limit --> q_error_limit: borrow exceeds 24h outflow limit for asset
    q_check_rate_limit --> q_check_pool_liquidity: within rate limit
    q_error_limit --> [*]: revert "outflow limit exceeded"
    q_check_pool_liquidity --> q_error_liquidity: asset_pool.available < borrow_amount
    q_check_pool_liquidity --> q_execute: sufficient liquidity
    q_error_liquidity --> [*]: revert "insufficient pool liquidity"
    q_execute --> q_update_debt: obligation.debts[coin_type] += borrow_amount
    q_update_debt --> q_update_pool: asset_pool.total_borrowed += borrow_amount
    q_update_pool --> q_transfer: transfer(coin(borrow_amount), user_address)
    q_transfer --> [*]: return success

    note right of q_check_health
        INV-001: After borrow, debt_value <= collateral_value (health factor >= 1)
        INV-002: borrow_amount > 0
    end note

    note right of q_check_rate_limit
        INV-003: Total borrows + withdrawals per asset within 24h <= outflow_limit
        INV-004: Rate limits are configurable per asset and per pool
    end note

    note right of q_accrue
        INV-005: Interest must be accrued before any health factor calculation
        INV-006: collateral_value and debt_value use same oracle timestamp
    end note
