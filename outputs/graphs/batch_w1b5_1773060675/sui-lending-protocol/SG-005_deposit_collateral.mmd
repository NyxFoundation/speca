---
title: "deposit_collateral (Scallop Sui Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: assert_current_version(version)
    q_version --> q_whitelist: assert_whitelist_access(market, ctx)
    q_whitelist --> q_check_lock: obligation::deposit_collateral_locked(obligation) == false
    q_check_lock --> q_check_amount: obligation not locked
    q_check_lock --> q_abort_locked: obligation is locked
    q_abort_locked --> [*]: abort obligation_locked
    q_check_amount --> q_check_risk_model: coin_value(coin) > 0
    q_check_amount --> q_abort_zero: coin_value == 0
    q_abort_zero --> [*]: abort zero_deposit_amount_error
    q_check_risk_model --> q_check_collateral_active: has_risk_model(market, coin_type)
    q_check_risk_model --> q_abort_invalid: no risk model
    q_abort_invalid --> [*]: abort invalid_collateral_type_error
    q_check_collateral_active --> q_check_debt_loop: is_collateral_active(market, coin_type)
    q_check_collateral_active --> q_abort_inactive: collateral not active
    q_abort_inactive --> [*]: abort collateral_not_active_error
    q_check_debt_loop --> q_check_min: !has_coin_x_as_debt(obligation, coin_type)
    q_check_debt_loop --> q_abort_debt: has debt of same type
    q_abort_debt --> [*]: abort unable_to_deposit_a_borrowed_coin
    q_check_min --> q_emit: coin_value >= min_collateral_amount
    q_check_min --> q_abort_min: coin_value < min_collateral_amount
    q_abort_min --> [*]: abort min_collateral_amount_error
    q_emit --> q_handle_add: emit CollateralDepositEvent
    q_handle_add --> q_deposit: market::handle_add_collateral(market, coin_value)
    q_deposit --> [*]: obligation::deposit_collateral(obligation, balance)

    note right of q_check_debt_loop
        INV-001: same asset cannot be both collateral and debt in one obligation
        INV-002: prevents circular collateralize-borrow attack
    end note

    note right of q_check_min
        INV-003: collateral deposit must meet minimum amount threshold
        INV-004: risk model must exist for collateral type
    end note

    note right of q_deposit
        INV-005: collateral balance stored directly in obligation object
        INV-006: market tracks total collateral for protocol-wide accounting
    end note
