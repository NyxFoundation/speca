stateDiagram-v2
    direction TB
    [*] --> q_version: assert_current_version(version)
    q_version --> q_unlock: obligation::set_unlock(obligation, key)
    q_unlock --> q_emit: emit ObligationForceUnlocked event
    q_emit --> [*]: obligation unlocked

