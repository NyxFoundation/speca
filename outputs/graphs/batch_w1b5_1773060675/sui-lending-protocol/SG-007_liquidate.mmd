---
title: "liquidate (Scallop Sui Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: assert_current_version(version)
    q_version --> q_whitelist: assert_whitelist_access(market, ctx)
    q_whitelist --> q_check_lock: obligation::liquidate_locked(obligation) == false
    q_check_lock --> q_prepare: obligation not locked
    q_check_lock --> q_abort_locked: obligation is locked
    q_abort_locked --> [*]: abort obligation_locked
    q_prepare --> q_accrue_market: available_repay_balance = coin_into_balance(coin)
    q_accrue_market --> q_accrue_obligation: market::accrue_all_interests(market, now)
    q_accrue_obligation --> q_calc_amounts: obligation::accrue_interests(obligation, market)
    q_calc_amounts --> q_check_liquidatable: calculate_liquidation_amounts(obligation, market, ...)
    q_check_liquidatable --> q_withdraw_collateral: actual_repay > 0
    q_check_liquidatable --> q_abort_healthy: obligation is healthy
    q_abort_healthy --> [*]: abort unable_to_liquidate_error
    q_withdraw_collateral --> q_decrease_debt: obligation::withdraw_collateral(obligation, liq_amount + protocol_amount)
    q_decrease_debt --> q_handle_inflow: obligation::decrease_debt(obligation, debt_type, actual_repay)
    q_handle_inflow --> q_split_collateral: market::handle_inflow(market, actual_repay, now)
    q_split_collateral --> q_split_repay: protocol_collateral = balance::split(collateral, protocol_amount)
    q_split_repay --> q_handle_liquidation: repay_balance = balance::split(available_repay, actual_repay)
    q_handle_liquidation --> q_emit: market::handle_liquidation_v2(market, repay, protocol_collateral, total_liq)
    q_emit --> [*]: return (remaining_coin, collateral_coin)

    note right of q_calc_amounts
        INV-001: liquidation only when weighted_debts_value > collaterals_value_for_liquidation
        INV-002: max repay per call capped at 20% of total debt value (LIQUIDATION_CAP_DIVISOR=5)
        INV-003: dust positions (total_debt_usd <= $10) allow full repay in one call
    end note

    note right of q_split_collateral
        INV-004: liquidator receives collateral at discount (1 + liq_discount) * exchange_rate
        INV-005: protocol receives liq_revenue_factor * exchange_rate as revenue
        INV-006: if collateral insufficient, amounts scaled proportionally to avoid liquidator loss
    end note

    note right of q_decrease_debt
        INV-007: debt decreased by actual_repay amount
        INV-008: inflow limiter updated to reflect repayment
    end note
