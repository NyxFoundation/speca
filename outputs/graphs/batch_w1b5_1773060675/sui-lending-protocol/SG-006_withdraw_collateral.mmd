---
title: "withdraw_collateral (Scallop Sui Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: assert_current_version(version)
    q_version --> q_whitelist: assert_whitelist_access(market, ctx)
    q_whitelist --> q_check_lock: obligation::withdraw_collateral_locked(obligation) == false
    q_check_lock --> q_check_amount: obligation not locked
    q_check_lock --> q_abort_locked: obligation is locked
    q_abort_locked --> [*]: abort obligation_locked
    q_check_amount --> q_calc_time: withdraw_amount > 0
    q_check_amount --> q_abort_zero: withdraw_amount == 0
    q_abort_zero --> [*]: abort zero_withdrawal_amount_error
    q_calc_time --> q_check_key: now = clock_timestamp_ms / 1000
    q_check_key --> q_handle_withdraw: assert_key_match(obligation, obligation_key)
    q_handle_withdraw --> q_accrue: market::handle_withdraw_collateral(market, withdraw_amount, now)
    q_accrue --> q_calc_max: obligation::accrue_interests(obligation, market)
    q_calc_max --> q_check_max: max_withdraw = borrow_withdraw_evaluator::max_withdraw_amount(...)
    q_check_max --> q_withdraw: withdraw_amount <= max_withdraw
    q_check_max --> q_abort_too_much: withdraw_amount > max_withdraw
    q_abort_too_much --> [*]: abort withdraw_collateral_too_much_error
    q_withdraw --> q_emit: withdrawed_balance = obligation::withdraw_collateral(obligation, amount)
    q_emit --> q_check_apm: emit CollateralWithdrawEvent
    q_check_apm --> [*]: check_is_collateral_price_fluctuate(obligation, market, oracle, clock)

    note right of q_calc_max
        INV-001: max_withdraw ensures obligation remains overcollateralized after withdrawal
        INV-002: if debts == 0 then full collateral withdrawal is allowed
        INV-003: max_withdraw = available_borrow_usd / (coin_price * collateral_factor)
    end note

    note right of q_check_apm
        INV-004: APM check runs after withdrawal to detect price fluctuation
        INV-005: obligation key ownership required for withdrawal authorization
    end note
