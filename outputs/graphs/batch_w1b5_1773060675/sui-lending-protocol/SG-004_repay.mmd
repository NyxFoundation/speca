---
title: "repay (Scallop Sui Lending Protocol)"
---
stateDiagram-v2
    direction TB
    [*] --> q_version: assert_current_version(version)
    q_version --> q_check_amount: coin_value(user_coin) > 0
    q_check_amount --> q_whitelist: coin_value > 0
    q_check_amount --> q_abort_zero: coin_value == 0
    q_abort_zero --> [*]: abort zero_repay_amount_error
    q_whitelist --> q_check_lock: assert_whitelist_access(market, ctx)
    q_check_lock --> q_calc_time: obligation::repay_locked(obligation) == false
    q_check_lock --> q_abort_locked: obligation is locked
    q_abort_locked --> [*]: abort obligation_locked
    q_calc_time --> q_accrue_market: now = clock_timestamp_ms / 1000
    q_accrue_market --> q_accrue_obligation: market::accrue_all_interests(market, now)
    q_accrue_obligation --> q_calc_repay: obligation::accrue_interests(obligation, market)
    q_calc_repay --> q_split: repay_amount = min(debt_amount, coin_value)
    q_split --> q_handle_repay: repay_coin = coin::split(user_coin, repay_amount)
    q_handle_repay --> q_handle_inflow: market::handle_repay(market, balance, now)
    q_handle_inflow --> q_decrease_debt: market::handle_inflow(market, repay_amount, now)
    q_decrease_debt --> q_refund: obligation::decrease_debt(obligation, coin_type, repay_amount)
    q_refund --> q_check_remaining: check remaining coin value
    q_check_remaining --> q_destroy_zero: coin_value == 0
    q_check_remaining --> q_transfer_remaining: coin_value > 0
    q_destroy_zero --> q_emit: coin::destroy_zero(user_coin)
    q_transfer_remaining --> q_emit: transfer remaining to sender
    q_emit --> [*]: emit RepayEvent

    note right of q_calc_repay
        INV-001: repay_amount = min(debt_amount, coin_value) prevents overpayment
        INV-002: excess funds returned to sender, never absorbed by protocol
    end note

    note right of q_accrue_market
        INV-003: interests accrued for all markets before debt calculation
        INV-004: obligation interests accrued to reflect latest debt state
    end note

    note right of q_handle_inflow
        INV-005: inflow reduces outflow limiter for the repaid asset
    end note
